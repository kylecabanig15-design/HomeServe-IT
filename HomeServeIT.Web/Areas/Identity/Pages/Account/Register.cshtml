@page
@model RegisterModel
@{
    ViewData["Title"] = "Sign Up";
}

@if (!Model.RegistrationAllowed)
{
    <section class="min-h-[calc(100vh-144px)] flex items-center justify-center px-4 py-12">
        <div class="w-full max-w-lg rounded-3xl border border-[#e7eaf0] bg-white p-8 text-center shadow-sm">
            <h1 class="text-2xl font-bold text-[#17191c]">Registration is unavailable</h1>
            <p class="mt-3 text-sm leading-6 text-[#5d6470]">Public customer registration is currently disabled. Ask a project administrator to create an account for you.</p>
            <a asp-page="/Account/Login" class="mt-6 inline-flex min-h-11 items-center rounded-xl bg-primary px-5 text-sm font-semibold text-white">Return to sign in</a>
        </div>
    </section>
}
else
{
<div class="min-h-[calc(100vh-144px)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative z-10"
     x-data="{ 
        step: 1, 
        totalSteps: 4,
        password: '',
        showPassword: false,
        passwordAttempted: false,
        get passwordChecks() {
            return [
                { label: 'At least 8 characters', valid: this.password.length >= 8 },
                { label: 'One uppercase letter', valid: /[A-Z]/.test(this.password) },
                { label: 'One lowercase letter', valid: /[a-z]/.test(this.password) },
                { label: 'One number', valid: /[0-9]/.test(this.password) },
                { label: 'One special character', valid: /[^A-Za-z0-9]/.test(this.password) }
            ];
        },
        get passwordValid() {
            return this.passwordChecks.every(rule => rule.valid);
        },
        validateFields(fieldIds) {
            for (const fieldId of fieldIds) {
                const field = document.getElementById(fieldId);
                if (field && !field.checkValidity()) {
                    field.reportValidity();
                    field.focus();
                    return false;
                }
            }
            return true;
        },
        continueFromAccount() {
            this.passwordAttempted = true;
            const accountFieldsValid = this.validateFields(['Input_FullName', 'Input_Email', 'Input_PhoneNumber', 'Input_Password']);
            if (!accountFieldsValid) return;
            if (!this.passwordValid) {
                this.$nextTick(() => document.getElementById('Input_Password')?.focus());
                return;
            }
            this.nextStep();
        },
        continueFromAddress() {
            if (!this.validateFields(['Input_StreetAddress', 'Input_BarangayCity'])) return;
            this.nextStep();
        },
        continueCurrentStep() {
            if (this.step === 1) this.continueFromAccount();
            else if (this.step === 2) this.continueFromAddress();
            else if (this.step === 3) this.nextStep();
        },
        handleEnter(event) {
            if (event.target.tagName === 'TEXTAREA') return;
            event.preventDefault();
            if (this.step < this.totalSteps) {
                this.continueCurrentStep();
                return;
            }
            document.getElementById('create-account-button')?.click();
        },
        submitRegistration(event) {
            if (this.step < this.totalSteps) {
                event.preventDefault();
                this.continueCurrentStep();
                return;
            }
            this.passwordAttempted = true;
            if (!this.passwordValid || !this.validateFields(['Input_FullName', 'Input_Email', 'Input_PhoneNumber', 'Input_Password'])) {
                event.preventDefault();
                this.step = 1;
                this.$nextTick(() => document.getElementById('Input_Password')?.focus());
                return;
            }
            if (!this.validateFields(['Input_StreetAddress', 'Input_BarangayCity'])) {
                event.preventDefault();
                this.step = 2;
            }
        },
        nextStep() {
            if (this.step < this.totalSteps) this.step++;
        },
        prevStep() {
            if (this.step > 1) this.step--;
        }
     }">
     
    <div class="max-w-[440px] w-full space-y-8 bg-white/80 backdrop-blur-2xl p-8 rounded-[24px] shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-white/40">
        
        <!-- Progress Indicator -->
        <div class="flex justify-between items-center mb-8 relative z-10">
            <div class="flex items-center w-full justify-between relative">
                <!-- Lines behind circles -->
                <div class="absolute left-0 top-1/2 -translate-y-1/2 w-full h-[2px] bg-gray-100 -z-10 rounded-full"></div>
                <div class="absolute left-0 top-1/2 -translate-y-1/2 h-[2px] bg-primary/50 -z-10 rounded-full transition-all duration-300"
                     :style="`width: ${(step - 1) / (totalSteps - 1) * 100}%`"></div>

                <template x-for="i in totalSteps" :key="i">
                    <div class="flex flex-col items-center gap-2 relative bg-white px-1">
                        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold transition-colors duration-300"
                            :class="step >= i ? 'bg-primary text-white shadow-md shadow-primary/30' : 'bg-gray-100 text-gray-400 border border-gray-200'">
                            <span x-text="i"></span>
                        </div>
                    </div>
                </template>
            </div>
        </div>

        <div class="flex justify-between w-full text-xs font-medium text-gray-400 mt-2">
            <span :class="step >= 1 ? 'text-primary' : ''">Account</span>
            <span :class="step >= 2 ? 'text-primary' : ''" class="ml-4">Address</span>
            <span :class="step >= 3 ? 'text-primary' : ''">Preferences</span>
            <span :class="step >= 4 ? 'text-primary' : ''">Review</span>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mt-8 space-y-6" @@keydown.enter="handleEnter($event)" @@submit="submitRegistration($event)">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm font-medium p-3 bg-red-50 rounded-xl" role="alert"></div>

            <!-- STEP 1: Account -->
            <div x-show="step === 1" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0" class="space-y-4">
                <div>
                    <h1 class="text-[24px] font-bold text-dark">Create your account</h1>
                    <p class="text-[14px] text-gray-500 mt-1">Set up your account to start requesting service.</p>
                </div>

                <div class="space-y-4 mt-6">
                    <div>
                        <label asp-for="Input.FullName" class="block text-sm font-medium text-dark mb-1.5">Full name</label>
                        <input asp-for="Input.FullName" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all bg-white/50 focus:bg-white placeholder-gray-400" placeholder="Juan dela Cruz" autocomplete="name" aria-required="true" />
                        <span asp-validation-for="Input.FullName" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Input.Email" class="block text-sm font-medium text-dark mb-1.5">Email address</label>
                        <input asp-for="Input.Email" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all bg-white/50 focus:bg-white placeholder-gray-400" placeholder="you@example.com" autocomplete="username" aria-required="true" />
                        <span asp-validation-for="Input.Email" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div x-data="{ phone: '+63' }">
                        <label asp-for="Input.PhoneNumber" class="block text-sm font-medium text-dark mb-1.5">Mobile number</label>
                        <div class="flex">
                            <div class="flex items-center justify-center px-4 bg-gray-50 border border-r-0 border-gray-200 rounded-l-xl text-lg">
                                <svg class="h-4 w-4 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
                            </div>
                            <input asp-for="Input.PhoneNumber" 
                                   x-model="phone" 
                                   @@input="if(!phone.startsWith('+63')) phone = '+63' + phone.replace(/^\+?6?3?/, ''); phone = phone.replace(/[^\d+]/g, '').substring(0, 13);"
                                   maxlength="13"
                                   required
                                   pattern="^\+63\d{10}$"
                                   title="Must start with +63 followed by exactly 10 digits"
                                   class="w-full px-4 py-3 rounded-r-xl border border-gray-200 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all bg-white/50 focus:bg-white placeholder-gray-400" 
                                   placeholder="+639170000000" 
                                   autocomplete="tel" />
                        </div>
                        <span asp-validation-for="Input.PhoneNumber" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Input.Password" class="block text-sm font-medium text-dark mb-1.5">Password</label>
                        <div class="relative group">
                            <input asp-for="Input.Password"
                                   x-model="password"
                                   :type="showPassword ? 'text' : 'password'"
                                   :aria-invalid="passwordAttempted && !passwordValid"
                                   :class="passwordAttempted ? (passwordValid ? 'border-emerald-400 ring-4 ring-emerald-50' : 'border-red-400 ring-4 ring-red-50') : 'border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20'"
                                   @@invalid="passwordAttempted = true"
                                   class="w-full rounded-xl border bg-white/50 px-4 py-3 pr-12 outline-none transition-all focus:bg-white placeholder-gray-400"
                                   placeholder="Create a strong password"
                                   autocomplete="new-password"
                                   minlength="8"
                                   aria-describedby="password-requirements"
                                   required
                                   aria-required="true" />
                            <button type="button" @@click="showPassword = !showPassword" class="absolute inset-y-0 right-0 flex w-11 items-center justify-center rounded-r-xl text-gray-400 transition-colors hover:text-[#30343a] focus:outline-none" :aria-label="showPassword ? 'Hide password' : 'Show password'">
                                <svg x-show="!showPassword" class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                                <svg x-show="showPassword" x-cloak class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 3 18 18"/><path d="M10.6 10.7a2 2 0 0 0 2.7 2.7M9.9 4.2A10.7 10.7 0 0 1 12 4c6 0 9.5 8 9.5 8a17 17 0 0 1-2.1 3.1M6.6 6.6C4 8.3 2.5 12 2.5 12S6 20 12 20a9.9 9.9 0 0 0 3.4-.6"/></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-red-500 text-xs mt-1 block"></span>
                    </div>
                    
                    <!-- Confirmation mirrors the visible password for server-side comparison. -->
                    <div class="hidden">
                        <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-dark mb-1.5">Confirm Password</label>
                        <input asp-for="Input.ConfirmPassword" x-model="password" autocomplete="new-password" aria-required="true" />
                    </div>

                    <div id="password-requirements" class="mt-4 rounded-2xl border border-[#e7eaf0] bg-[#fafbfc] p-3.5" aria-live="polite">
                        <div class="mb-2.5 flex items-center justify-between gap-3">
                            <p class="text-[11px] font-bold uppercase tracking-[0.11em] text-[#69717d]">Password requirements</p>
                            <span x-show="passwordValid" x-transition class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-1 text-[10px] font-bold text-emerald-700">
                                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
                                Strong password
                            </span>
                        </div>
                        <div class="grid gap-2 sm:grid-cols-2">
                            <template x-for="rule in passwordChecks" :key="rule.label">
                                <div class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-[12px] font-semibold transition-colors"
                                     :class="rule.valid ? 'bg-emerald-50 text-emerald-700' : (passwordAttempted ? 'bg-red-50 text-red-700' : 'text-[#8a929e]')">
                                    <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full transition-colors"
                                          :class="rule.valid ? 'bg-emerald-500 text-white' : (passwordAttempted ? 'bg-red-500 text-white' : 'bg-[#d8dde5] text-white')">
                                        <svg x-show="rule.valid" class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
                                        <svg x-show="!rule.valid && passwordAttempted" x-cloak class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17"/></svg>
                                        <span x-show="!rule.valid && !passwordAttempted" class="h-1 w-1 rounded-full bg-white" aria-hidden="true"></span>
                                    </span>
                                    <span x-text="rule.label"></span>
                                </div>
                            </template>
                        </div>
                    </div>
                </div>

                <div class="pt-6">
                    <button type="button" @@click="continueFromAccount()" class="w-full bg-primary hover:bg-primary-hover text-white font-semibold py-3 px-4 rounded-xl shadow-sm transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]">
                        Continue
                    </button>
                </div>
            </div>

            <!-- STEP 2: Address -->
            <div x-show="step === 2" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0" style="display: none;" class="space-y-4">
                <div>
                    <h2 class="text-[24px] font-bold text-dark">Service address</h2>
                    <p class="text-[14px] text-gray-500 mt-1">Where should we send our technician?</p>
                </div>

                <div class="space-y-4 mt-6">
                    <div>
                        <label asp-for="Input.StreetAddress" class="block text-sm font-medium text-dark mb-1.5">Street address</label>
                        <input asp-for="Input.StreetAddress" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all bg-white/50 focus:bg-white placeholder-gray-400" placeholder="Block 5, Lot 3, Sampaguita St." aria-required="true" />
                        <span asp-validation-for="Input.StreetAddress" class="mt-1 block text-xs text-red-500"></span>
                    </div>

                    <div>
                        <label asp-for="Input.BarangayCity" class="block text-sm font-medium text-dark mb-1.5">Barangay and city</label>
                        <input asp-for="Input.BarangayCity" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all bg-white/50 focus:bg-white placeholder-gray-400" placeholder="Matina, Davao City" aria-required="true" />
                        <span asp-validation-for="Input.BarangayCity" class="mt-1 block text-xs text-red-500"></span>
                    </div>

                    <div>
                        <label asp-for="Input.Landmark" class="block text-sm font-medium text-dark mb-1.5">Landmark (optional)</label>
                        <input asp-for="Input.Landmark" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all bg-white/50 focus:bg-white placeholder-gray-400" placeholder="Near SM Matina" />
                    </div>
                </div>

                <div class="flex gap-3 pt-6">
                    <button type="button" @@click="prevStep()" class="flex-none px-6 py-3 rounded-xl border border-gray-200 font-semibold text-dark hover:bg-gray-50 transition-colors">
                        Back
                    </button>
                    <button type="button" @@click="continueFromAddress()" class="flex-1 bg-primary hover:bg-primary-hover text-white font-semibold py-3 px-4 rounded-xl shadow-sm transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]">
                        Continue
                    </button>
                </div>
            </div>

            <!-- STEP 3: Preferences -->
            <div x-show="step === 3" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0" style="display: none;" class="space-y-4">
                <div>
                    <h2 class="text-[24px] font-bold text-dark">Notification Preferences</h2>
                    <p class="text-[14px] text-gray-500 mt-1">How would you like us to reach you?</p>
                </div>

                <div class="space-y-6 mt-6">

                    <div class="space-y-4">
                        <label class="flex items-center gap-3 cursor-pointer group">
                            <div class="relative flex items-center justify-center">
                                <input type="checkbox" asp-for="Input.PrefApptReminders" class="peer sr-only" />
                                <div class="w-5 h-5 rounded border-2 border-gray-300 peer-checked:bg-primary peer-checked:border-primary transition-all"></div>
                                <svg class="absolute w-3 h-3 text-white opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                            </div>
                            <span class="text-sm font-medium text-dark group-hover:text-primary transition-colors">Appointment reminders and updates</span>
                        </label>

                        <label class="flex items-center gap-3 cursor-pointer group">
                            <div class="relative flex items-center justify-center">
                                <input type="checkbox" asp-for="Input.PrefQuotations" class="peer sr-only" />
                                <div class="w-5 h-5 rounded border-2 border-gray-300 peer-checked:bg-primary peer-checked:border-primary transition-all"></div>
                                <svg class="absolute w-3 h-3 text-white opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                            </div>
                            <span class="text-sm font-medium text-dark group-hover:text-primary transition-colors">Quotation ready for review</span>
                        </label>

                        <label class="flex items-center gap-3 cursor-pointer group">
                            <div class="relative flex items-center justify-center">
                                <input type="checkbox" asp-for="Input.PrefInvoices" class="peer sr-only" />
                                <div class="w-5 h-5 rounded border-2 border-gray-300 peer-checked:bg-primary peer-checked:border-primary transition-all"></div>
                                <svg class="absolute w-3 h-3 text-white opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                </svg>
                            </div>
                            <span class="text-sm font-medium text-dark group-hover:text-primary transition-colors">Invoice and payment confirmations</span>
                        </label>
                    </div>
                </div>

                <div class="flex gap-3 pt-6">
                    <button type="button" @@click="prevStep()" class="flex-none px-6 py-3 rounded-xl border border-gray-200 font-semibold text-dark hover:bg-gray-50 transition-colors">
                        Back
                    </button>
                    <button type="button" @@click="nextStep()" class="flex-1 bg-primary hover:bg-primary-hover text-white font-semibold py-3 px-4 rounded-xl shadow-sm transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]">
                        Continue
                    </button>
                </div>
            </div>

            <!-- STEP 4: Verify -->
            <div x-show="step === 4" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0" style="display: none;" class="space-y-4">
                <div>
                    <h2 class="text-[24px] font-bold text-dark">Ready to create your account</h2>
                    <p class="text-[14px] text-slate-600 mt-1">This is a university prototype. Use fictional contact details and test data. Email verification is not enabled in this demonstration.</p>
                    <a href="/Home/Privacy" class="text-blue-700 underline">Read the project data-use notice</a>
                </div>

                <div class="flex gap-3 pt-6">
                    <button type="button" @@click="prevStep()" class="flex-none px-6 py-3 rounded-xl border border-gray-200 font-semibold text-dark hover:bg-gray-50 transition-colors">
                        Back
                    </button>
                    <button id="create-account-button" type="submit" class="flex-1 bg-primary hover:bg-primary-hover text-white font-semibold py-3 px-4 rounded-xl shadow-sm transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]">
                        Create account
                    </button>
                </div>
            </div>

            <div class="mt-6 text-center">
                <span class="text-[14px] text-gray-500">Already have an account?</span>
                <a asp-area="Identity" asp-page="/Account/Login" class="text-[14px] font-semibold text-primary hover:text-primary-hover ml-1 transition-colors">Sign in</a>
            </div>
        </form>
    </div>
</div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
