@page
@model LockoutModel

@{
    ViewData["Title"] = "Account locked";
}

<div class="relative z-10 flex min-h-[calc(100vh-144px)] items-center justify-center overflow-hidden px-4 py-12 sm:px-6">
    <div class="pointer-events-none absolute left-1/2 top-1/2 h-[420px] w-[420px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-200/30 blur-[100px]"></div>

    <main class="relative w-full max-w-[520px]" aria-labelledby="lockout-title">
        <div class="overflow-hidden rounded-[30px] border border-white/80 bg-white/85 shadow-[0_28px_80px_-28px_rgba(15,23,42,0.28)] backdrop-blur-2xl">
            <div class="relative px-6 pb-6 pt-8 text-center sm:px-10 sm:pb-8 sm:pt-10">
                <div class="pointer-events-none absolute inset-x-10 top-0 h-24 rounded-full bg-gradient-to-b from-blue-50 to-transparent blur-xl"></div>

                <div class="relative mx-auto flex h-[72px] w-[72px] items-center justify-center rounded-[22px] border border-blue-100 bg-gradient-to-br from-white to-blue-50 text-[#0878f9] shadow-[0_14px_30px_-12px_rgba(8,120,249,0.38)]">
                    <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="4" y="10" width="16" height="11" rx="3" />
                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                        <path d="M12 14v3" />
                    </svg>
                    <span class="absolute -bottom-1 -right-1 flex h-6 w-6 items-center justify-center rounded-full border-[3px] border-white bg-amber-400 text-white">
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M12 7v6M12 17h.01" /></svg>
                    </span>
                </div>

                <div class="relative mt-6">
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-amber-700">
                        <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                        Account status
                    </span>
                    <h1 id="lockout-title" class="mt-4 text-[30px] font-bold tracking-[-0.035em] text-[#17191c]">Locked out</h1>
                    <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-[#69717d]">
                        This account has been locked out. Please try again later or contact an administrator if you believe access should be restored.
                    </p>
                </div>

                <div class="mt-7 rounded-2xl border border-[#e4e9f0] bg-[#f8fafc] p-4 text-left shadow-[inset_0_1px_0_rgba(255,255,255,0.9)]">
                    <div class="flex items-start gap-3">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-[#0878f9] shadow-sm ring-1 ring-[#e2e7ee]">
                            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="M9 12h6"/></svg>
                        </span>
                        <div>
                            <p class="text-xs font-bold uppercase tracking-[0.1em] text-[#8a929e]">@(Model.IsArchived ? "Archived account" : "Access temporarily unavailable")</p>
                            <p class="mt-1 text-[13px] leading-5 text-[#454b54]">
                                @if (Model.IsArchived)
                                {
                                    <text>Your account records remain securely retained. An administrator must restore the account before you can sign in again.</text>
                                }
                                else
                                {
                                    <text>Your data remains protected while access is paused. Please wait before trying again or ask an administrator to review the account.</text>
                                }
                            </p>
                        </div>
                    </div>
                </div>

                <div class="mt-7 grid gap-3 sm:grid-cols-2">
                    <a asp-area="Identity" asp-page="/Account/Login" class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-[#0878f9] px-4 text-sm font-bold text-white shadow-[0_10px_24px_-10px_rgba(8,120,249,0.75)] transition hover:-translate-y-0.5 hover:bg-[#0669db] hover:shadow-[0_14px_28px_-10px_rgba(8,120,249,0.72)] focus:outline-none focus:ring-4 focus:ring-blue-100">
                        Return to sign in
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                    </a>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="inline-flex h-11 items-center justify-center gap-2 rounded-xl border border-[#dce2ea] bg-white px-4 text-sm font-bold text-[#30343a] shadow-sm transition hover:-translate-y-0.5 hover:border-[#c2cbd6] hover:bg-[#f8fafc] focus:outline-none focus:ring-4 focus:ring-slate-100">
                        Back to home
                    </a>
                </div>
            </div>

            <div class="flex items-center justify-center gap-2 border-t border-[#edf0f4] bg-[#fbfcfe] px-6 py-4 text-center text-[11px] font-medium text-[#8a929e]">
                <svg class="h-3.5 w-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
                Your account information remains protected
            </div>
        </div>
    </main>
</div>
