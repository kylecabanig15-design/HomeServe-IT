@using Microsoft.AspNetCore.Identity
@using HomeServeIT.Web.Models
@using HomeServeIT.Web.Areas.Technician.Models
@inject UserManager<ApplicationUser> UserManager
@model TechnicianDashboardViewModel
@{
    ViewData["Title"] = "Technician Dashboard";
    var user = await UserManager.GetUserAsync(User);
    var fullName = user?.FullName ?? user?.UserName ?? "Technician";
    var firstName = fullName.Split(' ').FirstOrDefault() ?? "Technician";
    
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : (hour < 18 ? "Good afternoon" : "Good evening");

    var todayJobCount = Model.TodaysJobs.Count;
    var todayCompleted = Model.TodaysJobs.Count(j => j.Status == "Completed");
    var todayInProgress = Model.TodaysJobs.Count(j => j.Status == "In Progress");
    var todayPending = Model.TodaysJobs.Count(j => j.Status == "Pending");
    var completionPercent = todayJobCount > 0 ? (int)Math.Round((double)todayCompleted / todayJobCount * 100) : 100;

    var nextJob = Model.TodaysJobs.FirstOrDefault(j => j.Status == "In Progress") 
                  ?? Model.TodaysJobs.FirstOrDefault(j => j.Status == "Pending")
                  ?? Model.UpcomingJobs.FirstOrDefault();
}

<div class="flex flex-col items-start w-full max-w-7xl mx-auto p-4 sm:p-6 lg:p-8 gap-6"
     x-data="{
        drawerOpen: false,
        drawerJob: null,
        photoModalOpen: false,
        photoModalSrc: '',
        checks: { c1: false, c2: false, c3: false, c4: false, c5: false },
        get allChecked() {
            return this.checks.c1 && this.checks.c2 && this.checks.c3 && this.checks.c4 && this.checks.c5;
        },

        openJobDrawer(job) {
            window.location.href = '/Technician/AssignedJobs?jobId=' + encodeURIComponent(job.id);
        },

        openPhoto(src) {
            this.photoModalSrc = src;
            this.photoModalOpen = true;
        }
     }">

    <!-- Top Greeting & Live Date Hero -->
    <div class="bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 rounded-3xl p-6 sm:p-8 text-white w-full shadow-lg relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
        <div class="absolute right-20 top-0 w-32 h-32 bg-blue-400/20 rounded-full blur-xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex flex-col">
                <div class="flex items-center gap-2">
                    <span class="px-2.5 py-0.5 rounded-full bg-white/20 text-white text-[11px] font-semibold tracking-wide uppercase font-['JetBrains_Mono']">
                        Technician Desk
                    </span>
                    <span class="text-xs text-blue-100 font-medium">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-bold font-['Inter'] mt-1.5 tracking-tight">
                    <span class="inline-flex items-center gap-2">@greeting, @firstName! <span class="text-blue-100"><partial name="~/Views/Shared/_AppIcon.cshtml" model='"sparkles"' /></span></span>
                </h1>
                <p class="text-sm text-blue-100 mt-1 max-w-xl leading-relaxed">
                    @if (todayJobCount > 0)
                    {
                        <span>You have <strong>@todayJobCount assigned job@(todayJobCount != 1 ? "s" : "")</strong> scheduled for today. @todayCompleted completed, @todayInProgress in progress.</span>
                    }
                    else
                    {
                        <span>All clear for today! No immediate appointments scheduled. Check upcoming jobs below.</span>
                    }
                </p>
            </div>

            <!-- Daily Progress Meter -->
            <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 flex flex-col gap-2.5 min-w-[220px]">
                <div class="flex items-center justify-between text-xs">
                    <span class="font-semibold text-blue-100">Today's Resolution</span>
                    <span class="font-bold text-white font-['JetBrains_Mono']">@completionPercent%</span>
                </div>
                <!-- Progress Bar -->
                <div class="w-full bg-black/20 rounded-full h-2.5 overflow-hidden p-0.5">
                    <div class="bg-emerald-400 h-full rounded-full transition-all duration-500" style="width: @completionPercent%;"></div>
                </div>
                <div class="flex items-center justify-between text-[11px] text-blue-200">
                    <span>@todayCompleted of @todayJobCount completed</span>
                    <span>@(todayJobCount - todayCompleted) left</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 3 Quick Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 w-full">
        <div class="bg-white border border-[#e7eaf0] rounded-2xl p-5 shadow-xs flex items-center justify-between">
            <div>
                <p class="font-['Inter'] text-xs font-semibold text-[#8a929e] uppercase tracking-wider">Jobs Today</p>
                <p class="font-['Inter'] text-2xl font-bold text-[#17191c] mt-1">@todayJobCount</p>
                <span class="text-[11px] text-[#5d6470] mt-0.5 block">@todayPending awaiting start</span>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-blue-50 text-[#0878f9] flex items-center justify-center">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            </div>
        </div>

        <div class="bg-white border border-[#e7eaf0] rounded-2xl p-5 shadow-xs flex items-center justify-between">
            <div>
                <p class="font-['Inter'] text-xs font-semibold text-emerald-600 uppercase tracking-wider">Completed Today</p>
                <p class="font-['Inter'] text-2xl font-bold text-emerald-600 mt-1">@todayCompleted</p>
                <span class="text-[11px] text-[#5d6470] mt-0.5 block">resolved jobs</span>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
        </div>

        <div class="bg-white border border-[#e7eaf0] rounded-2xl p-5 shadow-xs flex items-center justify-between">
            <div>
                <p class="font-['Inter'] text-xs font-semibold text-amber-600 uppercase tracking-wider">Total Assigned</p>
                <p class="font-['Inter'] text-2xl font-bold text-amber-600 mt-1">@Model.TotalAssigned</p>
                <span class="text-[11px] text-[#5d6470] mt-0.5 block">active &amp; retained records</span>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
        </div>
    </div>

    <!-- Active Spotlight: Next Up Focus Card -->
    @if (nextJob != null)
    {
        var isNextInProgress = nextJob.Status == "In Progress";
        var isNextCompleted = nextJob.Status == "Completed";
        var cust = nextJob.Customer != null ? $"{nextJob.Customer.FirstName} {nextJob.Customer.LastName}" : "Customer";
        var phone = nextJob.Customer?.PhoneNumber ?? "";
        var addr = nextJob.Customer?.HomeAddress ?? "Location pending";

        <div class="w-full bg-white border border-[#e7eaf0] rounded-3xl p-6 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-5 relative overflow-hidden transition-all hover:shadow-md hover:border-blue-100">
            <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-gradient-to-b from-blue-500 to-indigo-600"></div>

            <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-100/50 text-blue-600 flex items-center justify-center shrink-0 shadow-2xs">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
                </div>
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="text-[10px] font-bold uppercase tracking-[0.1em] text-blue-600 bg-blue-50/80 px-2.5 py-0.5 rounded-full border border-blue-100/50">Next Appointment</span>
                        <span class="font-['JetBrains_Mono'] font-medium text-xs text-[#8a929e] bg-gray-50 px-2 py-0.5 rounded-md border border-gray-100">JOB-@nextJob.ScheduledDate.Year-@nextJob.RequestID.ToString("D4")</span>
                    </div>
                    <h3 class="font-['Inter'] font-bold text-[17px] text-[#17191c] leading-tight">@nextJob.IssueDescription</h3>
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-[#5d6470] mt-2.5 font-medium">
                        <span class="inline-flex items-center gap-1.5 text-[#17191c]">
                            <svg class="h-3.5 w-3.5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
                            @cust
                        </span>
                        <span class="w-1 h-1 rounded-full bg-gray-300"></span>
                        <span class="inline-flex items-center gap-1.5">
                            <svg class="h-3.5 w-3.5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                            @addr
                        </span>
                        <span class="w-1 h-1 rounded-full bg-gray-300"></span>
                        <span class="inline-flex items-center gap-1.5 text-blue-600 bg-blue-50 px-2 py-0.5 rounded-md">
                            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            @nextJob.ScheduledDate.ToString("MMM d · h:mm tt")
                        </span>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-2 w-full md:w-auto mt-2 md:mt-0">
                <button type="button" 
                        data-request="@HomeServeIT.Web.Models.ServiceRequestUiData.Serialize(nextJob)" @@click="openJobDrawer(JSON.parse($el.dataset.request))"
                        class="flex-1 md:flex-initial px-5 py-2.5 bg-[#0878f9] hover:bg-blue-600 text-white font-['Inter'] font-semibold text-xs rounded-xl shadow-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer">
                    <span>Manage Progress</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
            </div>
        </div>
    }

    <!-- Main Content: Today's Schedule & Upcoming -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 w-full">
        
        <!-- Left: Today's Schedule Timeline (2 cols) -->
        <div class="lg:col-span-2 bg-white border border-[#e7eaf0] rounded-3xl p-6 shadow-xs flex flex-col gap-4">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-['Inter'] font-bold text-lg text-[#17191c]">Today's Job Schedule</h2>
                    <p class="font-['Inter'] text-xs text-[#8a929e] mt-0.5">Assigned appointments for today, sorted chronologically.</p>
                </div>
                <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-2.5 py-1 rounded-full">@todayJobCount Scheduled</span>
            </div>

            <div class="divide-y divide-[#f0f2f5] mt-2">
                @if (!Model.TodaysJobs.Any())
                {
                    <div class="py-12 text-center flex flex-col items-center justify-center gap-2">
                        <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-400">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        </div>
                        <p class="font-['Inter'] text-sm font-semibold text-[#17191c]">No jobs scheduled for today</p>
                        <p class="font-['Inter'] text-xs text-[#8a929e]">Enjoy your downtime or prepare for upcoming appointments below.</p>
                    </div>
                }

                @foreach (var job in Model.TodaysJobs.OrderBy(j => j.ScheduledDate))
                {
                    var isCompleted = job.Status == "Completed";
                    var isInProgress = job.Status == "In Progress";
                    var cust = job.Customer != null ? $"{job.Customer.FirstName} {job.Customer.LastName}" : "Customer";
                    var phone = job.Customer?.PhoneNumber ?? "";
                    var addr = job.Customer?.HomeAddress ?? "No address";

                    <div class="py-4 flex items-center justify-between gap-4 group hover:bg-gray-50/70 rounded-xl px-2 -mx-2 transition-colors cursor-pointer"
                         data-request="@HomeServeIT.Web.Models.ServiceRequestUiData.Serialize(job)" @@click="openJobDrawer(JSON.parse($el.dataset.request))">
                        
                        <div class="flex items-center gap-4 min-w-0">
                            <!-- Time Badge -->
                            <div class="w-16 text-right shrink-0">
                                <span class="font-['Inter'] text-xs font-bold text-[#17191c] block">@job.ScheduledDate.ToString("h:mm tt")</span>
                                <span class="font-['Inter'] text-[10px] text-[#8a929e]">Today</span>
                            </div>

                            <!-- Color indicator bar -->
                            <div class="w-1 h-10 rounded-full shrink-0 @(isCompleted ? "bg-emerald-500" : (isInProgress ? "bg-blue-600" : "bg-amber-500"))"></div>

                            <!-- Info -->
                            <div class="flex flex-col min-w-0">
                                <span class="font-['Inter'] font-semibold text-sm text-[#17191c] truncate">@job.IssueDescription</span>
                                <span class="font-['Inter'] text-xs text-[#5d6470] truncate mt-0.5 inline-flex items-center gap-1"><svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 22a8 8 0 0 1 16 0"/></svg>@cust <span>·</span><svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2"/></svg>@addr</span>
                            </div>
                        </div>

                        <!-- Status Pill & Action -->
                        <div class="flex items-center gap-2 shrink-0">
                            @if (isCompleted)
                            {
                                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100 flex items-center gap-1">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                                    Done
                                </span>
                            }
                            else if (isInProgress)
                            {
                                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                    Pending
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Right: Upcoming Jobs Mini-Widget (1 col) -->
        <div class="bg-white border border-[#e7eaf0] rounded-3xl p-6 shadow-xs flex flex-col gap-4">
            <div class="flex items-center justify-between">
                <h2 class="font-['Inter'] font-bold text-base text-[#17191c]">Upcoming Jobs</h2>
                <a asp-area="Technician" asp-controller="AssignedJobs" asp-action="Index" class="text-xs font-semibold text-[#0878f9] hover:underline">
                    View All →
                </a>
            </div>

            <div class="divide-y divide-[#f0f2f5]">
                @if (!Model.UpcomingJobs.Any())
                {
                    <p class="py-8 text-xs text-center text-[#8a929e]">No upcoming jobs scheduled later this week.</p>
                }

                @foreach (var job in Model.UpcomingJobs)
                {
                    var cust = job.Customer != null ? $"{job.Customer.FirstName} {job.Customer.LastName}" : "Customer";
                    var phone = job.Customer?.PhoneNumber ?? "";
                    var addr = job.Customer?.HomeAddress ?? "No address";

                    <div class="py-3 flex flex-col gap-1 cursor-pointer hover:bg-gray-50 rounded-xl p-2 -mx-2 transition-colors"
                         data-request="@HomeServeIT.Web.Models.ServiceRequestUiData.Serialize(job)" @@click="openJobDrawer(JSON.parse($el.dataset.request))">
                        <div class="flex items-center justify-between">
                            <span class="font-['JetBrains_Mono'] text-[11px] text-[#0878f9] font-medium">@job.ScheduledDate.ToString("MMM d · h:mm tt")</span>
                            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full @(job.Priority == "Urgent" ? "bg-red-50 text-red-700" : "bg-gray-100 text-gray-700")">
                                @(job.Priority ?? "Normal")
                            </span>
                        </div>
                        <span class="font-['Inter'] font-semibold text-xs text-[#17191c] truncate">@job.IssueDescription</span>
                        <span class="font-['Inter'] text-[11px] text-[#8a929e] inline-flex items-center gap-1"><svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 22a8 8 0 0 1 16 0"/></svg>@cust</span>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- SHARED JOB DETAILS DRAWER (DASHBOARD) -->
    <div x-show="drawerOpen"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs"
         style="display:none;"
         @@click.self="drawerOpen = false">

        <div x-show="drawerOpen"
             x-transition:enter="transition ease-out duration-300 transform"
             x-transition:enter-start="translate-x-full"
             x-transition:enter-end="translate-x-0"
             x-transition:leave="transition ease-in duration-200 transform"
             x-transition:leave-start="translate-x-0"
             x-transition:leave-end="translate-x-full"
             class="absolute right-0 top-0 h-full w-full max-w-[520px] bg-white shadow-2xl flex flex-col overflow-hidden">

            <!-- Drawer Header -->
            <div class="px-6 py-5 border-b border-[#e7eaf0] bg-white sticky top-0 z-20 flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="font-['JetBrains_Mono'] text-xs text-[#0878f9] font-semibold" x-text="drawerJob?.jobCode"></span>
                        <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full"
                              :class="{
                                  'bg-emerald-50 text-emerald-700': drawerJob?.status === 'Completed',
                                  'bg-blue-50 text-blue-700': drawerJob?.status === 'In Progress',
                                  'bg-amber-50 text-amber-700': drawerJob?.status === 'Pending'
                              }" x-text="drawerJob?.status">
                        </span>
                    </div>
                    <h3 class="font-['Inter'] font-bold text-[#17191c] text-lg mt-0.5">Job Execution Details</h3>
                </div>

                <button type="button" @@click="drawerOpen = false" class="w-8 h-8 rounded-full hover:bg-gray-100 text-[#8a929e] hover:text-[#17191c] flex items-center justify-center transition-colors">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </div>

            <!-- Drawer Body -->
            <div class="flex-1 overflow-y-auto p-6 flex flex-col gap-5" x-show="drawerJob">

                <!-- Progress Tracker -->
                <div class="bg-gradient-to-br from-gray-50 to-blue-50/30 border border-[#e7eaf0] rounded-2xl p-4">
                    <div class="grid grid-cols-3 gap-2 text-center">
                        <div class="flex flex-col items-center">
                            <div class="w-7 h-7 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-xs mb-1"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 12 4 4L19 6"/></svg></div>
                            <span class="text-[11px] font-semibold text-[#17191c]">Scheduled</span>
                        </div>
                        <div class="flex flex-col items-center">
                            <div class="w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs mb-1"
                                 :class="drawerJob?.status === 'Completed' ? 'bg-emerald-500 text-white' : (drawerJob?.status === 'In Progress' ? 'bg-blue-600 text-white animate-pulse' : 'bg-gray-200 text-gray-500')">
                                <svg x-show="drawerJob?.status === 'Completed'" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 12 4 4L19 6"/></svg><span x-show="drawerJob?.status !== 'Completed'">2</span>
                            </div>
                            <span class="text-[11px] font-semibold" :class="drawerJob?.status !== 'Pending' ? 'text-[#17191c]' : 'text-gray-400'">In Progress</span>
                        </div>
                        <div class="flex flex-col items-center">
                            <div class="w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs mb-1"
                                 :class="drawerJob?.status === 'Completed' ? 'bg-emerald-500 text-white' : 'bg-gray-200 text-gray-500'">
                                <svg x-show="drawerJob?.status === 'Completed'" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 12 4 4L19 6"/></svg><span x-show="drawerJob?.status !== 'Completed'">3</span>
                            </div>
                            <span class="text-[11px] font-semibold" :class="drawerJob?.status === 'Completed' ? 'text-emerald-700' : 'text-gray-400'">Completed</span>
                        </div>
                    </div>
                </div>

                <!-- Pre-Completion Quality Checklist (SOP) -->
                <div class="bg-white border border-[#e7eaf0] rounded-2xl p-4 shadow-2xs" x-show="drawerJob?.status !== 'Pending'">
                    <div class="flex items-center justify-between mb-3">
                        <span class="font-['Inter'] font-bold text-xs text-[#17191c] uppercase tracking-wider flex items-center gap-1.5">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0878f9" stroke-width="2.5"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                            Quality & Completion Checklist
                        </span>
                        <span class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider">Required for sign-off</span>
                    </div>
                    <div class="flex flex-col gap-2.5">
                        <label class="flex items-start gap-2.5 cursor-pointer group">
                            <input type="checkbox" x-model="checks.c1" :disabled="drawerJob?.status === 'Completed'" class="mt-0.5 w-4 h-4 text-blue-600 bg-gray-100 border-[#e7eaf0] rounded focus:ring-blue-500">
                            <div class="flex flex-col">
                                <span class="font-['Inter'] text-xs font-semibold text-[#17191c] group-hover:text-blue-600 transition-colors">1. Comprehensive Diagnostic & Health Check</span>
                                <span class="font-['Inter'] text-[11px] text-[#5d6470]">Thermal inspection, power rail test & event log triage.</span>
                            </div>
                        </label>
                        <label class="flex items-start gap-2.5 cursor-pointer group">
                            <input type="checkbox" x-model="checks.c2" :disabled="drawerJob?.status === 'Completed'" class="mt-0.5 w-4 h-4 text-blue-600 bg-gray-100 border-[#e7eaf0] rounded focus:ring-blue-500">
                            <div class="flex flex-col">
                                <span class="font-['Inter'] text-xs font-semibold text-[#17191c] group-hover:text-blue-600 transition-colors">2. Hardware Repair / Part Replacement</span>
                                <span class="font-['Inter'] text-[11px] text-[#5d6470]">Physical repairs, wiring harness & clean part installation.</span>
                            </div>
                        </label>
                        <label class="flex items-start gap-2.5 cursor-pointer group">
                            <input type="checkbox" x-model="checks.c3" :disabled="drawerJob?.status === 'Completed'" class="mt-0.5 w-4 h-4 text-blue-600 bg-gray-100 border-[#e7eaf0] rounded focus:ring-blue-500">
                            <div class="flex flex-col">
                                <span class="font-['Inter'] text-xs font-semibold text-[#17191c] group-hover:text-blue-600 transition-colors">3. Firmware & System Configuration</span>
                                <span class="font-['Inter'] text-[11px] text-[#5d6470]">Driver updates, OS calibration, and network connectivity.</span>
                            </div>
                        </label>
                        <label class="flex items-start gap-2.5 cursor-pointer group">
                            <input type="checkbox" x-model="checks.c4" :disabled="drawerJob?.status === 'Completed'" class="mt-0.5 w-4 h-4 text-blue-600 bg-gray-100 border-[#e7eaf0] rounded focus:ring-blue-500">
                            <div class="flex flex-col">
                                <span class="font-['Inter'] text-xs font-semibold text-[#17191c] group-hover:text-blue-600 transition-colors">4. QA Stability & Stress Benchmark</span>
                                <span class="font-['Inter'] text-[11px] text-[#5d6470]">Full functional stress test & performance verification.</span>
                            </div>
                        </label>
                        <label class="flex items-start gap-2.5 cursor-pointer group">
                            <input type="checkbox" x-model="checks.c5" :disabled="drawerJob?.status === 'Completed'" class="mt-0.5 w-4 h-4 text-blue-600 bg-gray-100 border-[#e7eaf0] rounded focus:ring-blue-500">
                            <div class="flex flex-col">
                                <span class="font-['Inter'] text-xs font-semibold text-[#17191c] group-hover:text-blue-600 transition-colors">5. Handover & 30-Day Warranty Activation</span>
                                <span class="font-['Inter'] text-[11px] text-[#5d6470]">Customer demonstration & electronic service sign-off.</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Action form -->
                <div class="bg-white border rounded-2xl p-4 shadow-2xs">
                    <form method="post" asp-action="UpdateStatus" asp-controller="AssignedJobs" asp-area="Technician" class="flex flex-col gap-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="requestId" :value="drawerJob?.id" />
                        
                        <span class="text-xs font-bold text-[#17191c] uppercase tracking-wider font-['Inter']">Update Job Status</span>
                        
                        <div class="grid grid-cols-2 gap-2">
                            <button type="submit" name="status" value="In Progress" 
                                    :disabled="drawerJob?.status === 'In Progress'"
                                    class="py-2.5 px-3 bg-blue-600 hover:bg-blue-700 disabled:opacity-50 text-white font-['Inter'] font-semibold text-xs rounded-xl transition-colors cursor-pointer">
                                Mark In Progress
                            </button>
                            
                            <button type="submit" name="status" value="Completed" 
                                    :disabled="drawerJob?.status === 'Completed' || (drawerJob?.status === 'In Progress' && !allChecked) || drawerJob?.status === 'Pending'"
                                    class="py-2.5 px-3 bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50 text-white font-['Inter'] font-semibold text-xs rounded-xl transition-colors cursor-pointer">
                                <span class="inline-flex items-center justify-center gap-1.5"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 12 4 4L19 6"/></svg>Mark completed</span>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Customer Details -->
                <div class="bg-gray-50 rounded-2xl p-4 flex flex-col gap-3">
                    <span class="text-[11px] font-bold text-[#8a929e] uppercase font-['Inter']">Customer Contact</span>
                    <h4 class="font-['Inter'] font-bold text-base text-[#17191c]" x-text="drawerJob?.customer"></h4>
                    <p class="font-['Inter'] text-xs text-[#5d6470]" x-text="drawerJob?.address"></p>
                    <a :href="'tel:' + drawerJob?.phone" x-show="drawerJob?.phone" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#0878f9] underline"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 3.1 5.2 2 2 0 0 1 5 3h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L9 10.8a16 16 0 0 0 4.2 4.2l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg><span x-text="drawerJob?.phone"></span></a>
                </div>

                <!-- Description -->
                <div class="bg-white border border-[#e7eaf0] rounded-2xl p-4 flex flex-col gap-2">
                    <span class="text-[11px] font-bold text-[#8a929e] uppercase font-['Inter']">Issue Description</span>
                    <p class="font-['Inter'] text-xs text-[#17191c] leading-relaxed font-medium" x-text="drawerJob?.desc"></p>
                </div>
            </div>

            <!-- Drawer Footer -->
            <div class="p-4 bg-gray-50 border-t border-[#e7eaf0] text-right">
                <button type="button" @@click="drawerOpen = false" class="px-4 py-2 bg-white border border-[#e7eaf0] text-xs font-semibold text-[#17191c] rounded-xl hover:bg-gray-100 cursor-pointer">
                    Close
                </button>
            </div>
        </div>
    </div>

</div>
