@using HomeServeIT.Web.Areas.Technician.Models
@using System.Text.Json
@model TechnicianAssignedJobsViewModel
@inject Microsoft.AspNetCore.Identity.UserManager<HomeServeIT.Web.Models.ApplicationUser> _userManager
@{
    ViewData["Title"] = "Assigned Jobs";
    var allJobsList = Model.ActiveJobs.Concat(Model.CompletedJobs).OrderByDescending(j => j.ScheduledDate).ToList();
    var actionableJobsList = allJobsList.Where(j => j.Customer?.User?.IsArchived != true).ToList();
    var totalAll = allJobsList.Count;
    var inProgressCount = actionableJobsList.Count(j => j.Status == "In Progress");
    var pendingCount = actionableJobsList.Count(j => j.Status == "Pending");
    var completedCount = actionableJobsList.Count(j => j.Status == "Completed");
    var archivedCustomerCount = allJobsList.Count(j => j.Customer?.User?.IsArchived == true);

    var jobsForAlpine = allJobsList.Select(job =>
    {
        var custName = job.Customer != null ? $"{job.Customer.FirstName} {job.Customer.LastName}".Trim() : "Customer";
        var custPhone = job.Customer?.PhoneNumber ?? "";
        var custAddress = job.Customer?.HomeAddress ?? "No address specified";
        var jobCategory = string.IsNullOrWhiteSpace(job.ServiceCategory) ? "General Repair" : job.ServiceCategory;
        var jobPriority = string.IsNullOrWhiteSpace(job.Priority) ? "Normal" : job.Priority;
        var jobImg = job.ImagePath ?? "";
        var customerArchived = job.Customer?.User?.IsArchived == true;
        var searchBlob = $"{job.RequestID} {custName} {custAddress} {(job.IssueDescription ?? "")} {jobCategory} {jobPriority} {job.Status} {(customerArchived ? "archived locked customer" : "")}".ToLower();

        return new
        {
            id = job.RequestID,
            jobCode = $"JOB-{job.ScheduledDate.Year}-{job.RequestID:D4}",
            desc = job.IssueDescription ?? "",
            customer = custName,
            phone = custPhone,
            address = custAddress,
            date = job.ScheduledDate.ToString("MMMM d, yyyy · h:mm tt"),
            rawDate = job.ScheduledDate.ToString("yyyy-MM-ddTHH:mm"),
            cat = jobCategory,
            prio = jobPriority,
            status = job.Status,
            image = jobImg,
            c1 = job.Check1_Diagnostic,
            c2 = job.Check2_Hardware,
            c3 = job.Check3_Firmware,
            c4 = job.Check4_QA,
            c5 = job.Check5_Handover,
            isCompleted = job.Status == "Completed",
            isInProgress = job.Status == "In Progress",
            customerArchived,
            searchBlob
        };
    }).ToList();

    var jobsJson = JsonSerializer.Serialize(jobsForAlpine);
    var inventoryItems = ViewBag.InventoryItems as IEnumerable<HomeServeIT.Web.Models.InventoryItem> ?? [];
    var inventoryJson = JsonSerializer.Serialize(inventoryItems.Select(i => new { id = i.ItemID, name = i.ItemName, sku = i.SKU, category = i.Category, stock = i.StockQuantity, price = i.UnitPrice }));
    var openJobId = ViewData["OpenJobId"] as int?;
    var openTab = ViewData["OpenTab"] as string ?? "details";
}

<div class="flex flex-col items-start w-full max-w-7xl mx-auto p-4 sm:p-6 lg:p-8 gap-6" 
     data-jobs="@jobsJson"
     data-inventory="@inventoryJson"
     x-data="{
        currentTab: 'All',
        jobs: [],
        searchQuery: '',
        sortKey: 'date',
        sortDirection: 'desc',
        drawerOpen: false,
        drawerJob: null,
        photoModalOpen: false,
        photoModalSrc: '',
        statusChangeModalOpen: false,
        targetStatus: '',
        checks: { c1: false, c2: false, c3: false, c4: false, c5: false },
        preCheck1: false,
        preCheck2: false,
        inventory: [],
        quoteLines: [{ itemId: '', quantity: 1 }],
        laborAmount: 0,
        editQuoteOpen: false,
        editInvoiceId: null,
        editDeadline: '',
        addQuoteLine() { this.quoteLines.push({ itemId: '', quantity: 1 }); },
        removeQuoteLine(index) { if (this.quoteLines.length > 1) this.quoteLines.splice(index, 1); },
        inventoryItem(id) { return this.inventory.find(i => i.id === Number(id)); },
        get partsTotal() { return this.quoteLines.reduce((sum, line) => { const item = this.inventoryItem(line.itemId); return sum + (item ? item.price * Number(line.quantity || 0) : 0); }, 0); },
        get quoteTotal() { return this.partsTotal + Number(this.laborAmount || 0); },
        async openQuotationEditor() {
            const response = await fetch(`/Technician/AssignedJobs/GetPendingQuotation?requestId=${this.drawerJob.id}`);
            if (!response.ok) { alert('This quotation is no longer available for editing.'); return; }
            const data = await response.json();
            this.editInvoiceId = data.invoiceID;
            this.quoteLines = data.lines.map(line => ({ itemId: line.itemId, quantity: line.quantity }));
            if (!this.quoteLines.length) this.quoteLines = [{ itemId: '', quantity: 1 }];
            this.laborAmount = data.laborAmount;
            this.editDeadline = data.deadline || '';
            this.editQuoteOpen = true;
            this.$nextTick(() => document.getElementById('edit-quotation-deadline')?.dispatchEvent(new Event('premium-date-sync')));
        },
        get allChecked() {
            return this.checks.c1 && this.checks.c2 && this.checks.c3 && this.checks.c4 && this.checks.c5;
        },
        get completedChecksCount() {
            return [this.checks.c1, this.checks.c2, this.checks.c3, this.checks.c4, this.checks.c5].filter(Boolean).length;
        },
        get checklistProgressPercent() {
            return Math.round((this.completedChecksCount / 5) * 100);
        },

        get filteredJobs() {
            const filtered = this.jobs.filter(job => this.matchesTab(job) && this.matchesSearch(job.searchBlob));
            return [...filtered].sort((left, right) => {
                const leftValue = this.sortKey === 'date' ? new Date(left.rawDate).getTime() : (left[this.sortKey] ?? '').toString().toLowerCase();
                const rightValue = this.sortKey === 'date' ? new Date(right.rawDate).getTime() : (right[this.sortKey] ?? '').toString().toLowerCase();
                const comparison = typeof leftValue === 'number'
                    ? leftValue - rightValue
                    : leftValue.localeCompare(rightValue, undefined, { numeric: true, sensitivity: 'base' });
                return this.sortDirection === 'asc' ? comparison : -comparison;
            });
        },

        matchesTab(job) {
            if (this.currentTab === 'All') return true;
            if (this.currentTab === 'Locked') return job.customerArchived;
            if (job.customerArchived) return false;
            if (this.currentTab === 'In Progress') return job.status === 'In Progress';
            if (this.currentTab === 'Scheduled') return job.status === 'Pending';
            if (this.currentTab === 'Completed') return job.status === 'Completed';
            return true;
        },

        matchesSearch(text) {
            if (!this.searchQuery.trim()) return true;
            return text.toLowerCase().includes(this.searchQuery.toLowerCase().trim());
        },

        async openJobDrawer(job) {
            if (job.customerArchived) return;
            this.drawerJob = job;
            this.drawerTab = 'details';
            if (job.status === 'Completed') {
                this.checks = { c1: true, c2: true, c3: true, c4: true, c5: true };
            } else {
                this.checks = { c1: job.c1, c2: job.c2, c3: job.c3, c4: job.c4, c5: job.c5 };
            }
            this.drawerOpen = true;
            await this.initChat(job.id);
        },

        openPhoto(src) {
            this.photoModalSrc = src;
            this.photoModalOpen = true;
        },

        drawerTab: 'details',
        messages: [],
        newMessage: '',
        connection: null,
        currentUserId: '@_userManager.GetUserId(User)',
        get unreadMessageCount() { return this.messages.filter(m => !m.isRead && m.senderId !== this.currentUserId).length; },

        async openMessages() {
            this.drawerTab = 'chat';
            await this.markIncomingMessagesRead();
            this.scrollToBottom();
        },

        async markIncomingMessagesRead() {
            if (!this.connection || !this.drawerJob) return;
            const unread = this.messages.filter(m => !m.isRead && m.senderId !== this.currentUserId);
            for (const message of unread) {
                await this.connection.invoke('MarkAsRead', this.drawerJob.id.toString(), message.messageID);
                message.isRead = true;
            }
        },

        async initChat(jobId) {
            if (this.connection) await this.connection.stop();
            
            const res = await fetch(`/Technician/AssignedJobs/GetChatHistory?requestId=${jobId}`);
            this.messages = await res.json();

            this.connection = new signalR.HubConnectionBuilder().withUrl('/chathub').build();
            this.connection.on('ReceiveMessage', (msg) => {
                this.messages.push({
                    messageID: msg.messageId,
                    content: msg.content,
                    timestamp: msg.timestamp,
                    senderId: msg.senderId,
                    senderName: msg.senderName || 'User',
                    isRead: msg.senderId === this.currentUserId
                });
                if (msg.senderId !== this.currentUserId && this.drawerTab === 'chat') this.markIncomingMessagesRead();
                this.scrollToBottom();
            });
            this.connection.on('MessageRead', (messageId) => {
                const m = this.messages.find(x => x.messageID === messageId);
                if (m) m.isRead = true;
            });
            await this.connection.start();
            await this.connection.invoke('JoinRequestGroup', jobId.toString());
            this.scrollToBottom();
        },

        async sendMessage() {
            if (!this.newMessage.trim() || !this.connection) return;
            const msg = this.newMessage;
            this.newMessage = '';
            await this.connection.invoke('SendMessage', this.drawerJob.id.toString(), msg);
        },

        scrollToBottom() {
            setTimeout(() => {
                const el = document.getElementById('chat-messages');
                if (el) el.scrollTop = el.scrollHeight;
            }, 100);
        },

        async saveChecks() {
            if (!this.drawerJob) return;
            const fd = new FormData();
            fd.append('requestId', this.drawerJob.id);
            fd.append('c1', this.checks.c1);
            fd.append('c2', this.checks.c2);
            fd.append('c3', this.checks.c3);
            fd.append('c4', this.checks.c4);
            fd.append('c5', this.checks.c5);
            
            const token = document.querySelector('input[name=__RequestVerificationToken]')?.value;
            if (token) {
                fd.append('__RequestVerificationToken', token);
            }

            try {
                await fetch('/Technician/AssignedJobs/SaveChecklistProgress', {
                    method: 'POST',
                    body: fd
                });
            } catch (err) {
                console.error('Failed to save checklist', err);
            }
        }
     }"
     x-init="jobs = JSON.parse($el.dataset.jobs); inventory = JSON.parse($el.dataset.inventory); @if (openJobId.HasValue) { <text>$nextTick(() => { const job = jobs.find(j => j.id === @openJobId.Value); if (job) { openJobDrawer(job); drawerTab = '@openTab'; } });</text> }">

    <!-- Alert / Toast Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="w-full bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl font-['Inter'] text-sm flex items-center justify-between shadow-sm animate-fadeIn">
            <div class="flex items-center gap-2.5">
                <div class="w-7 h-7 bg-emerald-100 rounded-full flex items-center justify-center shrink-0">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span class="font-medium">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" @@click="$el.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700 p-1">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>
    }

    <!-- Page Header & Key Metrics -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 w-full">
        <div>
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
                    Technician Portal
                </span>
                <span class="text-xs text-gray-400 font-['JetBrains_Mono']">@DateTime.Now.ToString("dddd, MMM d")</span>
            </div>
            <h1 class="font-['Inter'] font-bold text-2xl sm:text-3xl text-[#17191c] mt-1 tracking-tight">
                Assigned Jobs
            </h1>
            <p class="font-['Inter'] text-sm text-[#5d6470] mt-0.5">
                Manage, execute, and mark progress on service requests assigned to you.
            </p>
        </div>

        <div class="flex items-center gap-2 self-start sm:self-auto">
            <a asp-area="Technician" asp-controller="Schedule" asp-action="Index" 
               class="inline-flex items-center gap-2 px-3.5 py-2 bg-white border border-[#e7eaf0] hover:bg-gray-50 text-[#17191c] font-['Inter'] font-medium text-xs rounded-xl shadow-xs transition-colors">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                View Schedule Calendar
            </a>
        </div>
    </div>

    <!-- Quick Stats Cards (Clickable to Filter) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5 w-full">
        <!-- All Card -->
        <button type="button" @@click="currentTab = 'All'" 
                :class="currentTab === 'All' ? 'ring-2 ring-[#0878f9] border-[#0878f9] bg-blue-50/30' : 'border-[#e7eaf0] bg-white hover:border-gray-300'"
                class="p-4 rounded-2xl border text-left transition-all cursor-pointer flex flex-col justify-between group shadow-xs">
            <div class="flex items-center justify-between">
                <span class="font-['Inter'] text-xs font-semibold text-[#8a929e] uppercase tracking-wider">Total Assigned</span>
                <span class="w-8 h-8 rounded-xl bg-gray-100 group-hover:bg-blue-100 flex items-center justify-center transition-colors">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#5d6470" stroke-width="2"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
                </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="font-['Inter'] text-2xl sm:text-3xl font-bold text-[#17191c]">@totalAll</span>
                <span class="text-[11px] text-[#8a929e] font-medium">retained records</span>
            </div>
        </button>

        <!-- In Progress Card -->
        <button type="button" @@click="currentTab = 'In Progress'" 
                :class="currentTab === 'In Progress' ? 'ring-2 ring-blue-500 border-blue-500 bg-blue-50/40' : 'border-[#e7eaf0] bg-white hover:border-gray-300'"
                class="p-4 rounded-2xl border text-left transition-all cursor-pointer flex flex-col justify-between group shadow-xs">
            <div class="flex items-center justify-between">
                <span class="font-['Inter'] text-xs font-semibold text-blue-600 uppercase tracking-wider">In Progress</span>
                <span class="w-8 h-8 rounded-xl bg-blue-50 group-hover:bg-blue-100 flex items-center justify-center transition-colors">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#0878f9" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="font-['Inter'] text-2xl sm:text-3xl font-bold text-[#0878f9]">@inProgressCount</span>
                <span class="text-[11px] text-blue-600/70 font-medium">on site / active</span>
            </div>
        </button>

        <!-- Scheduled Card -->
        <button type="button" @@click="currentTab = 'Scheduled'" 
                :class="currentTab === 'Scheduled' ? 'ring-2 ring-amber-500 border-amber-500 bg-amber-50/30' : 'border-[#e7eaf0] bg-white hover:border-gray-300'"
                class="p-4 rounded-2xl border text-left transition-all cursor-pointer flex flex-col justify-between group shadow-xs">
            <div class="flex items-center justify-between">
                <span class="font-['Inter'] text-xs font-semibold text-amber-600 uppercase tracking-wider">Scheduled</span>
                <span class="w-8 h-8 rounded-xl bg-amber-50 group-hover:bg-amber-100 flex items-center justify-center transition-colors">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="font-['Inter'] text-2xl sm:text-3xl font-bold text-amber-600">@pendingCount</span>
                <span class="text-[11px] text-amber-600/70 font-medium">ready to start</span>
            </div>
        </button>

        <!-- Completed Card -->
        <button type="button" @@click="currentTab = 'Completed'" 
                :class="currentTab === 'Completed' ? 'ring-2 ring-emerald-500 border-emerald-500 bg-emerald-50/30' : 'border-[#e7eaf0] bg-white hover:border-gray-300'"
                class="p-4 rounded-2xl border text-left transition-all cursor-pointer flex flex-col justify-between group shadow-xs">
            <div class="flex items-center justify-between">
                <span class="font-['Inter'] text-xs font-semibold text-emerald-600 uppercase tracking-wider">Completed</span>
                <span class="w-8 h-8 rounded-xl bg-emerald-50 group-hover:bg-emerald-100 flex items-center justify-center transition-colors">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="font-['Inter'] text-2xl sm:text-3xl font-bold text-emerald-600">@completedCount</span>
                <span class="text-[11px] text-emerald-600/70 font-medium">resolved</span>
            </div>
        </button>
    </div>

    <!-- Filter Bar & Search -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 w-full bg-white p-2.5 rounded-2xl border border-[#e7eaf0] shadow-xs">
        <!-- Interactive Tabs -->
        <div class="flex items-center gap-1 overflow-x-auto p-1 bg-gray-50/80 rounded-xl">
            <button type="button" @@click="currentTab = 'All'" 
                    :class="currentTab === 'All' ? 'bg-white text-[#17191c] shadow-xs font-semibold' : 'text-[#5d6470] hover:text-[#17191c] font-medium'"
                    class="px-3.5 py-1.5 rounded-lg text-xs font-['Inter'] transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer">
                <span>All Jobs</span>
                <span class="px-1.5 py-0.2 rounded-full text-[10px]" :class="currentTab === 'All' ? 'bg-blue-100 text-blue-700' : 'bg-gray-200 text-gray-600'">@totalAll</span>
            </button>

            <button type="button" @@click="currentTab = 'In Progress'" 
                    :class="currentTab === 'In Progress' ? 'bg-white text-blue-700 shadow-xs font-semibold' : 'text-[#5d6470] hover:text-[#17191c] font-medium'"
                    class="px-3.5 py-1.5 rounded-lg text-xs font-['Inter'] transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                <span>In Progress</span>
                <span class="px-1.5 py-0.2 rounded-full text-[10px]" :class="currentTab === 'In Progress' ? 'bg-blue-100 text-blue-700' : 'bg-gray-200 text-gray-600'">@inProgressCount</span>
            </button>

            <button type="button" @@click="currentTab = 'Scheduled'" 
                    :class="currentTab === 'Scheduled' ? 'bg-white text-amber-700 shadow-xs font-semibold' : 'text-[#5d6470] hover:text-[#17191c] font-medium'"
                    class="px-3.5 py-1.5 rounded-lg text-xs font-['Inter'] transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                <span>Scheduled</span>
                <span class="px-1.5 py-0.2 rounded-full text-[10px]" :class="currentTab === 'Scheduled' ? 'bg-amber-100 text-amber-700' : 'bg-gray-200 text-gray-600'">@pendingCount</span>
            </button>

            <button type="button" @@click="currentTab = 'Completed'" 
                    :class="currentTab === 'Completed' ? 'bg-white text-emerald-700 shadow-xs font-semibold' : 'text-[#5d6470] hover:text-[#17191c] font-medium'"
                    class="px-3.5 py-1.5 rounded-lg text-xs font-['Inter'] transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>Completed</span>
                <span class="px-1.5 py-0.2 rounded-full text-[10px]" :class="currentTab === 'Completed' ? 'bg-emerald-100 text-emerald-700' : 'bg-gray-200 text-gray-600'">@completedCount</span>
            </button>

            @if (archivedCustomerCount > 0)
            {
                <button type="button" @@click="currentTab = 'Locked'"
                        :class="currentTab === 'Locked' ? 'bg-white text-slate-700 shadow-xs font-semibold' : 'text-[#5d6470] hover:text-[#17191c] font-medium'"
                        class="px-3.5 py-1.5 rounded-lg text-xs font-['Inter'] transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                    <span>Locked records</span>
                    <span class="px-1.5 py-0.2 rounded-full text-[10px]" :class="currentTab === 'Locked' ? 'bg-slate-100 text-slate-700' : 'bg-gray-200 text-gray-600'">@archivedCustomerCount</span>
                </button>
            }
        </div>

        <!-- Search Input -->
        <div class="flex w-full items-center gap-2 sm:w-auto">
            <label class="sr-only" for="technician-job-sort">Sort jobs by</label>
            <select id="technician-job-sort" x-model="sortKey" class="ui-select !w-[130px] text-xs">
                <option value="date">Schedule</option>
                <option value="jobCode">Job ID</option>
                <option value="customer">Customer</option>
                <option value="prio">Priority</option>
                <option value="status">Status</option>
            </select>
            <button type="button" @@click="sortDirection = sortDirection === 'asc' ? 'desc' : 'asc'" class="flex h-9 shrink-0 items-center gap-1.5 rounded-xl bg-gray-100 px-3 text-xs font-semibold text-[#5d6470] transition hover:bg-gray-200" :aria-label="sortDirection === 'asc' ? 'Sort descending' : 'Sort ascending'">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M6 12h12M10 18h4"/></svg>
                <span x-text="sortDirection === 'asc' ? 'Ascending' : 'Descending'"></span>
            </button>
            <div class="relative min-w-0 flex-1 sm:w-64 sm:flex-none">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8a929e" stroke-width="2" class="absolute left-3 top-1/2 -translate-y-1/2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="text" x-model="searchQuery" placeholder="Search customer, issue, ID…" class="w-full pl-9 pr-8 py-1.5 bg-gray-50/70 border border-[#e7eaf0] rounded-xl text-xs font-['Inter'] text-[#17191c] placeholder:text-[#8a929e] outline-none focus:bg-white focus:border-[#0878f9] transition-all" />
                <button type="button" x-show="searchQuery" @@click="searchQuery = ''" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
            </div>
        </div>
    </div>

    @if (archivedCustomerCount > 0)
    {
        <div class="flex w-full items-start gap-3 rounded-2xl bg-slate-100/80 px-4 py-3 text-slate-700 ring-1 ring-inset ring-slate-200">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-white text-slate-600 shadow-sm"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>
            <div><p class="text-xs font-bold">@archivedCustomerCount locked assignment record@(archivedCustomerCount == 1 ? "" : "s")</p><p class="mt-0.5 text-[11px] leading-5 text-slate-500">The customer account is archived. The record stays visible for context, but progress, quotations, uploads, and messages are disabled until an admin restores the account.</p></div>
        </div>
    }

    <!-- Jobs Table / Card List -->
    <div class="bg-white border border-[#e7eaf0] rounded-2xl overflow-hidden w-full shadow-xs">
        
        <!-- Table Header (Desktop) -->
        <div class="hidden md:grid grid-cols-[110px_minmax(200px,1.2fr)_minmax(150px,1fr)_130px_90px_120px_90px] gap-4 px-5 py-3 bg-[#f8fafc] border-b border-[#e7eaf0] text-[11px] font-['Inter'] font-semibold text-[#8a929e] uppercase tracking-wider">
            <span>Job ID</span>
            <span>Customer &amp; Issue</span>
            <span>Scheduled</span>
            <span>Address / Location</span>
            <span>Priority</span>
            <span>Progress Status</span>
            <span class="text-right">Action</span>
        </div>

        <div class="divide-y divide-[#f0f2f5]">
            <template x-for="job in filteredJobs" :key="job.id">
                <div class="group transition-colors"
                     :class="job.customerArchived ? 'cursor-not-allowed bg-slate-50/80 opacity-80' : 'cursor-pointer hover:bg-blue-50/30'"
                     @@click="if (!job.customerArchived) openJobDrawer(job)">
                    
                    <!-- Desktop Row -->
                    <div class="hidden md:grid grid-cols-[110px_minmax(200px,1.2fr)_minmax(150px,1fr)_130px_90px_120px_90px] gap-4 items-center px-5 py-4">
                        
                        <!-- Job Code -->
                        <div>
                            <span class="font-['JetBrains_Mono'] font-semibold text-xs text-[#0878f9] bg-blue-50 border border-blue-100 px-2 py-0.5 rounded-md inline-block">
                                <span x-text="job.jobCode"></span>
                            </span>
                        </div>

                        <!-- Customer & Issue -->
                        <div class="flex items-start gap-3 min-w-0">
                            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-2xs">
                                <span x-text="(job.customer || 'C').charAt(0).toUpperCase()"></span>
                            </div>
                            <div class="flex flex-col min-w-0">
                                <div class="flex items-center gap-1.5">
                                    <span class="font-['Inter'] font-semibold text-sm text-[#17191c] truncate" x-text="job.customer"></span>
                                    <span class="text-[11px] text-[#8a929e] bg-gray-100 px-1.5 py-0.2 rounded font-medium shrink-0" x-text="job.cat"></span>
                                    <template x-if="job.customerArchived"><span class="inline-flex shrink-0 items-center gap-1 rounded-md bg-slate-200 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-slate-700"><svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>Customer archived</span></template>
                                </div>
                                <p class="font-['Inter'] text-xs text-[#5d6470] line-clamp-1 mt-0.5" x-text="job.desc"></p>
                            </div>
                        </div>

                        <!-- Scheduled -->
                        <div class="flex flex-col">
                            <span class="font-['Inter'] text-xs font-medium text-[#17191c]" x-text="job.date"></span>
                        </div>

                        <!-- Address -->
                        <div class="flex items-center gap-1.5 text-xs text-[#5d6470] min-w-0">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#8a929e" stroke-width="2" class="shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            <span class="truncate" x-text="job.address" :title="job.address"></span>
                        </div>

                        <!-- Priority -->
                        <div>
                            <template x-if="job.prio === 'Urgent'">
                                <span class="bg-red-50 text-red-700 border border-red-100 font-['Inter'] font-semibold text-[11px] px-2 py-0.5 rounded-full inline-flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Urgent
                                </span>
                            </template>
                            <template x-if="job.prio === 'Low'">
                                <span class="bg-gray-100 text-gray-600 font-['Inter'] font-medium text-[11px] px-2 py-0.5 rounded-full inline-flex items-center gap-1">
                                    Low
                                </span>
                            </template>
                            <template x-if="job.prio !== 'Urgent' && job.prio !== 'Low'">
                                <span class="bg-blue-50 text-blue-700 border border-blue-100 font-['Inter'] font-medium text-[11px] px-2 py-0.5 rounded-full inline-flex items-center gap-1">
                                    Normal
                                </span>
                            </template>
                        </div>

                        <!-- Status Badge -->
                        <div>
                            <template x-if="job.customerArchived">
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-700">
                                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                                    Locked
                                </span>
                            </template>
                            <template x-if="!job.customerArchived && job.isCompleted">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                                    Completed
                                </span>
                            </template>
                            <template x-if="!job.customerArchived && job.isInProgress">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                                    <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
                                    In Progress
                                </span>
                            </template>
                            <template x-if="!job.customerArchived && !job.isCompleted && !job.isInProgress">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                    <span x-text="job.status === 'Pending' ? 'Scheduled' : job.status === 'PendingAdminApproval' ? 'Pending' : job.status"></span>
                                </span>
                            </template>
                        </div>

                        <!-- Action Link -->
                        <div class="text-right">
                            <template x-if="job.customerArchived"><span class="inline-flex items-center gap-1 text-[10px] font-semibold text-slate-500"><svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>Unavailable</span></template>
                            <template x-if="!job.customerArchived"><span class="text-xs font-['Inter'] font-semibold text-[#0878f9] group-hover:underline inline-flex items-center gap-1">Details →</span></template>
                        </div>
                    </div>

                    <!-- Mobile Card View -->
                    <div class="md:hidden p-4 flex flex-col gap-3">
                        <div class="flex items-center justify-between">
                            <span class="font-['JetBrains_Mono'] font-semibold text-xs text-[#0878f9] bg-blue-50 px-2 py-0.5 rounded">
                                <span x-text="job.jobCode"></span>
                            </span>
                            <template x-if="job.customerArchived">
                                <span class="inline-flex items-center gap-1 rounded-full bg-slate-200 px-2 py-0.5 text-[11px] font-semibold text-slate-700"><svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg> Customer archived</span>
                            </template>
                            <template x-if="!job.customerArchived && job.isCompleted">
                                <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100 inline-flex items-center gap-1">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg> Completed
                                </span>
                            </template>
                            <template x-if="!job.customerArchived && job.isInProgress">
                                <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-200 inline-flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span> In Progress
                                </span>
                            </template>
                            <template x-if="!job.customerArchived && !job.isCompleted && !job.isInProgress">
                                <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200 inline-flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Scheduled
                                </span>
                            </template>
                        </div>

                        <div>
                            <div class="flex items-center justify-between">
                                <span class="font-['Inter'] font-semibold text-sm text-[#17191c]" x-text="job.customer"></span>
                                <span class="text-[11px] text-[#8a929e] bg-gray-100 px-1.5 py-0.5 rounded font-medium" x-text="job.cat"></span>
                            </div>
                            <p class="font-['Inter'] text-xs text-[#5d6470] mt-1" x-text="job.desc"></p>
                        </div>

                        <div class="flex items-center justify-between text-xs text-[#8a929e] pt-1 border-t border-gray-100">
                            <span class="inline-flex items-center gap-1"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg><span x-text="job.date"></span></span>
                            <span class="font-medium" :class="job.customerArchived ? 'text-slate-500' : 'text-[#0878f9]'" x-text="job.customerArchived ? 'Locked record' : 'View Progress Details →'"></span>
                        </div>
                    </div>
                </div>
            </template>
        </div>

        <div x-show="filteredJobs.length === 0">
            <div class="p-12 text-center flex flex-col items-center justify-center gap-3">
                <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center text-gray-400">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
                </div>
                <p class="font-['Inter'] font-semibold text-base text-[#17191c]">No jobs found</p>
                <p class="font-['Inter'] text-xs text-[#8a929e] max-w-sm">No jobs match your current filter or search query. Try adjusting your criteria.</p>
            </div>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- MASTER UI/UX JOB DETAILS & PROGRESS DRAWER -->
    <!-- ======================================================== -->
    <div x-show="drawerOpen"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs"
         style="display:none;"
         @@click.self="drawerOpen = false">

        <div x-show="drawerOpen"
             x-transition:enter="transition ease-out duration-300 transform"
             x-transition:enter-start="translate-x-full"
             x-transition:enter-end="translate-x-0"
             x-transition:leave="transition ease-in duration-200 transform"
             x-transition:leave-start="translate-x-0"
             x-transition:leave-end="translate-x-full"
             class="absolute right-0 top-0 h-full min-h-0 w-full max-w-[520px] bg-white shadow-2xl flex flex-col overflow-hidden">

            <!-- Drawer Header -->
            <div class="shrink-0 px-5 sm:px-6 pt-5 pb-0 border-b border-[#e7eaf0] bg-white z-20 flex flex-col gap-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="w-9 h-9 rounded-xl bg-blue-50 text-[#0878f9] flex items-center justify-center font-['JetBrains_Mono'] font-bold text-xs border border-blue-100">
                            #
                        </span>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-['JetBrains_Mono'] text-xs text-[#0878f9] font-semibold" x-text="drawerJob?.jobCode"></span>
                                <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full"
                                      :class="{
                                          'bg-emerald-50 text-emerald-700 border border-emerald-200': drawerJob?.status === 'Completed',
                                          'bg-blue-50 text-blue-700 border border-blue-200': drawerJob?.status === 'In Progress' || drawerJob?.status === 'Diagnosing',
                                          'bg-amber-50 text-amber-700 border border-amber-200': drawerJob?.status === 'Pending' || drawerJob?.status?.includes('Pending')
                                      }" x-text="!drawerJob ? '' : (drawerJob.status === 'Pending' ? 'Scheduled' : drawerJob.status === 'PendingAdminApproval' ? 'Pending' : drawerJob.status.replace(/([A-Z])/g, ' $1').trim())">
                                </span>
                            </div>
                            <h3 class="font-['Inter'] font-bold text-[#17191c] text-lg mt-0.5">Service Job Overview</h3>
                        </div>
                    </div>
                    <button type="button" @@click="drawerOpen = false" class="w-8 h-8 rounded-full hover:bg-gray-100 text-[#8a929e] hover:text-[#17191c] flex items-center justify-center transition-colors">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    </button>
                </div>
                <!-- Tabs Navigation -->
                <div class="flex items-center gap-5 sm:gap-6 border-t border-gray-100 pt-3 mt-1 overflow-x-auto overscroll-x-contain">
                    <button type="button" @@click="drawerTab = 'details'" :class="drawerTab === 'details' ? 'border-b-2 border-[#0878f9] text-[#0878f9] font-bold' : 'border-b-2 border-transparent text-[#8a929e] hover:text-[#17191c] font-medium'" class="shrink-0 pb-3 text-sm font-['Inter'] transition-colors whitespace-nowrap">Details &amp; Progress</button>
                    <button type="button" @@click="drawerTab = 'workflow'" :class="drawerTab === 'workflow' ? 'border-b-2 border-[#0878f9] text-[#0878f9] font-bold' : 'border-b-2 border-transparent text-[#8a929e] hover:text-[#17191c] font-medium'" class="shrink-0 pb-3 text-sm font-['Inter'] transition-colors whitespace-nowrap">Job Workflow</button>
                    <button type="button" @@click="openMessages()" :class="drawerTab === 'chat' ? 'border-b-2 border-[#0878f9] text-[#0878f9] font-bold' : 'border-b-2 border-transparent text-[#8a929e] hover:text-[#17191c] font-medium'" class="shrink-0 pb-3 text-sm font-['Inter'] transition-colors flex items-center gap-1.5 whitespace-nowrap">
                        Messages
                        <span class="min-w-4 h-4 px-1 rounded-full bg-red-500 text-white text-[10px] flex items-center justify-center font-bold" x-show="unreadMessageCount > 0" x-text="unreadMessageCount"></span>
                    </button>
                </div>
            </div>

            <!-- Drawer Body: Details Tab -->
            <div class="flex-1 min-h-0 overflow-y-auto overscroll-contain p-5 sm:p-6 flex flex-col gap-6" x-show="drawerJob && drawerTab === 'details'">

                <!-- 1. PROGRESS LIFECYCLE TRACKER (VISUAL STEPPER) -->
                <div class="bg-gradient-to-br from-gray-50 to-blue-50/30 border border-[#e7eaf0] rounded-2xl p-5 shadow-xs">
                    <div class="flex items-center justify-between mb-4">
                        <span class="font-['Inter'] font-bold text-xs text-[#17191c] uppercase tracking-wider flex items-center gap-1.5">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0878f9" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                            Job Lifecycle Progress
                        </span>
                        <span class="text-xs font-semibold font-['Inter']"
                              :class="drawerJob?.status === 'Completed' ? 'text-emerald-600' : (drawerJob?.status === 'In Progress' ? 'text-blue-600' : 'text-amber-600')">
                            <span x-show="drawerJob?.status === 'Pending'">Step 1 of 3: Awaiting Start</span>
                            <span x-show="drawerJob?.status === 'In Progress'">Step 2 of 3: Active On Site</span>
                            <span x-show="drawerJob?.status === 'Completed'">Step 3 of 3: 100% Completed</span>
                        </span>
                    </div>

                    <!-- Visual Timeline Steps -->
                    <div class="grid grid-cols-3 gap-2 relative">
                        
                        <!-- Step 1: Booked & Scheduled -->
                        <div class="flex flex-col items-center text-center relative z-10">
                            <div class="w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-xs shadow-xs mb-1.5">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                            </div>
                            <span class="font-['Inter'] text-[11px] font-semibold text-[#17191c]">Scheduled</span>
                            <span class="font-['Inter'] text-[10px] text-[#8a929e]">Assigned to You</span>
                        </div>

                        <!-- Step 2: In Progress -->
                        <div class="flex flex-col items-center text-center relative z-10">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs shadow-xs mb-1.5 transition-colors"
                                 :class="drawerJob?.status === 'Completed' ? 'bg-emerald-500 text-white' : (drawerJob?.status === 'In Progress' ? 'bg-blue-600 text-white ring-4 ring-blue-100 animate-pulse' : 'bg-gray-200 text-gray-500')">
                                <template x-if="drawerJob?.status === 'Completed'">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                                </template>
                                <template x-if="drawerJob?.status === 'In Progress'">
                                    <span>2</span>
                                </template>
                                <template x-if="drawerJob?.status === 'Pending'">
                                    <span>2</span>
                                </template>
                            </div>
                            <span class="font-['Inter'] text-[11px] font-semibold" :class="drawerJob?.status !== 'Pending' ? 'text-[#17191c]' : 'text-gray-400'">In Progress</span>
                            <span class="font-['Inter'] text-[10px] text-[#8a929e]" x-text="drawerJob?.status === 'In Progress' ? 'Active Right Now' : (drawerJob?.status === 'Completed' ? 'Worked On' : 'Pending Start')"></span>
                        </div>

                        <!-- Step 3: Completed -->
                        <div class="flex flex-col items-center text-center relative z-10">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs shadow-xs mb-1.5 transition-colors"
                                 :class="drawerJob?.status === 'Completed' ? 'bg-emerald-500 text-white ring-4 ring-emerald-100' : 'bg-gray-200 text-gray-500'">
                                <template x-if="drawerJob?.status === 'Completed'">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                                </template>
                                <template x-if="drawerJob?.status !== 'Completed'">
                                    <span>3</span>
                                </template>
                            </div>
                            <span class="font-['Inter'] text-[11px] font-semibold" :class="drawerJob?.status === 'Completed' ? 'text-emerald-700' : 'text-gray-400'">Completed</span>
                            <span class="font-['Inter'] text-[10px] text-[#8a929e]" x-text="drawerJob?.status === 'Completed' ? 'Resolved & Verified' : 'Final Step'"></span>
                        </div>
                    </div>
                   </div>

                <!-- 3. CUSTOMER CONTACT & LOCATION CARD -->
                <div class="bg-gray-50/80 border border-[#e7eaf0] rounded-2xl p-5 flex flex-col gap-3.5 shadow-2xs">
                    <div class="flex items-center justify-between">
                        <span class="font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Customer Information</span>
                        <span class="text-[11px] text-[#0878f9] font-medium bg-blue-50 px-2 py-0.5 rounded">Verified Client</span>
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-500 text-white font-bold text-base flex items-center justify-center shrink-0 shadow-xs">
                            <span x-text="drawerJob?.customer ? drawerJob.customer.charAt(0).toUpperCase() : 'C'"></span>
                        </div>
                        <div class="flex flex-col min-w-0 flex-1">
                            <h4 class="font-['Inter'] font-bold text-base text-[#17191c] truncate" x-text="drawerJob?.customer"></h4>
                            <span class="font-['Inter'] text-xs text-[#5d6470]" x-text="drawerJob?.phone || 'No phone number on file'"></span>
                        </div>
                    </div>

                    <!-- Action Buttons: Call & Maps -->
                    <div class="grid grid-cols-2 gap-2 pt-1">
                        <a :href="'tel:' + drawerJob?.phone" 
                           :class="drawerJob?.phone ? 'bg-white hover:bg-gray-50 border-[#e7eaf0] text-[#17191c]' : 'bg-gray-100 text-gray-400 pointer-events-none border-transparent'"
                           class="flex items-center justify-center gap-2 py-2 px-3 border rounded-xl font-['Inter'] font-semibold text-xs transition-colors shadow-2xs">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                            Call Customer
                        </a>

                        <a :href="'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(drawerJob?.address || '')" 
                           target="_blank"
                           class="flex items-center justify-center gap-2 py-2 px-3 bg-white hover:bg-gray-50 border border-[#e7eaf0] text-[#0878f9] rounded-xl font-['Inter'] font-semibold text-xs transition-colors shadow-2xs">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                            Open in Maps
                        </a>
                    </div>

                    <!-- Address box -->
                    <div class="bg-white p-3 rounded-xl border border-[#e7eaf0] flex items-start gap-2">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8a929e" stroke-width="2" class="shrink-0 mt-0.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        <span class="font-['Inter'] text-xs text-[#5d6470] leading-relaxed" x-text="drawerJob?.address"></span>
                    </div>
                </div>

                <!-- 4. ISSUE DETAILS & SPECIFICATIONS -->
                <div class="bg-white border border-[#e7eaf0] rounded-2xl p-5 flex flex-col gap-4 shadow-2xs">
                    <span class="font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Problem Description</span>

                    <div class="p-4 bg-gray-50 rounded-xl border-l-4 border-[#0878f9]">
                        <p class="font-['Inter'] text-sm text-[#17191c] leading-relaxed font-medium" x-text="drawerJob?.desc"></p>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="p-3 bg-gray-50 rounded-xl">
                            <span class="text-[10px] font-semibold text-[#8a929e] uppercase font-['Inter'] block">Category</span>
                            <span class="font-['Inter'] font-semibold text-xs text-[#17191c] mt-0.5 block" x-text="drawerJob?.cat"></span>
                        </div>

                        <div class="p-3 bg-gray-50 rounded-xl">
                            <span class="text-[10px] font-semibold text-[#8a929e] uppercase font-['Inter'] block">Priority Level</span>
                            <span class="font-['Inter'] font-bold text-xs mt-0.5 block"
                                  :class="{
                                      'text-red-600': drawerJob?.prio === 'Urgent',
                                      'text-blue-600': drawerJob?.prio === 'Normal',
                                      'text-gray-600': drawerJob?.prio === 'Low'
                                  }" x-text="drawerJob?.prio"></span>
                        </div>

                        <div class="p-3 bg-gray-50 rounded-xl col-span-2">
                            <span class="text-[10px] font-semibold text-[#8a929e] uppercase font-['Inter'] block">Scheduled Appointment</span>
                            <span class="font-['Inter'] font-semibold text-xs text-[#17191c] mt-0.5 block" x-text="drawerJob?.date"></span>
                        </div>
                    </div>
                </div>

                <!-- 5. ATTACHED PHOTO PREVIEW -->
                <div class="bg-white border border-[#e7eaf0] rounded-2xl p-5 flex flex-col gap-3 shadow-2xs">
                    <span class="font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Customer Photo Evidence</span>
                    
                    <template x-if="drawerJob?.image">
                        <div class="relative group rounded-xl overflow-hidden border border-[#e7eaf0] cursor-pointer" @@click="openPhoto(drawerJob.image)">
                            <img :src="drawerJob.image" alt="Customer evidence" class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" />
                            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-semibold gap-1.5">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                                Click to Expand
                            </div>
                        </div>
                    </template>

                    <template x-if="!drawerJob?.image">
                        <div class="p-6 bg-gray-50 rounded-xl flex flex-col items-center justify-center text-center gap-1.5 text-[#8a929e]">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                            <span class="text-xs font-medium">No photo uploaded by customer</span>
                        </div>
                    </template>
                </div>

            </div>

        <!-- Drawer Body: Chat Tab -->
        <div class="flex-1 min-h-0 overflow-hidden bg-gray-50 flex flex-col" x-show="drawerJob && drawerTab === 'chat'" style="display:none;">
            <div class="flex-1 min-h-0 overflow-y-auto overscroll-contain p-4 flex flex-col gap-3" id="chat-messages">
                <template x-for="msg in messages" :key="msg.messageID">
                    <div class="flex flex-col max-w-[85%]" :class="msg.senderId === '@_userManager.GetUserId(User)' ? 'self-end items-end' : 'self-start items-start'">
                        <span class="text-[10px] text-gray-500 mb-1" x-text="msg.senderName"></span>
                        <div class="px-4 py-2.5 rounded-2xl shadow-sm text-sm font-['Inter']"
                             :class="msg.senderId === '@_userManager.GetUserId(User)' ? 'bg-blue-600 text-white rounded-tr-sm' : 'bg-white border border-gray-200 text-gray-800 rounded-tl-sm'">
                            <span x-text="msg.content"></span>
                        </div>
                        <span class="text-[9px] text-gray-400 mt-1 flex items-center gap-1">
                            <span x-text="new Date(msg.timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})"></span>
                            <template x-if="msg.senderId === '@_userManager.GetUserId(User)'">
                                <svg x-show="msg.isRead" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#0878f9" stroke-width="3"><polyline points="20 6 9 17 4 12"/><polyline points="20 10 13 17" opacity="0.5"/></svg>
                            </template>
                        </span>
                    </div>
                </template>
                <div x-show="messages.length === 0" class="text-center text-gray-400 text-sm mt-10">No messages yet.</div>
            </div>
            <div class="shrink-0 p-4 bg-white border-t border-gray-200 flex items-center gap-2">
                <input type="text" x-model="newMessage" @@keydown.enter.prevent="sendMessage()" class="flex-1 border border-gray-300 rounded-xl px-4 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Type a message to customer..." />
                <button @@click="sendMessage()" class="w-10 h-10 bg-blue-600 hover:bg-blue-700 text-white rounded-xl flex items-center justify-center shrink-0">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                </button>
            </div>
        </div>

        <!-- Drawer Body: Workflow Tab -->
        <div class="flex-1 min-h-0 overflow-y-auto overscroll-contain p-5 sm:p-6 flex flex-col gap-6" x-show="drawerJob && drawerTab === 'workflow'" style="display:none;">

            <!-- Current Stage Card -->
            <div class="bg-gradient-to-br from-gray-50 to-blue-50/30 border border-[#e7eaf0] rounded-2xl p-5 shadow-xs">
                <div class="flex items-center justify-between mb-3">
                    <span class="font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider flex items-center gap-1.5">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0878f9" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        Current Stage
                    </span>
                    <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full font-['Inter']"
                          :class="drawerJob?.status === 'Completed' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : drawerJob?.status === 'In Progress' ? 'bg-blue-50 text-[#0878f9] border border-blue-200' : 'bg-amber-50 text-amber-700 border border-amber-200'"
                          x-text="drawerJob?.status === 'Completed' ? 'Completed' : drawerJob?.status === 'In Progress' ? 'In Progress' : drawerJob?.status === 'PendingAdminApproval' ? 'Pending Review' : drawerJob?.status === 'PendingCustomerReview' ? 'Customer Review' : 'Action Needed'"></span>
                </div>
                <h4 class="font-['Inter'] font-bold text-base text-[#17191c]"
                    x-text="drawerJob?.status === 'Completed' ? 'Service Completed' : drawerJob?.status === 'PendingAdminApproval' ? 'Quotation in Review' : drawerJob?.status === 'Pending' ? 'Pre-Service Verification' : drawerJob?.status === 'PendingCustomerReview' ? 'Waiting for Customer Review' : drawerJob?.status === 'In Progress' ? 'Execute & Verify Repair' : 'Diagnosis & Quotation'"></h4>
                <p class="mt-1 text-xs leading-relaxed text-[#5d6470] font-['Inter']"
                   x-text="drawerJob?.status === 'Completed' ? 'All required repair work has been submitted, verified, and signed off.' : drawerJob?.status === 'Pending' ? 'Customer payment confirmed. Verify problem details and bench readiness to unlock checklist.' : drawerJob?.status === 'In Progress' ? 'Complete each quality checklist item below before submitting final resolution proof.' : 'Inspect the device, assess parts, and submit your recommendation.'"></p>
            </div>

            <!-- Workflow Stepper -->
            <div class="bg-white border border-[#e7eaf0] rounded-2xl p-4 shadow-2xs">
                <div class="grid grid-cols-4 gap-2" aria-label="Job workflow progress">
                    <template x-for="(step, index) in [
                        { name: 'Diagnose', icon: 'search' },
                        { name: 'Approve', icon: 'check' },
                        { name: 'Execute', icon: 'tool' },
                        { name: 'Handover', icon: 'flag' }
                    ]" :key="step.name">
                        <div class="flex flex-col items-center text-center">
                            <div class="w-full h-1.5 rounded-full mb-2 transition-all duration-300"
                                 :class="index <= (drawerJob?.status === 'Completed' ? 3 : drawerJob?.status === 'PendingCustomerReview' ? 3 : drawerJob?.status === 'In Progress' ? 2 : drawerJob?.status === 'Pending' ? 2 : drawerJob?.status === 'PendingAdminApproval' ? 1 : 0) ? 'bg-[#0878f9]' : 'bg-gray-200'"></div>
                            <span class="font-['Inter'] text-[11px] font-semibold transition-colors"
                                  :class="index <= (drawerJob?.status === 'Completed' ? 3 : drawerJob?.status === 'PendingCustomerReview' ? 3 : drawerJob?.status === 'In Progress' ? 2 : drawerJob?.status === 'Pending' ? 2 : drawerJob?.status === 'PendingAdminApproval' ? 1 : 0) ? 'text-[#17191c]' : 'text-[#8a929e]'"
                                  x-text="step.name"></span>
                        </div>
                    </template>
                </div>
            </div>
            
            <!-- Pre-Service Verification (Pending status) -->
            <div class="bg-white border border-[#e7eaf0] rounded-2xl p-5 shadow-2xs" x-show="drawerJob?.status === 'Pending'">
                <div class="flex items-center justify-between mb-4">
                    <span class="font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider flex items-center gap-1.5">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0878f9" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        Pre-Service Verification
                    </span>
                    <span class="text-[11px] text-[#0878f9] font-medium bg-blue-50 px-2 py-0.5 rounded font-['Inter']">2 Items Required</span>
                </div>
                <p class="text-xs text-[#5d6470] font-['Inter'] leading-relaxed mb-4">Payment confirmed. Verify reported details and device readiness before proceeding to the repair checklist.</p>

                <div class="flex flex-col gap-3 bg-gray-50 p-4 rounded-xl border border-[#e7eaf0]">
                    <label class="flex items-start gap-3 cursor-pointer group p-3 bg-white rounded-xl border border-[#e7eaf0] hover:border-[#0878f9]/40 transition-colors">
                        <input type="checkbox" x-model="preCheck1" class="mt-0.5 w-4 h-4 text-[#0878f9] rounded border-gray-300 focus:ring-[#0878f9] transition-colors cursor-pointer" />
                        <div>
                            <span class="block text-sm font-semibold text-[#17191c] group-hover:text-[#0878f9] transition-colors font-['Inter']">I have reviewed the problem description and customer images</span>
                            <span class="block text-[11px] text-[#8a929e] mt-0.5 leading-relaxed font-['Inter']">Ensure you understand the reported issue and required scope before starting.</span>
                        </div>
                    </label>

                    <label class="flex items-start gap-3 cursor-pointer group p-3 bg-white rounded-xl border border-[#e7eaf0] hover:border-[#0878f9]/40 transition-colors">
                        <input type="checkbox" x-model="preCheck2" class="mt-0.5 w-4 h-4 text-[#0878f9] rounded border-gray-300 focus:ring-[#0878f9] transition-colors cursor-pointer" />
                        <div>
                            <span class="block text-sm font-semibold text-[#17191c] group-hover:text-[#0878f9] transition-colors font-['Inter']">Device is on bench &amp; ready for repair / parts verified</span>
                            <span class="block text-[11px] text-[#8a929e] mt-0.5 leading-relaxed font-['Inter']">Confirm physical device is present and all quoted inventory parts are on hand.</span>
                        </div>
                    </label>

                    <form method="post" asp-action="UpdateStatus" asp-controller="AssignedJobs" asp-area="Technician" class="mt-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="requestId" :value="drawerJob?.id" />
                        <input type="hidden" name="status" value="In Progress" />
                        <button type="submit" :disabled="!preCheck1 || !preCheck2" 
                                class="w-full bg-[#0878f9] hover:bg-blue-700 disabled:bg-gray-200 disabled:text-[#8a929e] disabled:cursor-not-allowed text-white font-semibold text-sm py-2.5 rounded-xl transition-all flex items-center justify-center gap-2 font-['Inter'] cursor-pointer shadow-xs">
                            Start Repair &amp; Proceed to Checklist
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        </button>
                    </form>
                </div>
            </div>
            
            <!-- Diagnosis & Quotation (Diagnosing status) -->
            <div class="bg-white border border-[#e7eaf0] rounded-2xl p-5 shadow-2xs" x-show="drawerJob?.status === 'Diagnosing'">
                <div class="flex items-center justify-between mb-4">
                    <span class="font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider flex items-center gap-1.5">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0878f9" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        Diagnosis &amp; Quotation
                    </span>
                    <span class="text-[11px] text-[#0878f9] font-medium bg-blue-50 px-2 py-0.5 rounded font-['Inter']">Phase 1</span>
                </div>
                <p class="text-xs text-[#5d6470] font-['Inter'] leading-relaxed mb-4">Inspect the device, then submit the recommended parts, labor, and completion date for admin review.</p>
                
                <form method="post" asp-action="ProposeQuotation" asp-controller="AssignedJobs" asp-area="Technician" class="flex flex-col gap-3 bg-gray-50 p-4 rounded-xl border border-[#e7eaf0]">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="requestId" :value="drawerJob?.id" />
                    
                    <div>
                        <div class="flex items-center justify-between mb-2"><div><label class="text-xs font-bold text-[#17191c] font-['Inter']">Parts from inventory</label><p class="text-[11px] text-[#8a929e] mt-0.5 font-['Inter']">Only available stock can be quoted.</p></div><button type="button" @@click="addQuoteLine()" class="text-xs font-semibold text-[#0878f9] hover:text-blue-800 font-['Inter']">+ Add part</button></div>
                        <div class="flex flex-col gap-2">
                            <template x-for="(line, index) in quoteLines" :key="index">
                                <div class="grid grid-cols-[minmax(0,1fr)_72px_28px] gap-2 items-center">
                                    <select name="itemIds" x-model="line.itemId" required class="ui-select min-w-0 text-xs">
                                        <option value="">Select an in-stock item</option>
                                        <template x-for="item in inventory" :key="item.id"><option :value="item.id" x-text="`${item.name} · ${item.stock} available · ₱${item.price.toLocaleString()}`"></option></template>
                                    </select>
                                    <input name="quantities" type="number" min="1" :max="inventoryItem(line.itemId)?.stock || 1" x-model.number="line.quantity" required class="w-full border rounded-lg px-2 py-2 text-xs" aria-label="Quantity" />
                                    <button type="button" @@click="removeQuoteLine(index)" :disabled="quoteLines.length === 1" class="w-7 h-7 rounded-md text-gray-400 hover:bg-red-50 hover:text-red-600 disabled:opacity-30">×</button>
                                </div>
                            </template>
                        </div>
                        <div x-show="inventory.length === 0" class="mt-2 rounded-lg bg-amber-50 p-3 text-xs text-amber-800 font-['Inter']">No inventory is currently available. Ask the admin to replenish stock.</div>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div><label class="text-xs font-semibold text-[#17191c] block mb-1 font-['Inter']">Labor (₱)</label><input type="number" min="0" step="0.01" name="laborAmount" x-model.number="laborAmount" required class="w-full border rounded-lg px-3 py-2 text-sm" /></div>
                        <div class="rounded-xl bg-white border border-[#e7eaf0] p-3"><p class="text-[10px] uppercase font-bold text-[#8a929e] font-['Inter']">Quote total</p><p class="text-base font-bold text-[#17191c] mt-1 font-['Inter']" x-text="`₱${quoteTotal.toLocaleString(undefined, {minimumFractionDigits: 2})}`"></p></div>
                    </div>
                    <div><label class="text-xs font-semibold text-[#17191c] block mb-1 font-['Inter']">Service notes <span class="font-normal text-[#8a929e]">(optional)</span></label><textarea name="serviceNotes" rows="2" class="w-full border rounded-lg px-3 py-2 text-sm font-['Inter']" placeholder="Add diagnosis context only—parts are listed automatically."></textarea></div>
                    <div>
                        <div class="mb-1.5 flex items-center justify-between gap-3">
                            <label for="quotation-deadline" class="block text-xs font-semibold text-[#17191c] font-['Inter']">Estimated completion</label>
                            <span class="text-[10px] font-semibold text-[#8a929e] font-['Inter']">PHT · UTC+8</span>
                        </div>
                        <div class="ui-date-control">
                            <input id="quotation-deadline" type="datetime-local" name="proposedDeadline" required class="ui-date-input" data-picker-label="Completion estimate" data-picker-placeholder="Select estimated completion" aria-describedby="quotation-deadline-hint" />
                            <span class="ui-date-control__icon" aria-hidden="true"><partial name="~/Views/Shared/_AppIcon.cshtml" model='"calendar"' /></span>
                        </div>
                        <p id="quotation-deadline-hint" class="ui-date-hint">Set a realistic handover date for the customer.</p>
                    </div>
                    <button type="submit" class="mt-1 w-full bg-[#0878f9] hover:bg-blue-700 text-white font-semibold text-sm py-2.5 rounded-xl transition-all font-['Inter'] shadow-xs">Submit for Admin Review</button>
                </form>
            </div>

            <!-- Pending Review / Customer Payment -->
            <div class="bg-white border border-[#e7eaf0] rounded-2xl p-5 shadow-2xs" x-show="drawerJob?.status === 'PendingAdminApproval' || (drawerJob?.status === 'Pending' && !drawerJob?.isPaid)">
                <div class="flex items-start gap-3">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-50 text-amber-600 border border-amber-200">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    </span>
                    <div>
                        <h4 class="text-sm font-bold text-[#17191c] font-['Inter']" x-text="drawerJob?.status === 'PendingAdminApproval' ? 'Quotation Under Admin Review' : 'Waiting for Customer Payment'"></h4>
                        <p class="mt-1 text-xs leading-relaxed text-[#5d6470] font-['Inter']" x-text="drawerJob?.status === 'PendingAdminApproval' ? 'Your quotation was submitted. You can continue once the admin approves the final scope and price.' : 'The approved quotation is with the customer. Work can continue when payment is confirmed.'"></p>
                        <button type="button" x-show="drawerJob?.status === 'PendingAdminApproval'" @@click="openQuotationEditor()" class="mt-3 inline-flex items-center gap-1.5 rounded-xl border border-[#e7eaf0] bg-white px-3 py-2 text-xs font-semibold text-[#17191c] shadow-2xs hover:bg-gray-50 transition-colors font-['Inter']">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                            Edit Submitted Quotation
                        </button>
                    </div>
                </div>
            </div>

            <div x-show="editQuoteOpen" style="display:none" class="fixed inset-0 z-[120] flex items-center justify-center bg-black/50 p-4 backdrop-blur-sm" @@click.self="editQuoteOpen = false">
                <div class="w-full max-w-xl max-h-[90vh] overflow-y-auto rounded-2xl bg-white shadow-2xl">
                    <div class="sticky top-0 z-10 flex items-center justify-between border-b bg-white p-5"><div><p class="text-[10px] font-bold uppercase tracking-wider text-[#0878f9] font-['Inter']">Pending admin review</p><h3 class="mt-1 text-lg font-bold font-['Inter'] text-[#17191c]">Edit Quotation</h3></div><button type="button" @@click="editQuoteOpen=false" class="ui-icon-button !h-8 !w-8" aria-label="Close editor"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 6-12 12M6 6l12 12"/></svg></button></div>
                    <form method="post" asp-action="EditQuotation" asp-controller="AssignedJobs" asp-area="Technician" class="p-5 flex flex-col gap-5">
                        @Html.AntiForgeryToken()<input type="hidden" name="invoiceId" :value="editInvoiceId" />
                        <div class="rounded-xl bg-blue-50 p-3 text-xs text-blue-800 font-['Inter']">Changes remain private to the service team until an admin approves and sends the quotation.</div>
                        <div><div class="mb-2 flex items-center justify-between"><div><label class="text-xs font-bold font-['Inter']">Inventory parts</label><p class="text-[11px] text-[#8a929e] font-['Inter']">Quantities are checked against live stock.</p></div><button type="button" @@click="addQuoteLine()" class="text-xs font-bold text-[#0878f9] font-['Inter']">+ Add part</button></div>
                            <div class="flex flex-col gap-2"><template x-for="(line,index) in quoteLines" :key="index"><div class="grid grid-cols-[minmax(0,1fr)_72px_28px] gap-2"><select name="itemIds" x-model="line.itemId" required class="ui-select min-w-0 text-xs"><option value="">Select part</option><template x-for="item in inventory" :key="item.id"><option :value="item.id" x-text="`${item.name} · ${item.stock} available · ₱${item.price.toLocaleString()}`"></option></template></select><input name="quantities" type="number" min="1" :max="inventoryItem(line.itemId)?.stock || 1" x-model.number="line.quantity" required class="rounded-lg border px-2 py-2 text-xs"/><button type="button" @@click="removeQuoteLine(index)" class="text-gray-400 hover:text-red-600" aria-label="Remove item"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 6-12 12M6 6l12 12"/></svg></button></div></template></div>
                        </div>
                        <div class="grid grid-cols-2 gap-3"><div><label class="mb-1 block text-xs font-semibold font-['Inter']">Labor (₱)</label><input name="laborAmount" type="number" min="0" step="0.01" x-model.number="laborAmount" required class="w-full rounded-lg border px-3 py-2"/></div><div class="rounded-xl border bg-gray-50 p-3"><p class="text-[10px] font-bold uppercase text-[#8a929e] font-['Inter']">Updated total</p><p class="mt-1 text-lg font-bold font-['Inter']" x-text="`₱${quoteTotal.toLocaleString(undefined,{minimumFractionDigits:2})}`"></p></div></div>
                        <div>
                            <div class="mb-1.5 flex items-center justify-between gap-3"><label for="edit-quotation-deadline" class="block text-xs font-semibold font-['Inter']">Estimated completion</label><span class="text-[10px] font-semibold text-[#8a929e] font-['Inter']">PHT · UTC+8</span></div>
                            <div class="ui-date-control">
                                <input id="edit-quotation-deadline" name="proposedDeadline" type="datetime-local" x-model="editDeadline" required class="ui-date-input" data-picker-label="Completion estimate" data-picker-placeholder="Select estimated completion" />
                                <span class="ui-date-control__icon" aria-hidden="true"><partial name="~/Views/Shared/_AppIcon.cshtml" model='"calendar"' /></span>
                            </div>
                        </div>
                        <div><label class="mb-1 block text-xs font-semibold font-['Inter']">Updated service note <span class="font-normal text-[#8a929e]">(optional)</span></label><textarea name="serviceNotes" rows="2" class="w-full rounded-lg border px-3 py-2 text-sm font-['Inter']" placeholder="Add only new context for the admin."></textarea></div>
                        <div class="flex justify-end gap-3 border-t pt-4"><button type="button" @@click="editQuoteOpen=false" class="rounded-lg border px-4 py-2 text-sm font-semibold font-['Inter']">Cancel</button><button type="submit" class="rounded-lg bg-[#0878f9] px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 font-['Inter']">Save &amp; Resubmit</button></div>
                    </form>
                </div>
            </div>

            <!-- Phase 2: Quality Checklist -->
            <div class="bg-white border border-[#e7eaf0] rounded-2xl p-5 shadow-2xs flex flex-col gap-4"
                 x-show="drawerJob?.status === 'In Progress' || drawerJob?.status === 'Completed'">
                
                <!-- Section Header -->
                <div class="flex items-center justify-between">
                    <span class="font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider flex items-center gap-1.5">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0878f9" stroke-width="2.5"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                        Quality Checklist (SOP)
                    </span>
                    <span class="text-xs font-semibold font-['Inter'] transition-all"
                          :class="allChecked ? 'text-emerald-600' : 'text-[#0878f9]'"
                          x-text="completedChecksCount + ' of 5 Completed'"></span>
                </div>

                <!-- Progress Bar -->
                <div>
                    <div class="w-full bg-gray-100 rounded-full h-1.5 overflow-hidden">
                        <div class="h-1.5 rounded-full transition-all duration-500 ease-out"
                             :class="allChecked ? 'bg-emerald-500' : 'bg-[#0878f9]'"
                             :style="'width: ' + checklistProgressPercent + '%'"></div>
                    </div>
                </div>

                <!-- Checklist Items -->
                <div class="flex flex-col gap-2">
                    <template x-for="(checkItem, idx) in [
                        { id: 'c1', title: '1. Comprehensive Diagnostic & Health Check', desc: 'Thermal inspection, power rail test & event log triage.' },
                        { id: 'c2', title: '2. Hardware Repair / Part Replacement', desc: 'Physical repairs, wiring harness & clean part installation.' },
                        { id: 'c3', title: '3. Firmware & System Configuration', desc: 'Driver updates, OS calibration, and network connectivity.' },
                        { id: 'c4', title: '4. QA Stability & Stress Benchmark', desc: 'Full functional stress test & performance verification.' },
                        { id: 'c5', title: '5. Handover & 30-Day Warranty Activation', desc: 'Customer demonstration & electronic service sign-off.' }
                    ]" :key="checkItem.id">
                        <label class="flex items-start gap-3 p-3 rounded-xl border transition-all duration-200 cursor-pointer select-none group"
                               :class="checks[checkItem.id] ? 'bg-blue-50/50 border-blue-200' : 'bg-white border-[#e7eaf0] hover:border-[#0878f9]/40 hover:bg-gray-50/50'">
                            <div class="relative flex items-center justify-center shrink-0 mt-0.5">
                                <input type="checkbox" x-model="checks[checkItem.id]" @@change="saveChecks()" :disabled="drawerJob?.status === 'Completed'" 
                                       class="peer appearance-none w-[18px] h-[18px] border-2 border-gray-300 rounded-md checked:bg-[#0878f9] checked:border-[#0878f9] disabled:opacity-50 disabled:cursor-not-allowed transition-all cursor-pointer">
                                <svg class="absolute w-3 h-3 text-white opacity-0 peer-checked:opacity-100 scale-50 peer-checked:scale-100 transition-all duration-200 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </div>
                            <div class="flex-1 flex flex-col min-w-0">
                                <div class="flex items-center justify-between gap-2">
                                    <span class="font-['Inter'] text-sm font-semibold transition-colors"
                                          :class="checks[checkItem.id] ? 'text-[#8a929e] line-through' : 'text-[#17191c] group-hover:text-[#0878f9]'"
                                          x-text="checkItem.title"></span>
                                    <span x-show="checks[checkItem.id]" class="inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded shrink-0 font-['Inter']">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                                        Done
                                    </span>
                                </div>
                                <span class="font-['Inter'] text-[11px] text-[#8a929e] mt-0.5" x-text="checkItem.desc"></span>
                            </div>
                        </label>
                    </template>
                </div>

                <!-- Action Controls -->
                <template x-if="drawerJob?.status === 'In Progress'">
                    <div class="pt-3 border-t border-[#e7eaf0] flex flex-col gap-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="relative flex h-2.5 w-2.5">
                                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#0878f9] opacity-50"></span>
                                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#0878f9]"></span>
                                </span>
                                <span class="font-['Inter'] font-bold text-xs text-[#17191c]">Work in Progress</span>
                            </div>
                            <span class="text-[11px] text-[#8a929e] font-['Inter']" x-text="allChecked ? 'Ready to complete' : (5 - completedChecksCount) + ' checks remaining'"></span>
                        </div>

                        <form method="post" asp-action="UpdateStatus" asp-controller="AssignedJobs" asp-area="Technician" class="flex flex-col gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="requestId" :value="drawerJob?.id" />
                            <input type="hidden" name="status" value="Completed" />
                            <button type="submit" :disabled="!allChecked" 
                                    class="w-full py-2.5 px-5 bg-emerald-600 hover:bg-emerald-700 disabled:bg-gray-200 disabled:text-[#8a929e] disabled:cursor-not-allowed disabled:shadow-none text-white font-['Inter'] font-semibold text-sm rounded-xl transition-all shadow-xs flex items-center justify-center gap-2 cursor-pointer">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                Mark as Completed &amp; Resolved
                            </button>
                            <p class="text-[11px] text-center text-[#8a929e] font-['Inter']" x-show="!allChecked">
                                Complete all 5 checklist items above to enable final resolution.
                            </p>
                        </form>

                        <form method="post" asp-action="UpdateStatus" asp-controller="AssignedJobs" asp-area="Technician" class="self-center">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="requestId" :value="drawerJob?.id" />
                            <input type="hidden" name="status" value="Pending" />
                            <button type="submit" class="text-xs text-[#8a929e] hover:text-[#17191c] font-['Inter'] font-medium cursor-pointer transition-colors px-3 py-1.5 rounded-lg hover:bg-gray-100 inline-flex items-center gap-1.5">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
                                Revert to Scheduled / Pending
                            </button>
                        </form>
                    </div>
                </template>

                <template x-if="drawerJob?.status === 'Completed'">
                    <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 flex items-start gap-3">
                        <div class="w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                        <div class="flex-1">
                            <span class="font-['Inter'] font-bold text-sm text-[#17191c] block">Job Successfully Completed!</span>
                            <p class="text-xs text-[#5d6470] mt-0.5 font-['Inter'] leading-relaxed">This service request has been resolved. Quotations/Invoices are accessible by Admin and Customer.</p>
                            
                            <form method="post" asp-action="UpdateStatus" asp-controller="AssignedJobs" asp-area="Technician" class="mt-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="requestId" :value="drawerJob?.id" />
                                <input type="hidden" name="status" value="In Progress" />
                                <button type="submit" class="text-xs font-semibold text-[#17191c] bg-white border border-[#e7eaf0] hover:bg-gray-50 px-3 py-1.5 rounded-lg transition-colors cursor-pointer inline-flex items-center gap-1.5 shadow-2xs font-['Inter']">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
                                    Re-open Job (Mark In Progress)
                                </button>
                            </form>
                        </div>
                    </div>
                </template>
            </div>

            <!-- Phase 3: Proof & Handover -->
            <div class="bg-white border border-[#e7eaf0] rounded-2xl p-5 shadow-2xs flex flex-col gap-4"
                 x-show="drawerJob?.status === 'In Progress' || drawerJob?.status === 'PendingCustomerReview' || drawerJob?.status === 'Completed'">
                <div class="flex items-center justify-between">
                    <span class="font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider flex items-center gap-1.5">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0878f9" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        Proof &amp; Handover
                    </span>
                    <span class="text-[11px] text-[#0878f9] font-medium bg-blue-50 px-2 py-0.5 rounded font-['Inter']">Phase 3</span>
                </div>
                <p class="text-xs text-[#5d6470] font-['Inter'] leading-relaxed">Upload clear evidence of the completed repair for customer review and final sign-off.</p>
                
                <form method="post" asp-action="UploadDeliverable" asp-controller="AssignedJobs" asp-area="Technician" enctype="multipart/form-data" class="flex flex-col gap-3 bg-gray-50 p-4 rounded-xl border border-[#e7eaf0]">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="requestId" :value="drawerJob?.id" />
                    <input type="hidden" name="phase" value="FinalProof" />
                    
                    <div>
                        <label class="text-xs font-semibold text-[#17191c] block mb-1 font-['Inter']">Deliverable Description</label>
                        <textarea name="description" rows="2" required class="w-full border border-[#e7eaf0] rounded-xl px-3 py-2 text-sm font-['Inter'] focus:ring-2 focus:ring-[#0878f9] focus:border-[#0878f9] outline-none transition-all placeholder:text-[#8a929e]" placeholder="Describe the resolution, replaced components, and tested functions..."></textarea>
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-[#17191c] block mb-1 font-['Inter']">Attach Proof (Image/Document)</label>
                        <div class="border-2 border-dashed border-[#e7eaf0] hover:border-[#0878f9]/40 rounded-xl p-4 bg-white transition-all text-center flex flex-col items-center justify-center gap-2 cursor-pointer">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8a929e" stroke-width="1.75"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                            <input type="file" name="imageFile" accept="image/*" class="w-full text-xs text-[#8a929e] file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-[#0878f9] hover:file:bg-blue-100 cursor-pointer font-['Inter']" />
                        </div>
                    </div>
                    <button type="submit" :disabled="!allChecked || drawerJob?.status !== 'In Progress'" 
                            class="w-full bg-[#0878f9] hover:bg-blue-700 disabled:bg-gray-200 disabled:text-[#8a929e] disabled:cursor-not-allowed text-white font-semibold text-sm py-2.5 rounded-xl transition-all flex items-center justify-center gap-2 font-['Inter'] cursor-pointer shadow-xs">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        Submit Proof for Customer Sign-off
                    </button>
                    <p class="text-[11px] text-[#8a929e] text-center font-['Inter']" x-show="!allChecked && drawerJob?.status === 'In Progress'">Complete all five quality checks to unlock proof submission.</p>
                </form>
            </div>
        </div>

            <!-- Drawer Footer Close -->
            <div class="shrink-0 p-4 bg-gray-50 border-t border-[#e7eaf0] flex items-center justify-between">
                <span class="text-xs text-[#8a929e] font-['JetBrains_Mono']" x-text="'ID #' + drawerJob?.id"></span>
                <button type="button" @@click="drawerOpen = false" class="px-4 py-2 bg-white border border-[#e7eaf0] hover:bg-gray-100 text-[#17191c] font-['Inter'] font-semibold text-xs rounded-xl transition-colors cursor-pointer">
                    Close Drawer
                </button>
            </div>
        </div>
    </div>

    <!-- Photo Lightbox Modal -->
    <div x-show="photoModalOpen" style="display:none;" 
         class="fixed inset-0 z-[100] bg-black/80 flex items-center justify-center p-4"
         @@click.self="photoModalOpen = false">
        <div class="relative max-w-3xl max-h-[90vh] bg-black rounded-2xl overflow-hidden">
            <button type="button" @@click="photoModalOpen = false" class="absolute top-3 right-3 w-9 h-9 bg-black/60 hover:bg-black text-white rounded-full flex items-center justify-center z-10 transition-colors">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
            <img :src="photoModalSrc" class="max-w-full max-h-[85vh] object-contain" alt="Full photo" />
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
}
