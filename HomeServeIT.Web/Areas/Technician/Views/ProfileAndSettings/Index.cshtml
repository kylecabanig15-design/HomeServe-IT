@model HomeServeIT.Web.Models.ProfileViewModel
@{
    ViewData["Title"] = "Profile and Settings";
}

<div x-data="{ showEditProfileModal: @((!ViewData.ModelState.IsValid).ToString().ToLowerInvariant()) }" class="flex flex-col items-start w-full max-w-7xl mx-auto p-[32px]">
    <div class="flex flex-col items-start w-full max-w-[768px]">
        <div class="flex items-start justify-between w-full">
            <h1 class="font-['Inter'] font-[650] leading-[35px] text-[#17191c] text-[28px]">
                Profile and settings
            </h1>
        </div>
        
        <!-- Profile completeness -->
        <div class="flex flex-col items-start pt-[32px] w-full">
            <div class="bg-white border border-[#e7eaf0] border-solid flex flex-col items-start p-[20px] rounded-[16px] w-full">
                <div class="flex items-center justify-between w-full">
                    <div class="flex flex-col items-start">
                        <span class="font-['Inter'] font-semibold leading-[21px] text-[#17191c] text-[14px]">
                            Profile completeness
                        </span>
                        <span class="font-['Inter'] font-normal leading-[18px] text-[#5d6470] text-[12px] mt-[2px]">
                            A complete profile helps us serve you better.
                        </span>
                    </div>
                    <span class="font-['Inter'] font-[650] leading-[30px] text-[#0878f9] text-[20px]">
                        100%
                    </span>
                </div>
                <div class="flex flex-col items-start pt-[12px] w-full">
                    <div class="bg-[#e7eaf0] h-[8px] overflow-hidden rounded-full w-full">
                        <div class="bg-[#0878f9] h-[8px] rounded-full w-full"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-col gap-[20px] items-start pt-[24px] w-full max-w-[704px]">
            
            <!-- Personal information -->
            <div class="bg-white border border-[#e7eaf0] border-solid flex flex-col items-start p-[20px] rounded-[16px] w-full">
                <span class="font-['Inter'] font-semibold leading-[21px] text-[#17191c] text-[14px]">
                    Personal information
                </span>
                <div class="flex flex-col items-start pt-[16px] w-full">
                    <div class="border-[#e7eaf0] border-b border-solid flex items-center justify-between py-[12px] w-full">
                        <div class="flex flex-col items-start">
                            <span class="font-['Inter'] font-normal leading-[18px] text-[#8a929e] text-[12px]">Full name</span>
                            <span class="font-['Inter'] font-medium leading-[21px] text-[#17191c] text-[14px] mt-[2px]">@Model.FullName</span>
                        </div>
                        <button @@click="showEditProfileModal = true" class="font-['Inter'] font-[550] leading-[18px] text-[#0878f9] text-[12px] hover:underline">Edit</button>
                    </div>
                    <div class="border-[#e7eaf0] border-b border-solid flex items-center justify-between py-[12px] w-full">
                        <div class="flex flex-col items-start">
                            <span class="font-['Inter'] font-normal leading-[18px] text-[#8a929e] text-[12px]">Email address</span>
                            <span class="font-['Inter'] font-medium leading-[21px] text-[#17191c] text-[14px] mt-[2px]">@Model.Email</span>
                        </div>
                        <button @@click="showEditProfileModal = true" class="font-['Inter'] font-[550] leading-[18px] text-[#0878f9] text-[12px] hover:underline">Edit</button>
                    </div>
                    <div class="flex items-center justify-between py-[12px] w-full">
                        <div class="flex flex-col items-start">
                            <span class="font-['Inter'] font-normal leading-[18px] text-[#8a929e] text-[12px]">Mobile number</span>
                            <span class="font-['Inter'] font-medium leading-[21px] text-[#17191c] text-[14px] mt-[2px]">@Model.Mobile</span>
                        </div>
                        <button @@click="showEditProfileModal = true" class="font-['Inter'] font-[550] leading-[18px] text-[#0878f9] text-[12px] hover:underline">Edit</button>
                    </div>
                </div>
            </div>

            <!-- Service address -->
            <div class="bg-white border border-[#e7eaf0] border-solid flex flex-col items-start p-[20px] rounded-[16px] w-full">
                <span class="font-['Inter'] font-semibold leading-[21px] text-[#17191c] text-[14px]">
                    Service address
                </span>
                <div class="flex flex-col items-start pt-[16px] w-full">
                    <div class="border-[#e7eaf0] border-b border-solid flex items-center justify-between py-[12px] w-full">
                        <div class="flex flex-col items-start">
                            <span class="font-['Inter'] font-normal leading-[18px] text-[#8a929e] text-[12px]">Primary address</span>
                            <span class="font-['Inter'] font-medium leading-[21px] text-[#17191c] text-[14px] mt-[2px]">@Model.Address</span>
                        </div>
                        <button @@click="showEditProfileModal = true" class="font-['Inter'] font-[550] leading-[18px] text-[#0878f9] text-[12px] hover:underline">Edit</button>
                    </div>
                    <div class="flex items-center justify-between py-[12px] w-full">
                        <div class="flex flex-col items-start">
                            <span class="font-['Inter'] font-normal leading-[18px] text-[#8a929e] text-[12px]">City</span>
                            <span class="font-['Inter'] font-medium leading-[21px] text-[#17191c] text-[14px] mt-[2px]">@Model.City</span>
                        </div>
                        <button @@click="showEditProfileModal = true" class="font-['Inter'] font-[550] leading-[18px] text-[#0878f9] text-[12px] hover:underline">Edit</button>
                    </div>
                </div>
            </div>

            <!-- Password and security -->
            <div class="bg-white border border-[#e7eaf0] border-solid flex flex-col items-start p-[20px] rounded-[16px] w-full">
                <span class="font-['Inter'] font-semibold leading-[21px] text-[#17191c] text-[14px]">
                    Password and security
                </span>
                <div class="flex flex-col items-start pt-[16px] w-full">
                    <div class="border-[#e7eaf0] border-b border-solid flex items-center justify-between py-[12px] w-full">
                        <div class="flex flex-col items-start">
                            <span class="font-['Inter'] font-medium leading-[21px] text-[#17191c] text-[14px]">Password</span>
                            <span class="font-['Inter'] font-normal leading-[18px] text-[#8a929e] text-[12px] mt-[2px]">Change your password whenever you want.</span>
                        </div>
                        <a href="/Identity/Account/Manage/ChangePassword" class="bg-white border border-[#e7eaf0] border-solid flex h-[32px] items-center justify-center px-[12px] rounded-[10px] hover:bg-gray-50 transition-colors">
                            <span class="font-['Inter'] font-[550] leading-[19.5px] text-[#17191c] text-[13px]">Change password</span>
                        </a>
                    </div>
                    <div class="flex items-center justify-between py-[12px] w-full">
                        <div class="flex flex-col items-start">
                            <span class="font-['Inter'] font-medium leading-[21px] text-[#17191c] text-[14px]">Active sessions</span>
                            <span class="font-['Inter'] font-normal leading-[18px] text-[#8a929e] text-[12px] mt-[2px]">2 devices currently signed in</span>
                        </div>
                        <button class="flex h-[32px] items-center justify-center px-[12px] rounded-[10px] hover:bg-gray-50 transition-colors">
                            <span class="font-['Inter'] font-[550] leading-[19.5px] text-[#5d6470] text-[13px]">Manage sessions</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Notification preferences -->
            <div class="bg-white border border-[#e7eaf0] border-solid flex flex-col items-start p-[20px] rounded-[16px] w-full">
                <span class="font-['Inter'] font-semibold leading-[21px] text-[#17191c] text-[14px]">
                    Notification preferences
                </span>
                <div class="flex flex-col items-start pt-[16px] w-full">
                    <div class="border-[#e7eaf0] border-b border-solid flex items-center justify-between py-[12px] w-full">
                        <span class="font-['Inter'] font-normal leading-[21px] text-[#17191c] text-[14px]">Appointment reminders</span>
                        <!-- Toggle On -->
                        <div class="bg-[#0878f9] flex h-[24px] items-center px-[2px] rounded-full w-[40px] cursor-pointer">
                            <div class="bg-white rounded-full shadow-sm size-[20px] translate-x-[16px] transition-transform"></div>
                        </div>
                    </div>
                    <div class="border-[#e7eaf0] border-b border-solid flex items-center justify-between py-[12px] w-full">
                        <span class="font-['Inter'] font-normal leading-[21px] text-[#17191c] text-[14px]">Quotation updates</span>
                        <!-- Toggle On -->
                        <div class="bg-[#0878f9] flex h-[24px] items-center px-[2px] rounded-full w-[40px] cursor-pointer">
                            <div class="bg-white rounded-full shadow-sm size-[20px] translate-x-[16px] transition-transform"></div>
                        </div>
                    </div>
                    <div class="border-[#e7eaf0] border-b border-solid flex items-center justify-between py-[12px] w-full">
                        <span class="font-['Inter'] font-normal leading-[21px] text-[#17191c] text-[14px]">Invoice and payment confirmations</span>
                        <!-- Toggle On -->
                        <div class="bg-[#0878f9] flex h-[24px] items-center px-[2px] rounded-full w-[40px] cursor-pointer">
                            <div class="bg-white rounded-full shadow-sm size-[20px] translate-x-[16px] transition-transform"></div>
                        </div>
                    </div>
                    <div class="flex items-center justify-between py-[12px] w-full">
                        <span class="font-['Inter'] font-normal leading-[21px] text-[#17191c] text-[14px]">Promotional and service tips</span>
                        <!-- Toggle Off -->
                        <div class="bg-[#e7eaf0] flex h-[24px] items-center px-[2px] rounded-full w-[40px] cursor-pointer">
                            <div class="bg-white rounded-full shadow-sm size-[20px] transition-transform"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sign out button -->
            <form class="w-full m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="bg-[#d13b3b] flex h-[40px] items-center justify-center px-[16px] rounded-[10px] w-full hover:bg-red-700 transition-colors">
                    <span class="font-['Inter'] font-[550] leading-[21px] text-[14px] text-white">Sign out</span>
                </button>
            </form>
            
            
        </div>
    </div>

    <!-- Edit Profile Modal -->
    <div x-show="showEditProfileModal" style="display: none;" class="relative z-[100]" aria-labelledby="modal-title-1" role="dialog" aria-modal="true">
        <div x-show="showEditProfileModal" x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" class="fixed inset-0 bg-gray-500/75 backdrop-blur-sm transition-opacity"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div x-show="showEditProfileModal" @@click.away="showEditProfileModal = false" x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" class="relative transform overflow-hidden rounded-[24px] bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-[#e7eaf0]">
                    <div class="bg-white px-6 pb-6 pt-6">
                        <div class="sm:flex sm:items-start">
                            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left w-full">
                                <h3 class="text-[20px] font-bold leading-6 text-[#17191c]" id="modal-title-1">Edit Profile</h3>
                                <div class="mt-2">
                                    <p class="text-[14px] text-[#5d6470]">Update your personal information and service address.</p>
                                </div>
                                <form method="post" asp-action="UpdateProfile" asp-controller="ProfileAndSettings" asp-area="Technician" class="mt-6">
                                    <div asp-validation-summary="All" class="text-red-700" role="alert"></div>
                                    <div class="space-y-4">
                                        <div>
                                            <label class="block text-sm font-semibold text-[#17191c] mb-1.5">Full name</label>
                                            <input type="text" asp-for="FullName" required class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg focus:ring-2 focus:ring-[#0878f9]/20 focus:border-[#0878f9] outline-none text-[14px]" />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-semibold text-[#17191c] mb-1.5">Email address</label>
                                            <input type="email" asp-for="Email" required class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg focus:ring-2 focus:ring-[#0878f9]/20 focus:border-[#0878f9] outline-none text-[14px]" />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-semibold text-[#17191c] mb-1.5">Mobile number</label>
                                            <input type="text" asp-for="Mobile" class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg focus:ring-2 focus:ring-[#0878f9]/20 focus:border-[#0878f9] outline-none text-[14px]" />
                                        </div>
                                        <hr class="border-[#e7eaf0] my-4" />
                                        <div>
                                            <label class="block text-sm font-semibold text-[#17191c] mb-1.5">Primary address</label>
                                            <input type="text" asp-for="Address" class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg focus:ring-2 focus:ring-[#0878f9]/20 focus:border-[#0878f9] outline-none text-[14px]" />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-semibold text-[#17191c] mb-1.5">City</label>
                                            <input type="text" asp-for="City" class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg focus:ring-2 focus:ring-[#0878f9]/20 focus:border-[#0878f9] outline-none text-[14px]" />
                                        </div>
                                    </div>
                                    <div class="mt-8 flex items-center justify-end gap-3">
                                        <button type="button" @@click="showEditProfileModal = false" class="px-4 py-2 text-[14px] font-semibold text-[#17191c] bg-white border border-[#e7eaf0] rounded-lg shadow-sm hover:bg-gray-50 transition-colors">Cancel</button>
                                        <button type="submit" class="px-4 py-2 text-[14px] font-semibold text-white bg-[#0878f9] rounded-lg shadow-sm hover:bg-blue-600 transition-colors">Save changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
