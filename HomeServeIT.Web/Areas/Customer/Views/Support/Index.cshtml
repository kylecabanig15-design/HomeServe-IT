@model List<HomeServeIT.Web.Models.SupportTicket>
@{
    ViewData["Title"] = "Customer support";
    var selectedTicketId = ViewBag.SelectedTicketId is int selectedId ? selectedId : (int?)null;

    string StatusClasses(string status) => status switch
    {
        "Resolved" => "border-emerald-200 bg-emerald-50 text-emerald-700",
        "In Progress" => "border-amber-200 bg-amber-50 text-amber-700",
        _ => "border-blue-200 bg-blue-50 text-blue-700"
    };
}

<div class="mx-auto flex w-full max-w-7xl flex-col gap-6 p-5 sm:p-8"
     x-data="{ composerOpen: @(Model.Count == 0 ? "true" : "false") }"
     x-init="@if (selectedTicketId.HasValue) { <text>$nextTick(() => document.getElementById('support-ticket-@selectedTicketId')?.scrollIntoView({ behavior: 'smooth', block: 'center' }))</text> }">
    <header class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
            <div class="mb-2 inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">
                <partial name="~/Views/Shared/_AppIcon.cshtml" model='"message-circle"' />
                Direct admin support
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-[#17191c]">How can we help?</h1>
            <p class="mt-1 max-w-2xl text-sm leading-6 text-[#5d6470]">Send a request to the HomeServe IT admin team and follow every response here.</p>
        </div>
        <button type="button" @@click="composerOpen = !composerOpen" class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#0878f9] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-100">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            New support request
        </button>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="flex items-center gap-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800" role="status">
            <span class="text-emerald-600"><partial name="~/Views/Shared/_AppIcon.cshtml" model='"check-circle"' /></span>
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="flex items-center gap-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-800" role="alert">
            <span class="text-red-600"><partial name="~/Views/Shared/_AppIcon.cshtml" model='"alert-circle"' /></span>
            @TempData["ErrorMessage"]
        </div>
    }

    <section x-show="composerOpen" x-transition style="display:none" class="overflow-hidden rounded-2xl border border-[#dbe5f0] bg-white shadow-sm">
        <div class="border-b border-[#e7eaf0] bg-[#f8fafc] px-5 py-4 sm:px-6">
            <h2 class="text-base font-bold text-[#17191c]">Create a support request</h2>
            <p class="mt-1 text-xs text-[#5d6470]">Include what happened and what you expected. An admin response will appear in the same ticket.</p>
        </div>
        <form asp-area="Customer" asp-controller="Support" asp-action="Create" method="post" class="grid gap-5 p-5 sm:p-6">
            @Html.AntiForgeryToken()
            <label class="grid gap-2">
                <span class="text-xs font-bold uppercase tracking-wide text-[#5d6470]">Subject</span>
                <input name="subject" maxlength="120" required autocomplete="off" placeholder="Example: I need help with my service appointment" class="h-11 rounded-xl border border-[#dce2ea] bg-white px-3.5 text-sm text-[#17191c] outline-none transition placeholder:text-[#a1a8b2] focus:border-[#0878f9] focus:ring-4 focus:ring-blue-100" />
            </label>
            <label class="grid gap-2">
                <span class="text-xs font-bold uppercase tracking-wide text-[#5d6470]">Message</span>
                <textarea name="message" maxlength="2000" required rows="5" placeholder="Describe the issue and include any useful details." class="resize-y rounded-xl border border-[#dce2ea] bg-white px-3.5 py-3 text-sm leading-6 text-[#17191c] outline-none transition placeholder:text-[#a1a8b2] focus:border-[#0878f9] focus:ring-4 focus:ring-blue-100"></textarea>
            </label>
            <div class="flex flex-col-reverse justify-end gap-3 sm:flex-row">
                <button type="button" @@click="composerOpen = false" class="rounded-xl border border-[#dce2ea] px-4 py-2.5 text-sm font-semibold text-[#17191c] hover:bg-gray-50">Cancel</button>
                <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#0878f9] px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-100">
                    <partial name="~/Views/Shared/_AppIcon.cshtml" model='"message-circle"' />
                    Send to admin
                </button>
            </div>
        </form>
    </section>

    <section class="grid gap-4" aria-labelledby="support-history-title">
        <div class="flex items-center justify-between">
            <div>
                <h2 id="support-history-title" class="text-base font-bold text-[#17191c]">Your support history</h2>
                <p class="mt-0.5 text-xs text-[#8a929e]">@Model.Count request@(Model.Count == 1 ? "" : "s")</p>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="flex min-h-[260px] flex-col items-center justify-center rounded-2xl border border-dashed border-[#cfd7e2] bg-white px-6 text-center">
                <span class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-[#0878f9]"><partial name="~/Views/Shared/_AppIcon.cshtml" model='"message-circle"' /></span>
                <h3 class="text-sm font-bold text-[#17191c]">No support requests yet</h3>
                <p class="mt-1 max-w-sm text-sm leading-6 text-[#5d6470]">Your conversation with the admin team will stay organized here.</p>
            </div>
        }
        else
        {
            @foreach (var ticket in Model)
            {
                var isSelected = selectedTicketId == ticket.SupportTicketID;
                <article id="support-ticket-@ticket.SupportTicketID" class="overflow-hidden rounded-2xl border bg-white shadow-sm transition @(isSelected ? "border-[#0878f9] ring-4 ring-blue-50" : "border-[#e1e7ef]")">
                    <header class="flex flex-col gap-3 border-b border-[#edf0f4] px-5 py-4 sm:flex-row sm:items-start sm:justify-between sm:px-6">
                        <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="font-['JetBrains_Mono'] text-[11px] font-bold text-[#0878f9]">SUP-@ticket.SupportTicketID.ToString("D4")</span>
                                <span class="rounded-full border px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide @StatusClasses(ticket.Status)">@ticket.Status</span>
                            </div>
                            <h3 class="mt-2 text-base font-bold text-[#17191c]">@ticket.Subject</h3>
                        </div>
                        <time class="shrink-0 text-xs text-[#8a929e]" datetime="@ticket.CreatedAt.ToString("O")">@ticket.CreatedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</time>
                    </header>
                    <div class="grid gap-4 p-5 sm:p-6">
                        <div class="rounded-xl bg-[#f8fafc] p-4">
                            <p class="mb-1 text-[10px] font-bold uppercase tracking-wider text-[#8a929e]">Your message</p>
                            <p class="whitespace-pre-line text-sm leading-6 text-[#3f4650]">@ticket.Message</p>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(ticket.AdminResponse))
                        {
                            <div class="rounded-xl border border-blue-100 bg-blue-50/70 p-4">
                                <div class="mb-2 flex items-center gap-2 text-[#0878f9]">
                                    <partial name="~/Views/Shared/_AppIcon.cshtml" model='"message-circle"' />
                                    <p class="text-[10px] font-bold uppercase tracking-wider">Admin response</p>
                                </div>
                                <p class="whitespace-pre-line text-sm leading-6 text-[#273142]">@ticket.AdminResponse</p>
                                @if (ticket.RespondedAt.HasValue)
                                {
                                    <time class="mt-3 block text-[11px] text-[#6b7686]" datetime="@ticket.RespondedAt.Value.ToString("O")">Updated @ticket.RespondedAt.Value.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</time>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="flex items-center gap-3 rounded-xl border border-amber-100 bg-amber-50/70 px-4 py-3 text-sm text-amber-800">
                                <span class="shrink-0"><partial name="~/Views/Shared/_AppIcon.cshtml" model='"clock"' /></span>
                                The admin team has received this request. Their response will appear here.
                            </div>
                        }
                    </div>
                </article>
            }
        }
    </section>
</div>
