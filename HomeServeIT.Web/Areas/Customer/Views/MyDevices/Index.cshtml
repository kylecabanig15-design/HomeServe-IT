@using HomeServeIT.Web.Models
@model List<Device>
@{
    ViewData["Title"] = "My devices";
    var openAddDevice = string.Equals(Context.Request.Query["open"], "add", StringComparison.OrdinalIgnoreCase);
    string DeviceIcon(string type) => type switch
    {
        "Laptop"     => "laptop",
        "Desktop"    => "monitor",
        "Phone"      => "smartphone",
        "Printer"    => "printer",
        "Smart Home" => "home",
        _             => "plug"
    };
}

<div x-data="{ showAddDeviceModal: @(openAddDevice ? "true" : "false") }" class="flex flex-col p-[32px] max-w-7xl mx-auto w-full gap-[32px]">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-800 px-[16px] py-[12px] rounded-[10px] font-['Inter'] text-[14px] flex items-center gap-[8px]">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-800 px-[16px] py-[12px] rounded-[10px] font-['Inter'] text-[14px] flex items-center gap-[8px]">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Page Header -->
    <div class="flex items-start justify-between">
        <div class="flex flex-col gap-[4px]">
            <h1 class="font-['Inter'] font-bold text-[28px] leading-[35px] tracking-tight text-[#17191c]">
                My devices
            </h1>
            <p class="font-['Inter'] text-[15px] leading-[21px] text-[#5d6470]">
                @if (Model.Count > 0)
                {
                    <text>@Model.Count device@(Model.Count != 1 ? "s" : "") linked to your account.</text>
                }
                else
                {
                    <text>No devices linked yet. Register one to get started.</text>
                }
            </p>
        </div>
        <button @@click="showAddDeviceModal = true" class="flex items-center gap-[8px] bg-white border border-[#e7eaf0] text-[#17191c] px-[16px] py-[10px] rounded-[10px] font-['Inter'] font-[550] text-[14px] hover:bg-gray-50 transition-colors shadow-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Add device
        </button>
    </div>

    @if (Model.Count == 0)
    {
        <!-- Empty State -->
        <div class="bg-white border border-dashed border-[#d1d5db] rounded-[16px] p-[64px] flex flex-col items-center justify-center text-center">
            <div class="w-[72px] h-[72px] bg-gray-50 rounded-full flex items-center justify-center mb-[20px]">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#8a929e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            </div>
            <h3 class="font-['Inter'] font-semibold text-[20px] text-[#17191c] mb-[8px]">No devices yet</h3>
            <p class="font-['Inter'] text-[14px] text-[#5d6470] mb-[24px] max-w-[300px]">Register your laptops, desktops, printers, or other devices to track service history and request help faster.</p>
            <button @@click="showAddDeviceModal = true" class="bg-[#0878f9] text-white px-[24px] py-[12px] rounded-[10px] font-['Inter'] font-[550] text-[14px] hover:bg-blue-600 transition-all shadow-[0_4px_12px_rgba(8,120,249,0.3)] hover:-translate-y-0.5 active:translate-y-0 flex items-center gap-[8px]">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Add your first device
            </button>
        </div>
    }
    else
    {
        <!-- Devices Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-[24px]">
            @foreach (var device in Model)
            {
                <div class="bg-white border border-[#e7eaf0] rounded-[12px] p-[20px] shadow-sm flex flex-col gap-[20px]">
                    <div class="flex items-start justify-between">
                        <div class="flex items-start gap-[12px]">
                            <div class="w-[40px] h-[40px] bg-[#f5f9ff] border border-[#dce9f8] rounded-[10px] flex items-center justify-center text-[#0878f9]">
                                <partial name="~/Views/Shared/_AppIcon.cshtml" model="DeviceIcon(device.Type)" />
                            </div>
                            <div class="flex flex-col">
                                <span class="font-['Inter'] font-[650] text-[16px] text-[#17191c]">@device.Name</span>
                                <span class="font-['Inter'] text-[14px] text-[#5d6470] mt-[2px]">@device.Type</span>
                            </div>
                        </div>
                        <span class="inline-flex items-center gap-[6px] px-[8px] py-[2px] rounded-full bg-green-50 text-green-700 font-['Inter'] font-[600] text-[11px]">
                            <span class="w-[6px] h-[6px] rounded-full bg-green-500"></span> Available
                        </span>
                    </div>

                    <div class="grid grid-cols-2 gap-y-[16px]">
                        <div class="flex flex-col">
                            <span class="font-['Inter'] font-[500] text-[12px] text-[#8a929e] mb-[2px]">Serial number</span>
                            <span class="font-['Inter'] text-[14px] text-[#17191c]">@(device.SerialNumber ?? "—")</span>
                        </div>
                        <div class="flex flex-col">
                            <span class="font-['Inter'] font-[500] text-[12px] text-[#8a929e] mb-[2px]">Device ID</span>
                            <span class="font-['Inter'] text-[14px] text-[#17191c]">DEV-@device.DeviceID.ToString("D3")</span>
                        </div>
                        <div class="flex flex-col">
                            <span class="font-['Inter'] font-[500] text-[12px] text-[#8a929e] mb-[2px]">Date added</span>
                            <span class="font-['Inter'] text-[14px] text-[#17191c]">@device.DateAdded.ToLocalTime().ToString("MMM d, yyyy")</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-[12px] mt-[4px]">
                        <a href="/Customer/ServiceRequests?open=create" class="px-[12px] py-[6px] border border-[#e7eaf0] rounded-[8px] font-['Inter'] font-[550] text-[13px] text-[#17191c] hover:bg-gray-50">New request</a>
                        <form method="post" asp-area="Customer" asp-controller="MyDevices" asp-action="DeleteDevice" class="ml-auto" onsubmit="return confirm('Remove @device.Name from your account?')">
                            <input type="hidden" name="id" value="@device.DeviceID" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="px-[12px] py-[6px] border border-red-200 text-red-600 rounded-[8px] font-['Inter'] font-[550] text-[13px] hover:bg-red-50 transition-colors">Remove</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Add Device Modal -->
    <div x-show="showAddDeviceModal" style="display: none;" class="relative z-[100]" aria-labelledby="modal-title-1" role="dialog" aria-modal="true">
        <div x-show="showAddDeviceModal" x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" class="fixed inset-0 bg-gray-500/75 backdrop-blur-sm transition-opacity"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div x-show="showAddDeviceModal" @@click.away="showAddDeviceModal = false" x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" class="relative transform overflow-hidden rounded-[24px] bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-[#e7eaf0]">
                    <div class="bg-white px-6 pb-6 pt-6">
                        <div class="sm:flex sm:items-start">
                            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left w-full">
                                <h3 class="text-[20px] font-bold leading-6 text-[#17191c]" id="modal-title-1">Register new device</h3>
                                <div class="mt-2">
                                    <p class="text-[14px] text-[#5d6470]">Add a device to your account for tracking and service history.</p>
                                </div>
                                <form method="post" asp-action="AddDevice" asp-controller="MyDevices" asp-area="Customer" class="mt-6">
                                    @Html.AntiForgeryToken()
                                    <div class="space-y-4">
                                        <div>
                                            <label class="block text-sm font-semibold text-[#17191c] mb-1.5">Device Name</label>
                                            <input type="text" name="deviceName" required class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg focus:ring-2 focus:ring-[#0878f9]/20 focus:border-[#0878f9] outline-none text-[14px]" placeholder="e.g. ASUS Laptop, HP Printer" />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-semibold text-[#17191c] mb-1.5">Device Type</label>
                                            <select name="deviceType" required class="ui-select text-[14px]">
                                                <option value="">Select a type</option>
                                                <option value="Laptop">Laptop</option>
                                                <option value="Desktop">Desktop</option>
                                                <option value="Phone">Phone</option>
                                                <option value="Printer">Printer</option>
                                                <option value="Smart Home">Smart Home</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-sm font-semibold text-[#17191c] mb-1.5">Serial Number <span class="font-normal text-[#8a929e]">(optional)</span></label>
                                            <input type="text" name="serialNumber" class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg focus:ring-2 focus:ring-[#0878f9]/20 focus:border-[#0878f9] outline-none text-[14px]" placeholder="e.g. G512LW-0021A" />
                                        </div>
                                    </div>
                                    <div class="mt-8 flex items-center justify-end gap-3">
                                        <button type="button" @@click="showAddDeviceModal = false" class="px-4 py-2 text-[14px] font-semibold text-[#17191c] bg-white border border-[#e7eaf0] rounded-lg shadow-sm hover:bg-gray-50 transition-colors">Cancel</button>
                                        <button type="submit" class="px-4 py-2 text-[14px] font-semibold text-white bg-[#0878f9] rounded-lg shadow-sm hover:bg-blue-600 transition-colors">Add device</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
