@model HomeServeIT.Web.Areas.Admin.Models.AdminArchiveViewModel
@inject Microsoft.AspNetCore.Identity.UserManager<HomeServeIT.Web.Models.ApplicationUser> UserManager
@{ ViewData["Title"] = "Archive"; }

<div x-data="{ section: 'services', query: '', showDeleteModal: false, deleteUserId: '', deleteUserEmail: '' }" class="flex flex-col max-w-7xl p-4 sm:p-6 lg:p-8 w-full mx-auto gap-6">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-2"><span class="w-8 h-8 rounded-xl bg-slate-900 text-white flex items-center justify-center"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><path d="M10 12h4"/></svg></span><span class="text-[11px] font-bold uppercase tracking-[0.16em] text-[#8a929e]">Records center</span></div>
            <h1 class="font-['Inter'] font-bold text-[#17191c] text-3xl tracking-tight">Archive</h1>
            <p class="text-[#5d6470] text-sm mt-1">Review inactive records without cluttering day-to-day operations.</p>
        </div>
        <div class="relative w-full sm:w-72"><svg class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input x-model="query" type="search" placeholder="Search current section…" class="w-full rounded-xl border border-[#e7eaf0] bg-white py-2.5 pl-10 pr-4 text-sm outline-none focus:border-[#0878f9] focus:ring-4 focus:ring-blue-50" /></div>
    </div>

    @if (TempData["SuccessMessage"] != null) { <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl flex items-center gap-2 text-sm font-medium"><span class="w-5 h-5 rounded-full bg-emerald-100 flex items-center justify-center"><svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 12 4 4L19 6"/></svg></span>@TempData["SuccessMessage"]</div> }

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <button type="button" @@click="section = 'services'; query = ''" class="text-left rounded-2xl border p-5 transition-all" :class="section === 'services' ? 'border-blue-300 bg-blue-50/50 ring-2 ring-blue-100' : 'border-[#e7eaf0] bg-white hover:border-gray-300'">
            <div class="flex items-center justify-between"><span class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.1-3.1a6 6 0 0 1-7.9 7.9l-5.7 5.7a2.1 2.1 0 0 1-3-3l5.7-5.7a6 6 0 0 1 7.9-7.9z"/></svg></span><span class="font-['JetBrains_Mono'] text-2xl font-bold">@Model.ServiceRequests.Count</span></div>
            <h2 class="font-bold text-sm mt-4">Service archives</h2><p class="text-xs text-[#8a929e] mt-1">Completed and cancelled jobs removed from active operations.</p>
        </button>
        <button type="button" @@click="section = 'users'; query = ''" class="text-left rounded-2xl border p-5 transition-all" :class="section === 'users' ? 'border-violet-300 bg-violet-50/50 ring-2 ring-violet-100' : 'border-[#e7eaf0] bg-white hover:border-gray-300'">
            <div class="flex items-center justify-between"><span class="w-10 h-10 rounded-xl bg-violet-100 text-violet-700 flex items-center justify-center"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></svg></span><span class="font-['JetBrains_Mono'] text-2xl font-bold">@Model.Users.Count</span></div>
            <h2 class="font-bold text-sm mt-4">User archives</h2><p class="text-xs text-[#8a929e] mt-1">Deactivated accounts retained for administration.</p>
        </button>
    </div>

    <section x-show="section === 'services'" x-transition.opacity>
        <div class="mb-3"><h2 class="font-bold text-base">Service archives</h2><p class="text-xs text-[#8a929e] mt-0.5">Completed jobs return with their status preserved. Cancelled requests reopen as pending.</p></div>
        <div class="bg-white border border-[#e7eaf0] rounded-2xl shadow-sm overflow-x-auto"><table class="w-full min-w-[820px] text-left">
            <thead class="bg-[#f9fafb] border-b border-[#e7eaf0] text-[11px] uppercase tracking-wider text-[#8a929e]"><tr><th class="px-5 py-3">Job</th><th class="px-5 py-3">Customer &amp; issue</th><th class="px-5 py-3">Technician</th><th class="px-5 py-3">Original schedule</th><th class="px-5 py-3">Status</th><th class="px-5 py-3 text-right">Action</th></tr></thead>
            <tbody class="divide-y divide-[#e7eaf0]">
            @foreach (var request in Model.ServiceRequests)
            {
                var searchable = $"JOB-{request.RequestID:D4} {request.Customer?.FirstName} {request.Customer?.LastName} {request.IssueDescription} {request.Technician?.FirstName} {request.Technician?.LastName} {request.Status}".ToLowerInvariant().Replace("'", "\\'");
                <tr x-show="!query || '@searchable'.includes(query.toLowerCase())" class="hover:bg-gray-50/60">
                    <td class="px-5 py-4"><span class="font-['JetBrains_Mono'] text-xs font-semibold text-[#0878f9]">JOB-@request.ScheduledDate.Year-@request.RequestID.ToString("D4")</span></td>
                    <td class="px-5 py-4"><p class="text-sm font-semibold">@request.Customer?.FirstName @request.Customer?.LastName</p><p class="max-w-[260px] truncate text-xs text-[#8a929e] mt-0.5">@request.IssueDescription</p></td>
                    <td class="px-5 py-4 text-sm text-[#5d6470]">@(request.Technician == null ? "Unassigned" : $"{request.Technician.FirstName} {request.Technician.LastName}")</td>
                    <td class="px-5 py-4 text-xs text-[#5d6470]">@request.ScheduledDate.ToString("MMM d, yyyy · h:mm tt")</td>
                    <td class="px-5 py-4"><span class="rounded-full px-2.5 py-1 text-[11px] font-semibold @(request.Status == "Completed" ? "bg-emerald-50 text-emerald-700" : "bg-red-50 text-red-700")">@request.Status</span></td>
                    <td class="px-5 py-4 text-right"><form asp-area="Admin" asp-controller="Operations" asp-action="RestoreRequest" method="post">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@request.RequestID"/><button class="rounded-lg border border-[#e7eaf0] px-3 py-2 text-xs font-semibold hover:border-blue-300 hover:text-[#0878f9]">@(request.Status == "Cancelled" ? "Reopen request" : "Restore to list")</button></form></td>
                </tr>
            }
            @if (!Model.ServiceRequests.Any()) { <tr><td colspan="6" class="py-14 text-center text-sm text-[#8a929e]">No archived service requests.</td></tr> }
            </tbody>
        </table></div>
    </section>

    <section x-show="section === 'users'" x-transition.opacity style="display:none;">
        <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div><h2 class="text-base font-bold text-[#17191c]">Archived accounts</h2><p class="mt-0.5 text-xs text-[#8a929e]">Account access is locked while profile and service records remain securely retained.</p></div>
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-[11px] font-bold text-amber-700"><span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>@Model.Users.Count locked</span>
        </div>
        <div class="overflow-hidden rounded-2xl border border-[#e3e8ef] bg-white shadow-[0_8px_28px_-18px_rgba(15,23,42,0.24)]">
            <div class="flex items-start gap-3 border-b border-violet-100 bg-gradient-to-r from-violet-50/90 via-white to-blue-50/60 px-5 py-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-violet-700 shadow-sm ring-1 ring-violet-100"><svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>
                <div><p class="text-sm font-bold text-[#25282d]">Archived customers cannot sign in</p><p class="mt-0.5 text-xs leading-5 text-[#69717d]">Restoring an account immediately removes its lock and returns the customer’s access. Permanent deletion cannot be undone.</p></div>
            </div>
            <div class="overflow-x-auto"><table class="w-full min-w-[860px] text-left">
            <thead class="border-b border-[#e7eaf0] bg-[#fafbfc] text-[10px] font-bold uppercase tracking-[0.12em] text-[#8a929e]"><tr><th class="px-5 py-3.5">Account</th><th class="px-5 py-3.5">Role</th><th class="px-5 py-3.5">Access state</th><th class="px-5 py-3.5 text-right">Actions</th></tr></thead><tbody class="divide-y divide-[#edf0f4]">
            @foreach (var user in Model.Users)
            {
                var roles = await UserManager.GetRolesAsync(user); var primaryRole = roles.FirstOrDefault() ?? "Unknown"; var searchable = $"{user.FullName} {user.Email} {primaryRole}".ToLowerInvariant().Replace("'", "\\'");
                <tr x-show="!query || '@searchable'.includes(query.toLowerCase())" class="group transition-colors hover:bg-[#fafcff]">
                    <td class="px-5 py-4.5"><div class="flex items-center gap-3.5"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-violet-100 to-blue-100 text-sm font-bold text-violet-700 shadow-sm ring-1 ring-white">@((user.FullName ?? user.Email ?? "?")[0].ToString().ToUpper())</span><div><p class="text-sm font-bold text-[#25282d]">@(user.FullName ?? "Unnamed user")</p><p class="mt-0.5 text-xs text-[#8a929e]">@user.Email</p><p class="mt-1 text-[10px] font-semibold text-[#69717d]">@(primaryRole == HomeServeIT.Web.Constants.Roles.Customer ? "Customer profile and history retained" : "Account records securely retained")</p></div></div></td>
                    <td class="px-5 py-4.5"><span class="inline-flex items-center gap-1.5 rounded-full border border-violet-100 bg-violet-50 px-2.5 py-1 text-[11px] font-bold text-violet-700"><svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 22a8 8 0 0 1 16 0"/></svg>@primaryRole</span></td>
                    <td class="px-5 py-4.5"><div class="inline-flex items-center gap-2 rounded-xl border border-amber-200 bg-amber-50/80 px-3 py-2"><span class="flex h-6 w-6 items-center justify-center rounded-lg bg-white text-amber-700 shadow-sm"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span><div><p class="text-[11px] font-bold text-amber-800">Locked out</p><p class="text-[10px] text-amber-700/80">Archived account</p></div></div></td>
                    <td class="px-5 py-4.5"><div class="flex items-center justify-end gap-2"><form asp-area="Admin" asp-controller="System" asp-action="UnarchiveUser" method="post">@Html.AntiForgeryToken()<input type="hidden" name="userId" value="@user.Id"/><button type="submit" class="inline-flex items-center gap-1.5 rounded-xl bg-[#0878f9] px-3.5 py-2.5 text-xs font-bold text-white shadow-[0_7px_16px_-8px_rgba(8,120,249,0.8)] transition hover:-translate-y-0.5 hover:bg-[#0669db]"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>Restore access</button></form><button type="button" @@click="deleteUserId = '@user.Id'; deleteUserEmail = '@user.Email'; showDeleteModal = true" class="rounded-xl px-3 py-2.5 text-xs font-semibold text-[#8a929e] transition hover:bg-red-50 hover:text-red-600">Delete</button></div></td>
                </tr>
            }
            @if (!Model.Users.Any()) { <tr><td colspan="4" class="py-16 text-center"><span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg></span><p class="mt-3 text-sm font-bold text-[#30343a]">No archived accounts</p><p class="mt-1 text-xs text-[#8a929e]">All users currently have an active account state.</p></td></tr> }
            </tbody></table></div>
        </div>
    </section>

    <div x-show="showDeleteModal" style="display:none" class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-950/55 p-4 backdrop-blur-sm" @@click.self="showDeleteModal = false"><div x-show="showDeleteModal" x-transition class="w-full max-w-md overflow-hidden rounded-3xl border border-white/60 bg-white shadow-[0_30px_80px_-24px_rgba(15,23,42,0.55)]"><div class="p-6 sm:p-7"><span class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-red-50 text-red-600 ring-1 ring-red-100"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v5M14 11v5"/></svg></span><h3 class="text-xl font-bold tracking-tight text-[#17191c]">Delete account permanently?</h3><p class="mt-2 text-sm leading-6 text-[#69717d]">This will permanently delete <strong class="font-bold text-[#30343a]" x-text="deleteUserEmail"></strong> and cannot be undone. Restore access instead if the customer may return.</p><form method="post" asp-action="DeleteUser" asp-controller="System" asp-area="Admin" class="mt-7">@Html.AntiForgeryToken()<input type="hidden" name="userId" x-model="deleteUserId"/><div class="flex justify-end gap-3"><button type="button" @@click="showDeleteModal = false" class="rounded-xl border border-[#dce2ea] bg-white px-4 py-2.5 text-sm font-bold text-[#30343a] transition hover:bg-[#f8fafc]">Keep account</button><button type="submit" class="rounded-xl bg-red-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-red-700">Delete permanently</button></div></form></div></div></div>
</div>
