@model HomeServeIT.Web.Models.Customer
@{
    ViewData["Title"] = "Customer CRM";
    var requests = ViewBag.ServiceRequests as IEnumerable<HomeServeIT.Web.Models.ServiceRequest> ?? new List<HomeServeIT.Web.Models.ServiceRequest>();
    var invoices = ViewBag.Invoices as IEnumerable<HomeServeIT.Web.Models.Invoice> ?? new List<HomeServeIT.Web.Models.Invoice>();
    var devices = ViewBag.Devices as IEnumerable<HomeServeIT.Web.Models.Device> ?? new List<HomeServeIT.Web.Models.Device>();
    
    var reqCount = requests.Count();
    var invCount = invoices.Count();
    var devCount = devices.Count();
}

<div class="content-stretch flex flex-col items-start max-w-7xl p-4 sm:p-6 lg:p-8 relative shrink-0 w-full mx-auto gap-6"
     x-data="{
        editModalOpen: false,
        activeTab: 'services' // 'services', 'invoices', 'devices'
     }">

    <!-- Alert / Toast Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="w-full bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl font-['Inter'] text-sm flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="font-medium">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" @@click="$el.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>
    }

    <!-- Header -->
    <div class="flex items-center justify-between w-full">
        <div>
            <div class="flex items-center gap-2">
                <a asp-area="Admin" asp-controller="Crm" asp-action="Customers" class="text-xs font-semibold text-[#0878f9] hover:underline flex items-center gap-1">
                    ← Customers
                </a>
                <span class="text-xs text-gray-300">/</span>
                <span class="text-xs font-semibold text-gray-500">Profile Details</span>
            </div>
            <h1 class="font-['Inter'] font-bold text-2xl sm:text-3xl text-[#17191c] mt-1 tracking-tight">
                Customer CRM
            </h1>
            <p class="font-['Inter'] text-sm text-[#5d6470] mt-0.5">
                Detailed view of customer profile, request history, invoices, and registered devices.
            </p>
        </div>

        <div class="flex items-center gap-2">
            <!-- Edit Customer Button -->
            <button type="button" @@click="editModalOpen = true" 
                    class="bg-white border border-[#e7eaf0] hover:bg-gray-50 transition-colors text-[#17191c] font-['Inter'] font-semibold text-sm px-4 py-2.5 rounded-xl shadow-2xs flex items-center gap-2 cursor-pointer">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Edit Customer
            </button>
        </div>
    </div>
    
    <div class="flex flex-col lg:flex-row gap-6 w-full items-start">
        
        <!-- Customer Profile Card (Sidebar) -->
        <div class="w-full lg:w-[320px] shrink-0 bg-white border border-[#e7eaf0] rounded-3xl p-6 shadow-xs flex flex-col items-center">
            @{
                var fInitial = !string.IsNullOrEmpty(Model.FirstName) ? Model.FirstName.Substring(0, 1).ToUpper() : "";
                var lInitial = !string.IsNullOrEmpty(Model.LastName) ? Model.LastName.Substring(0, 1).ToUpper() : "";
                var initials = $"{fInitial}{lInitial}";
                if (string.IsNullOrEmpty(initials)) initials = "C";
                var fullNameEncoded = System.Net.WebUtility.UrlEncode($"{Model.FirstName} {Model.LastName}".Trim());
            }
            <div class="relative">
                <div class="w-24 h-24 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center font-bold text-2xl shadow-lg shadow-blue-500/20 ring-4 ring-blue-50 border-2 border-white overflow-hidden">
                    <img src="https://ui-avatars.com/api/?name=@fullNameEncoded&background=0878f9&color=fff&size=128&bold=true&font-size=0.4" 
                         alt="@Model.FirstName @Model.LastName" 
                         class="w-full h-full object-cover"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                    <span style="display:none;" class="w-full h-full items-center justify-center font-bold text-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white">@initials</span>
                </div>
            </div>
            
            <h2 class="font-['Inter'] font-bold text-[#17191c] text-xl mt-3.5 text-center">@Model.FirstName @Model.LastName</h2>
            
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100 mt-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Active Account
            </span>
            
            <div class="w-full border-t border-[#e7eaf0] my-5"></div>
            
            <div class="w-full flex flex-col gap-4">
                <div>
                    <p class="font-['Inter'] font-bold text-[#8a929e] text-[11px] uppercase tracking-wider">Contact</p>
                    <div class="flex items-center gap-2.5 mt-2 text-xs">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#5d6470" stroke-width="2" class="shrink-0"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        <p class="font-['Inter'] font-medium text-[#17191c] truncate">@(Model.User?.Email ?? "No email")</p>
                    </div>
                    <div class="flex items-center gap-2.5 mt-2 text-xs">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#5d6470" stroke-width="2" class="shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        <p class="font-['Inter'] font-medium text-[#17191c]">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "No phone" : Model.PhoneNumber)</p>
                    </div>
                </div>
                
                <div>
                    <p class="font-['Inter'] font-bold text-[#8a929e] text-[11px] uppercase tracking-wider">Location</p>
                    <div class="flex items-start gap-2.5 mt-2 text-xs">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#5d6470" stroke-width="2" class="shrink-0 mt-0.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        <p class="font-['Inter'] font-medium text-[#17191c] leading-relaxed">@(string.IsNullOrWhiteSpace(Model.HomeAddress) ? "No address specified" : Model.HomeAddress)</p>
                    </div>
                </div>
                
                <div>
                    <p class="font-['Inter'] font-bold text-[#8a929e] text-[11px] uppercase tracking-wider">Details</p>
                    <div class="flex items-center gap-2.5 mt-2 text-xs">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#5d6470" stroke-width="2" class="shrink-0"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                        <p class="font-['Inter'] font-medium text-[#17191c]">Registered Customer</p>
                    </div>
                    <div class="flex items-center gap-2.5 mt-2 text-xs">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#5d6470" stroke-width="2" class="shrink-0"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <p class="font-['Inter'] font-medium text-[#17191c]">ID #@Model.CustomerID</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Main Content Tabs & Data Area -->
        <div class="flex-1 w-full flex flex-col gap-4">
            
            <!-- Dynamic Tab Buttons -->
            <div class="flex items-center gap-1.5 bg-gray-50 border border-[#e7eaf0] rounded-2xl p-1 shadow-2xs w-fit">
                <button type="button" @@click="activeTab = 'services'"
                        :class="activeTab === 'services' ? 'bg-white text-[#17191c] font-bold shadow-xs' : 'text-[#5d6470] hover:text-[#17191c] font-medium'"
                        class="flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-['Inter'] transition-all cursor-pointer">
                    <span>Service History</span>
                    <span class="px-2 py-0.2 rounded-full text-[10px]" :class="activeTab === 'services' ? 'bg-blue-100 text-blue-700' : 'bg-gray-200 text-gray-600'">@reqCount</span>
                </button>
                <button type="button" @@click="activeTab = 'invoices'"
                        :class="activeTab === 'invoices' ? 'bg-white text-[#17191c] font-bold shadow-xs' : 'text-[#5d6470] hover:text-[#17191c] font-medium'"
                        class="flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-['Inter'] transition-all cursor-pointer">
                    <span>Invoices</span>
                    <span class="px-2 py-0.2 rounded-full text-[10px]" :class="activeTab === 'invoices' ? 'bg-blue-100 text-blue-700' : 'bg-gray-200 text-gray-600'">@invCount</span>
                </button>
                <button type="button" @@click="activeTab = 'devices'"
                        :class="activeTab === 'devices' ? 'bg-white text-[#17191c] font-bold shadow-xs' : 'text-[#5d6470] hover:text-[#17191c] font-medium'"
                        class="flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-['Inter'] transition-all cursor-pointer">
                    <span>Registered Devices</span>
                    <span class="px-2 py-0.2 rounded-full text-[10px]" :class="activeTab === 'devices' ? 'bg-blue-100 text-blue-700' : 'bg-gray-200 text-gray-600'">@devCount</span>
                </button>
            </div>
            
            <!-- Tab 1: Service Requests Table -->
            <div x-show="activeTab === 'services'" class="w-full bg-white border border-[#e7eaf0] rounded-3xl overflow-hidden shadow-xs">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-[#e7eaf0] bg-gray-50/70">
                            <th class="py-3.5 px-5 font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Request ID</th>
                            <th class="py-3.5 px-5 font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Issue Description</th>
                            <th class="py-3.5 px-5 font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Scheduled</th>
                            <th class="py-3.5 px-5 font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Technician</th>
                            <th class="py-3.5 px-5 font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Status</th>
                        </tr>
                    </thead>
                    <tbody class="font-['Inter'] text-xs text-[#17191c] divide-y divide-[#f0f2f5]">
                        @foreach (var request in requests)
                        {
                            <tr class="hover:bg-blue-50/30 transition-colors">
                                <td class="py-4 px-5 font-['JetBrains_Mono'] font-semibold text-[#0878f9]">
                                    SR-@request.ScheduledDate.Year-@request.RequestID.ToString("D4")
                                </td>
                                <td class="py-4 px-5">
                                    <p class="font-bold text-[#17191c]">@(request.ServiceCategory ?? "General Repair")</p>
                                    <p class="text-[#8a929e] text-[11px] mt-0.5">@request.IssueDescription</p>
                                </td>
                                <td class="py-4 px-5 text-[#5d6470] font-medium">@request.ScheduledDate.ToString("MMM d, yyyy · h:mm tt")</td>
                                <td class="py-4 px-5 text-[#5d6470]">
                                    @(request.Technician != null ? $"{request.Technician.FirstName} {request.Technician.LastName}" : "Unassigned")
                                </td>
                                <td class="py-4 px-5">
                                    @if (request.Status == "Completed")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Completed
                                        </span>
                                    }
                                    else if (request.Status == "In Progress")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-100">
                                            <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span> In Progress
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-100">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Pending
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!requests.Any())
                        {
                            <tr>
                                <td colspan="5" class="py-12 text-center text-[#8a929e] font-['Inter']">No service history records found for this customer.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Tab 2: Invoices Table -->
            <div x-show="activeTab === 'invoices'" style="display:none;" class="w-full bg-white border border-[#e7eaf0] rounded-3xl overflow-hidden shadow-xs">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-[#e7eaf0] bg-gray-50/70">
                            <th class="py-3.5 px-5 font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Invoice ID</th>
                            <th class="py-3.5 px-5 font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Related Request</th>
                            <th class="py-3.5 px-5 font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Date Issued</th>
                            <th class="py-3.5 px-5 font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Amount</th>
                            <th class="py-3.5 px-5 font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Payment Status</th>
                        </tr>
                    </thead>
                    <tbody class="font-['Inter'] text-xs text-[#17191c] divide-y divide-[#f0f2f5]">
                        @foreach (var inv in invoices)
                        {
                            <tr class="hover:bg-blue-50/30 transition-colors">
                                <td class="py-4 px-5 font-['JetBrains_Mono'] font-semibold text-[#0878f9]">INV-#@inv.InvoiceID</td>
                                <td class="py-4 px-5 text-[#5d6470]">SR-#@inv.RequestID</td>
                                <td class="py-4 px-5 text-[#5d6470]">@inv.DateIssued.ToString("MMM d, yyyy")</td>
                                <td class="py-4 px-5 font-bold text-[#17191c]">₱@inv.TotalAmount.ToString("N2")</td>
                                <td class="py-4 px-5">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold @(inv.PaymentStatus == "Paid" ? "bg-emerald-50 text-emerald-700" : "bg-amber-50 text-amber-700")">
                                        @inv.PaymentStatus
                                    </span>
                                </td>
                            </tr>
                        }
                        @if (!invoices.Any())
                        {
                            <tr>
                                <td colspan="5" class="py-12 text-center text-[#8a929e] font-['Inter']">No invoices issued for this customer yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Tab 3: Registered Devices Table -->
            <div x-show="activeTab === 'devices'" style="display:none;" class="w-full bg-white border border-[#e7eaf0] rounded-3xl overflow-hidden shadow-xs">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-[#e7eaf0] bg-gray-50/70">
                            <th class="py-3.5 px-5 font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Device ID</th>
                            <th class="py-3.5 px-5 font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Device Name</th>
                            <th class="py-3.5 px-5 font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Type / Category</th>
                            <th class="py-3.5 px-5 font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Serial Number</th>
                            <th class="py-3.5 px-5 font-['Inter'] font-bold text-xs text-[#8a929e] uppercase tracking-wider">Date Registered</th>
                        </tr>
                    </thead>
                    <tbody class="font-['Inter'] text-xs text-[#17191c] divide-y divide-[#f0f2f5]">
                        @foreach (var dev in devices)
                        {
                            <tr class="hover:bg-blue-50/30 transition-colors">
                                <td class="py-4 px-5 font-['JetBrains_Mono'] font-semibold text-[#0878f9]">DEV-#@dev.DeviceID</td>
                                <td class="py-4 px-5 font-bold text-[#17191c]">@dev.Name</td>
                                <td class="py-4 px-5 text-[#5d6470]">
                                    <span class="px-2 py-0.5 rounded-md bg-gray-100 text-gray-700 font-medium">@dev.Type</span>
                                </td>
                                <td class="py-4 px-5 font-['JetBrains_Mono'] text-[#5d6470]">@(dev.SerialNumber ?? "—")</td>
                                <td class="py-4 px-5 text-[#5d6470]">@dev.DateAdded.ToString("MMM d, yyyy")</td>
                            </tr>
                        }
                        @if (!devices.Any())
                        {
                            <tr>
                                <td colspan="5" class="py-12 text-center text-[#8a929e] font-['Inter']">No devices registered by this customer yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <!-- ======================================================== -->
    <!-- EDIT CUSTOMER MODAL -->
    <!-- ======================================================== -->
    <div x-show="editModalOpen" style="display:none;" 
         class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4"
         @@click.self="editModalOpen = false">

        <div x-show="editModalOpen"
             x-transition:enter="transition ease-out duration-300 transform"
             x-transition:enter-start="opacity-0 scale-95"
             x-transition:enter-end="opacity-100 scale-100"
             x-transition:leave="transition ease-in duration-200 transform"
             x-transition:leave-start="opacity-100 scale-100"
             x-transition:leave-end="opacity-0 scale-95"
             class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-[#e7eaf0]">

            <div class="flex items-center justify-between pb-4 border-b border-[#e7eaf0]">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-blue-50 text-[#0878f9] flex items-center justify-center">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    </div>
                    <div>
                        <h3 class="font-['Inter'] font-bold text-lg text-[#17191c]">Edit Customer Profile</h3>
                        <p class="text-xs text-[#8a929e]">Update customer profile and contact info</p>
                    </div>
                </div>

                <button type="button" @@click="editModalOpen = false" class="w-8 h-8 rounded-full hover:bg-gray-100 flex items-center justify-center text-[#8a929e] cursor-pointer">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>

            <form method="post" asp-action="EditCustomer" asp-controller="Crm" asp-area="Admin" class="mt-5 flex flex-col gap-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="customerId" value="@Model.CustomerID" />

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-[#17191c] mb-1 font-['Inter']">First Name</label>
                        <input type="text" name="firstName" value="@Model.FirstName" required 
                               class="w-full px-3.5 py-2.5 bg-white border border-[#e7eaf0] rounded-xl text-xs font-['Inter'] text-[#17191c] outline-none focus:border-[#0878f9] transition-colors" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#17191c] mb-1 font-['Inter']">Last Name</label>
                        <input type="text" name="lastName" value="@Model.LastName" required 
                               class="w-full px-3.5 py-2.5 bg-white border border-[#e7eaf0] rounded-xl text-xs font-['Inter'] text-[#17191c] outline-none focus:border-[#0878f9] transition-colors" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-[#17191c] mb-1 font-['Inter']">Email (Identity Account)</label>
                    <input type="email" value="@(Model.User?.Email ?? "No email")" disabled 
                           class="w-full px-3.5 py-2.5 bg-gray-100 border border-[#e7eaf0] rounded-xl text-xs font-['Inter'] text-gray-500 cursor-not-allowed" />
                </div>

                @{
                    var rawPhoneDigits = System.Text.RegularExpressions.Regex.Replace(Model.PhoneNumber ?? "", @"^\+63|^0|\D", "");
                }
                <div x-data="{ phoneDigits: '@rawPhoneDigits' }">
                    <label class="block text-xs font-bold text-[#17191c] mb-1 font-['Inter']">Phone Number</label>
                    <div class="flex rounded-xl border border-[#e7eaf0] overflow-hidden focus-within:border-[#0878f9] bg-white">
                        <div class="bg-gray-100/90 px-3.5 py-2.5 flex items-center gap-1.5 border-r border-[#e7eaf0] select-none shrink-0">
                            <svg class="h-3.5 w-3.5 text-[#5d6470]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
                            <span class="font-['JetBrains_Mono'] font-bold text-xs text-[#17191c]">+63</span>
                        </div>
                        <input type="tel" x-model="phoneDigits" 
                               @@input="phoneDigits = phoneDigits.replace(/\D/g, '').substring(0, 10)"
                               placeholder="9123456789" 
                               maxlength="10" 
                               required
                               class="w-full px-3.5 py-2.5 bg-transparent text-xs font-['Inter'] text-[#17191c] outline-none" />
                    </div>
                    <input type="hidden" name="phone" :value="'+63' + phoneDigits" />
                    <p class="text-[11px] text-[#8a929e] mt-1">10 digits starting after +63 (e.g. 9171234567)</p>
                </div>

                <div>
                    <label class="block text-xs font-bold text-[#17191c] mb-1 font-['Inter']">Home Address</label>
                    <textarea name="address" rows="3" required 
                              class="w-full px-3.5 py-2.5 bg-white border border-[#e7eaf0] rounded-xl text-xs font-['Inter'] text-[#17191c] outline-none focus:border-[#0878f9] transition-colors resize-none">@Model.HomeAddress</textarea>
                </div>

                <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-[#e7eaf0] mt-2">
                    <button type="button" @@click="editModalOpen = false" 
                            class="px-4 py-2.5 bg-white border border-[#e7eaf0] hover:bg-gray-50 text-[#17191c] font-['Inter'] font-semibold text-xs rounded-xl transition-colors cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit" 
                            class="px-5 py-2.5 bg-[#0878f9] hover:bg-blue-600 text-white font-['Inter'] font-semibold text-xs rounded-xl transition-colors shadow-xs cursor-pointer">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>
