@model IEnumerable<HomeServeIT.Web.Models.ServiceRequest>
@{
    ViewData["Title"] = "Service history";
    var invoicesMap = ViewBag.InvoiceAmounts as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
    var count = Model?.Count() ?? 0;
}

<div class="content-stretch flex flex-col items-start max-w-7xl p-[32px] relative shrink-0 w-full mx-auto">
    <!-- Header -->
    <div class="flex items-start justify-between w-full">
        <div class="content-stretch flex flex-col items-start relative shrink-0">
            <h1 class="font-['Inter'] font-[650] leading-[42px] relative shrink-0 text-[#17191c] text-[28px] whitespace-nowrap">
                Service history
            </h1>
            <p class="font-['Inter'] font-normal leading-[21px] mt-1 relative shrink-0 text-[#5d6470] text-[14px] whitespace-nowrap">
                Complete log of all past completed jobs and service requests.
            </p>
        </div>
        <button onclick="window.print()" class="bg-white border border-[#e7eaf0] hover:bg-gray-50 transition-colors text-[#17191c] font-['Inter'] font-semibold text-[14px] px-[16px] py-[10px] rounded-[8px] shadow-sm flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export log
        </button>
    </div>
    
    <!-- Table -->
    <div class="w-full mt-8 bg-white border border-[#e7eaf0] rounded-[16px] overflow-hidden shadow-sm flex flex-col">
        <div class="overflow-x-auto w-full">
            <table class="w-full text-left border-collapse min-w-[900px]">
                <thead>
                    <tr class="border-b border-[#e7eaf0]">
                        <th class="py-4 px-6 font-['Inter'] font-[650] text-[11px] text-[#8a929e] uppercase tracking-wider">Job ID</th>
                        <th class="py-4 px-6 font-['Inter'] font-[650] text-[11px] text-[#8a929e] uppercase tracking-wider">Customer &middot; Category</th>
                        <th class="py-4 px-6 font-['Inter'] font-[650] text-[11px] text-[#8a929e] uppercase tracking-wider">Completed On</th>
                        <th class="py-4 px-6 font-['Inter'] font-[650] text-[11px] text-[#8a929e] uppercase tracking-wider">Technician</th>
                        <th class="py-4 px-6 font-['Inter'] font-[650] text-[11px] text-[#8a929e] uppercase tracking-wider max-w-[300px]">Issues &middot; Resolution</th>
                        <th class="py-4 px-6 font-['Inter'] font-[650] text-[11px] text-[#8a929e] uppercase tracking-wider text-right">Total Cost</th>
                    </tr>
                </thead>
                <tbody class="font-['Inter'] text-[13px] text-[#17191c]">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var request in Model)
                        {
                            <tr class="border-b border-[#e7eaf0] last:border-0 hover:bg-gray-50 transition-colors">
                                <td class="py-4 px-6 font-['JetBrains_Mono'] font-medium text-[#0878f9] cursor-pointer hover:underline">JOB-@DateTime.Now.Year.ToString()-@(request.RequestID.ToString("D4"))</td>
                                <td class="py-4 px-6">
                                    <p class="font-semibold text-[#17191c]">@(request.Customer?.FirstName) @(request.Customer?.LastName)</p>
                                    <p class="text-[#8a929e] text-[12px] mt-0.5">@(request.ServiceCategory ?? "General Repair")</p>
                                </td>
                                <td class="py-4 px-6 text-[#5d6470]">@((request.CompletedDate ?? request.ScheduledDate).ToString("MMM dd, yyyy"))</td>
                                <td class="py-4 px-6 font-medium">@(request.Technician != null ? request.Technician.FirstName + " " + request.Technician.LastName : "Unassigned")</td>
                                <td class="py-4 px-6 max-w-[300px]">
                                    <p class="font-medium text-[#17191c] truncate">@request.IssueDescription</p>
                                    <span class="inline-flex items-center gap-1 mt-0.5 text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full"><svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 12 4 4L19 6"/></svg>Completed</span>
                                </td>
                                <td class="py-4 px-6 font-semibold text-right">
                                    @(invoicesMap.ContainsKey(request.RequestID) ? invoicesMap[request.RequestID].ToString("C2", new System.Globalization.CultureInfo("en-PH")) : "—")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-[#8a929e] font-['Inter']">
                                <div class="flex flex-col items-center gap-2">
                                    <svg width="36" height="36" fill="none" stroke="#cbd5e0" stroke-width="1.5" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                                    <p>No completed service history found yet.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination / Count Footer -->
        <div class="border-t border-[#e7eaf0] px-6 py-4 flex items-center justify-between w-full">
            <p class="font-['Inter'] text-[13px] text-[#5d6470]">Showing @count @(count == 1 ? "entry" : "entries")</p>
        </div>
    </div>
</div>
