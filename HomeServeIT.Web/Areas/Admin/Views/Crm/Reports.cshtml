@model HomeServeIT.Web.Models.ReportsViewModel
@{
    ViewData["Title"] = "Reports and analytics";
}

<div x-data="{
    showReportModal: false,
    reportType: 'Full Summary',
    datePreset: '30',
    startDate: '',
    endDate: '',
    reportTypes: [
        { value: 'Full Summary',    label: 'Full Summary',    icon: 'chart', desc: 'Complete overview of all metrics' },
        { value: 'Financial',       label: 'Financial',       icon: 'coins', desc: 'Revenue, invoices and payments' },
        { value: 'Performance',     label: 'Performance',     icon: 'zap', desc: 'Technician and job performance' },
        { value: 'Service Summary', label: 'Service Summary', icon: 'wrench', desc: 'Service requests breakdown' }
    ],
    get isCustom() { return this.datePreset === 'custom'; },
    setPreset(val) {
        this.datePreset = val;
        if (val !== 'custom') { this.startDate = ''; this.endDate = ''; }
    }
}" class="content-stretch flex flex-col items-start max-w-7xl p-[32px] relative shrink-0 w-full mx-auto">

    <!-- Header -->
    <div class="flex items-start justify-between w-full">
        <div class="content-stretch flex flex-col items-start relative shrink-0">
            <h1 class="font-['Inter'] font-[650] leading-[42px] relative shrink-0 text-[#17191c] text-[28px] whitespace-nowrap">
                Reports and analytics
            </h1>
            <p class="font-['Inter'] font-normal leading-[21px] mt-1 relative shrink-0 text-[#5d6470] text-[14px] whitespace-nowrap">
                Generate and view performance metrics and financial reports.
            </p>
        </div>
        <button @@click="showReportModal = true" class="bg-[#0878f9] hover:bg-blue-600 transition-colors text-white font-['Inter'] font-semibold text-[14px] px-[16px] py-[10px] rounded-[8px] shadow-sm flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="12" y2="18"/><line x1="15" y1="15" x2="12" y2="18"/></svg>
            Generate report
        </button>
    </div>

    <!-- Stats Row -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full mt-8">
        <div class="bg-white border border-[#e7eaf0] rounded-[16px] p-[24px] shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0878f9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <p class="font-['Inter'] font-[550] text-[#5d6470] text-[14px]">Revenue (Last 30 days)</p>
            </div>
            <p class="font-['Inter'] font-bold text-[#17191c] text-[32px] mt-3">@Model.RevenueLast30Days.ToString("C0", new System.Globalization.CultureInfo("en-PH"))</p>
            <p class="font-['Inter'] text-[13px] @(Model.RevenueGrowthPercentage >= 0 ? "text-green-800" : "text-red-700") font-medium mt-1">
                @(Model.RevenueGrowthPercentage >= 0 ? "+" : "")@Model.RevenueGrowthPercentage% vs last month
            </p>
        </div>
        <div class="bg-white border border-[#e7eaf0] rounded-[16px] p-[24px] shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-green-50 flex items-center justify-center">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#178a4b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <p class="font-['Inter'] font-[550] text-[#5d6470] text-[14px]">Jobs completed</p>
            </div>
            <p class="font-['Inter'] font-bold text-[#17191c] text-[32px] mt-3">@Model.TotalJobsCompleted</p>
            <p class="font-['Inter'] text-[13px] @(Model.JobsCompletedGrowthPercentage >= 0 ? "text-green-800" : "text-red-700") font-medium mt-1">
                @(Model.JobsCompletedGrowthPercentage >= 0 ? "+" : "")@Model.JobsCompletedGrowthPercentage% vs last month
            </p>
        </div>
        <div class="bg-white border border-[#e7eaf0] rounded-[16px] p-[24px] shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-orange-50 flex items-center justify-center">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <p class="font-['Inter'] font-[550] text-[#5d6470] text-[14px]" title="Elapsed calendar days from scheduled service to completion. Invalid or missing dates are excluded.">Avg. scheduled-to-completion time</p>
            </div>
            <p class="font-['Inter'] font-bold text-[#17191c] text-[32px] mt-3">@Model.AvgResolutionTimeDays days</p>
            <p class="font-['Inter'] text-[13px] @(Model.ResolutionTimeChangeDays <= 0 ? "text-green-800" : "text-red-700") font-medium mt-1">
                @(Model.ResolutionTimeChangeDays > 0 ? "+" : "")@Model.ResolutionTimeChangeDays days vs last month
            </p>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 w-full mt-6 h-[320px]">
        <!-- Revenue Trend -->
        <div class="bg-white border border-[#e7eaf0] rounded-[16px] p-[24px] shadow-sm flex flex-col h-full">
            <div class="flex items-center justify-between w-full">
                <p class="font-['Inter'] font-semibold text-[#17191c] text-[16px]">Revenue Trend</p>
                <select aria-label="Revenue reporting period" class="ui-select !min-h-[34px] !w-auto py-1 text-[12px] font-medium">
                    <option>Last 6 months</option>
                    <option>This year</option>
                </select>
            </div>
            <div class="flex-1 w-full mt-6 relative border-t border-[#e7eaf0]">
                <canvas id="revenueChart"></canvas>
            </div>
            <div class="flex items-center justify-between w-full mt-2 text-[#8a929e] text-[11px] px-2 invisible">
                <span>-</span>
            </div>
        </div>
        <!-- Jobs by Category -->
        <div class="bg-white border border-[#e7eaf0] rounded-[16px] p-[24px] shadow-sm flex flex-col h-full">
            <p class="font-['Inter'] font-semibold text-[#17191c] text-[16px]">Jobs by Category</p>
            <div class="flex-1 w-full mt-4 flex items-center justify-between gap-4">
                <div class="relative w-[160px] h-[160px] shrink-0">
                    <canvas id="jobsCategoryChart"></canvas>
                    <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                        <span class="text-[28px] font-bold text-[#17191c]">@Model.TotalJobsCompleted</span>
                        <span class="text-[12px] text-[#8a929e]">Total</span>
                    </div>
                </div>
                <div class="flex-1 flex flex-col gap-3" id="customLegend">
                    <!-- HTML Legend populated by JS -->
                </div>
            </div>
        </div>
    </div>

    <!-- Table: Recent Reports -->
    <div class="w-full mt-6 bg-white border border-[#e7eaf0] rounded-[16px] overflow-hidden shadow-sm">
        <div class="p-6 border-b border-[#e7eaf0] flex items-center justify-between">
            <p class="font-['Inter'] font-semibold text-[#17191c] text-[16px]">Recent reports</p>
        </div>
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-[#e7eaf0] bg-gray-50/50">
                    <th class="py-3 px-6 font-['Inter'] font-[650] text-[11px] text-[#8a929e] uppercase tracking-wider">Report Name</th>
                    <th class="py-3 px-6 font-['Inter'] font-[650] text-[11px] text-[#8a929e] uppercase tracking-wider">Generated On</th>
                    <th class="py-3 px-6 font-['Inter'] font-[650] text-[11px] text-[#8a929e] uppercase tracking-wider">Type</th>
                    <th class="py-3 px-6 font-['Inter'] font-[650] text-[11px] text-[#8a929e] uppercase tracking-wider text-right">Action</th>
                </tr>
            </thead>
            <tbody class="font-['Inter'] text-[13px] text-[#17191c]">
                @if (Model.RecentReports != null && Model.RecentReports.Any())
                {
                    @foreach (var report in Model.RecentReports)
                    {
                        <tr class="border-b border-[#e7eaf0] last:border-0 hover:bg-gray-50 transition-colors">
                            <td class="py-4 px-6 font-semibold">@report.ReportName</td>
                            <td class="py-4 px-6 text-[#5d6470]">@report.GeneratedOn</td>
                            <td class="py-4 px-6">
                                @if (report.ReportType == "Financial")
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700">@report.ReportType</span>
                                }
                                else if (report.ReportType == "Performance")
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-purple-50 text-purple-700">@report.ReportType</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-orange-50 text-orange-700">@report.ReportType</span>
                                }
                            </td>
                            <td class="py-4 px-6 text-right">
                                <a href="@Url.Action("DownloadReport", "Crm", new { area = "Admin", type = report.ReportType })" class="text-[#0878f9] hover:text-blue-700 font-medium transition-colors">Download PDF</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="py-12 text-center text-[#8a929e] font-['Inter']">
                            <div class="flex flex-col items-center gap-2">
                                <svg width="36" height="36" fill="none" stroke="#cbd5e0" stroke-width="1.5" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                                <p>No reports generated yet.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>    <!-- ======== Generate Report Modal ======== -->
    <div x-show="showReportModal" style="display:none;" class="relative z-[100]" role="dialog" aria-modal="true">
        <!-- Backdrop -->
        <div x-show="showReportModal"
             x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
             x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-gray-500/75 backdrop-blur-sm transition-opacity"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4">
                <div x-show="showReportModal"
                     @@click.away="showReportModal = false"
                     x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4 scale-95" x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                     x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0 scale-100" x-transition:leave-end="opacity-0 translate-y-4 scale-95"
                     class="relative w-full max-w-lg bg-white rounded-[24px] shadow-xl border border-[#e7eaf0] overflow-hidden">
                    <!-- Modal Header -->
                    <div class="px-6 pt-6 pb-4 border-b border-[#e7eaf0] flex items-center justify-between">
                        <div>
                            <h3 class="text-[20px] font-bold text-[#17191c]">Generate Report</h3>
                            <p class="text-[13px] text-[#5d6470] mt-0.5">Choose your filters before exporting to PDF.</p>
                        </div>
                        <button @@click="showReportModal = false" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors text-[#8a929e] hover:text-[#17191c]">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                    </div>
                    <form method="get" asp-action="DownloadReport" asp-controller="Crm" asp-area="Admin">
                        <div class="px-6 py-5 space-y-6">
                            <!-- 1. Report Type -->
                            <div>
                                <label class="block text-[13px] font-semibold text-[#17191c] mb-3">
                                    <span class="inline-flex items-center gap-1.5">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                        Report Type
                                    </span>
                                </label>
                                <div class="grid grid-cols-2 gap-2">
                                    <template x-for="rt in reportTypes" :key="rt.value">
                                        <label :for="'rt-' + rt.value"
                                               class="flex items-start gap-3 p-3 rounded-[10px] border cursor-pointer transition-all"
                                               :class="reportType === rt.value ? 'border-[#0878f9] bg-[#edf5ff]' : 'border-[#e7eaf0] hover:border-[#0878f9]/40 hover:bg-gray-50'">
                                            <input type="radio" name="type" :id="'rt-' + rt.value" :value="rt.value" x-model="reportType" class="mt-0.5 accent-[#0878f9]" />
                                            <div>
                                                <div class="flex items-center gap-1.5">
                                                    <span class="flex h-6 w-6 items-center justify-center rounded-md bg-white text-[#0878f9] shadow-sm ring-1 ring-[#dfe5ec]">
                                                        <svg x-show="rt.icon === 'chart'" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19V9M10 19V5M16 19v-8M22 19H2"/></svg>
                                                        <svg x-show="rt.icon === 'coins'" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5"/></svg>
                                                        <svg x-show="rt.icon === 'zap'" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m13 2-9 12h8l-1 8 9-12h-8l1-8Z"/></svg>
                                                        <svg x-show="rt.icon === 'wrench'" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a4 4 0 0 0-5-5L12 3.6 9.6 6 7.3 3.7a4 4 0 0 0 5 5l-7.6 7.6a2 2 0 0 0 2.9 2.9l7.6-7.6"/></svg>
                                                    </span>
                                                    <span class="text-[13px] font-semibold text-[#17191c]" x-text="rt.label"></span>
                                                </div>
                                                <span class="text-[11px] text-[#8a929e]" x-text="rt.desc"></span>
                                            </div>
                                        </label>
                                    </template>
                                </div>
                            </div>
                            <!-- 2. Date Range -->
                            <div>
                                <label class="block text-[13px] font-semibold text-[#17191c] mb-3">
                                    <span class="inline-flex items-center gap-1.5">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                        Date Range
                                    </span>
                                </label>
                                <div class="flex flex-wrap gap-2">
                                    <template x-for="preset in [
                                        { val: '7',       label: 'Last 7 days'  },
                                        { val: '30',      label: 'Last 30 days' },
                                        { val: '90',      label: 'Last 90 days' },
                                        { val: 'month',   label: 'This month'   },
                                        { val: 'quarter', label: 'This quarter' },
                                        { val: 'custom',  label: 'Custom range' }
                                    ]" :key="preset.val">
                                        <button type="button"
                                                @@click="setPreset(preset.val)"
                                                class="px-3 py-1.5 rounded-full text-[12px] font-semibold border transition-all"
                                                :class="datePreset === preset.val
                                                    ? 'bg-[#0878f9] border-[#0878f9] text-white shadow-sm'
                                                    : 'bg-white border-[#e7eaf0] text-[#5d6470] hover:border-[#0878f9]/50 hover:text-[#0878f9]'"
                                                x-text="preset.label">
                                        </button>
                                    </template>
                                </div>
                                <input type="hidden" name="dateRange" x-model="datePreset" />
                                <!-- Custom date picker -->
                                <div x-show="isCustom" x-transition class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
                                    <div>
                                        <label for="report-start-date" class="mb-1.5 block text-[11px] font-semibold uppercase tracking-wider text-[#5d6470]">From</label>
                                        <div class="ui-date-control">
                                            <input id="report-start-date" type="date" name="startDate" x-model="startDate" class="ui-date-input" data-picker-label="Start date" data-picker-placeholder="Choose start date" />
                                            <span class="ui-date-control__icon" aria-hidden="true"><partial name="~/Views/Shared/_AppIcon.cshtml" model='"calendar"' /></span>
                                        </div>
                                    </div>
                                    <div>
                                        <label for="report-end-date" class="mb-1.5 block text-[11px] font-semibold uppercase tracking-wider text-[#5d6470]">To</label>
                                        <div class="ui-date-control">
                                            <input id="report-end-date" type="date" name="endDate" x-model="endDate" class="ui-date-input" data-picker-label="End date" data-picker-placeholder="Choose end date" />
                                            <span class="ui-date-control__icon" aria-hidden="true"><partial name="~/Views/Shared/_AppIcon.cshtml" model='"calendar"' /></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- 3. Live Preview -->
                            <div class="bg-[#f8fafc] rounded-[12px] p-4 border border-[#e7eaf0]">
                                <p class="text-[11px] font-semibold text-[#8a929e] uppercase tracking-wider mb-2">Report Preview</p>
                                <div class="flex items-center gap-2 mb-1">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0878f9" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                    <span class="text-[13px] font-semibold text-[#17191c]" x-text="reportType + ' Report — PDF'"></span>
                                </div>
                                <p class="text-[12px] text-[#5d6470]">
                                    Period:&nbsp;<span class="font-medium text-[#17191c]" x-text="
                                        datePreset === '7'       ? 'Last 7 days'      :
                                        datePreset === '30'      ? 'Last 30 days'     :
                                        datePreset === '90'      ? 'Last 90 days'     :
                                        datePreset === 'month'   ? 'This month'       :
                                        datePreset === 'quarter' ? 'This quarter'     :
                                        (startDate && endDate)   ? startDate + ' to ' + endDate :
                                        'Select a date range'
                                    "></span>
                                </p>
                            </div>
                        </div>
                        <!-- Modal Footer -->
                        <div class="px-6 pb-6 pt-4 border-t border-[#e7eaf0] flex items-center justify-end gap-3">
                            <button type="button" @@click="showReportModal = false"
                                    class="px-4 py-2 text-[14px] font-semibold text-[#17191c] bg-white border border-[#e7eaf0] rounded-lg shadow-sm hover:bg-gray-50 transition-colors">
                                Cancel
                            </button>
                            <button type="submit"
                                    class="px-5 py-2 text-[14px] font-semibold text-white bg-[#0878f9] rounded-lg shadow-sm hover:bg-blue-600 transition-colors flex items-center gap-2">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="12" y2="18"/><line x1="15" y1="15" x2="12" y2="18"/></svg>
                                Export PDF
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const revenueTrendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueTrend));
            const revenueLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueLabels));
            const categoryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.JobsByCategory.Values));
            const categoryLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.JobsByCategory.Keys));

            const revCtx = document.getElementById('revenueChart');
            if (revCtx) {
                new Chart(revCtx, {
                    type: 'line',
                    data: {
                        labels: revenueLabels,
                        datasets: [{
                            label: 'Revenue',
                            data: revenueTrendData,
                            borderColor: '#0878f9',
                            backgroundColor: 'rgba(8, 120, 249, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#0878f9',
                            pointRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: '#f1f3f7' },
                                border: { display: false },
                                ticks: {
                                    callback: function(value) { return '₱' + (value / 1000) + 'k'; },
                                    font: { size: 10, family: 'Inter' },
                                    color: '#8a929e'
                                }
                            },
                            x: {
                                grid: { display: false },
                                border: { display: false },
                                ticks: { font: { size: 11, family: 'Inter' }, color: '#8a929e' }
                            }
                        }
                    }
                });
            }

            const catCtx = document.getElementById('jobsCategoryChart');
            if (catCtx && categoryData.length > 0) {
                new Chart(catCtx, {
                    type: 'doughnut',
                    data: {
                        labels: categoryLabels,
                        datasets: [{
                            data: categoryData,
                            backgroundColor: ['#0878f9', '#178a4b', '#f59e0b', '#8b5cf6', '#e0e0e0'],
                            borderWidth: 0,
                            cutout: '80%'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });

                // Generate Custom HTML Legend
                const legendContainer = document.getElementById('customLegend');
                if (legendContainer) {
                    const bgColors = ['#0878f9', '#178a4b', '#f59e0b', '#8b5cf6', '#e0e0e0'];
                    let legendHtml = '';
                    categoryLabels.forEach((label, index) => {
                        const color = bgColors[index % bgColors.length];
                        const val = categoryData[index];
                        legendHtml += `
                            <div class="flex items-center justify-between text-[13px] font-['Inter']">
                                <div class="flex items-center gap-2">
                                    <span class="w-3 h-3 rounded-full" style="background-color: ${color}"></span>
                                    <span class="text-[#5d6470]">${label}</span>
                                </div>
                                <span class="font-semibold text-[#17191c]">${val}</span>
                            </div>
                        `;
                    });
                    legendContainer.innerHTML = legendHtml;
                }
            } else if (catCtx) {
                new Chart(catCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['No Data'],
                        datasets: [{ data: [1], backgroundColor: ['#e0e0e0'], borderWidth: 0, cutout: '80%' }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } }
                    }
                });
            }
        });
    </script>
}
