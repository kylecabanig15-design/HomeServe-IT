@using Microsoft.AspNetCore.Mvc.Rendering
@model HomeServeIT.Web.Models.NotificationFeedViewModel
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string GetItemClass(string controller, string action)
    {
        var isActive = currentController == controller && (string.IsNullOrEmpty(action) || currentAction == action);
        return isActive 
            ? "bg-[#edf5ff] content-stretch flex gap-[12px] items-center px-[12px] py-[8px] relative rounded-[10px] shrink-0 w-full" 
            : "content-stretch flex gap-[12px] items-center px-[12px] py-[8px] relative rounded-[10px] shrink-0 w-full hover:bg-gray-50 transition-colors";
    }

    string GetTextClass(string controller, string action)
    {
        var isActive = currentController == controller && (string.IsNullOrEmpty(action) || currentAction == action);
        return isActive
            ? "font-['Inter'] font-[550] leading-[19.5px] relative shrink-0 text-[#0878f9] text-[13px] whitespace-nowrap"
            : "font-['Inter'] font-[550] leading-[19.5px] relative shrink-0 text-[#5d6470] text-[13px] whitespace-nowrap group-hover:text-[#17191c] transition-colors";
    }

    string GetIconColor(string controller, string action)
    {
        var isActive = currentController == controller && (string.IsNullOrEmpty(action) || currentAction == action);
        return isActive ? "#0878f9" : "#8a929e";
    }
}

<!-- Overview -->
<a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="@GetItemClass("Dashboard", "Index") group">
    <div class="content-stretch flex flex-col items-start relative shrink-0">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="@GetIconColor("Dashboard", "Index")" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="relative shrink-0 group-hover:stroke-[#17191c] transition-colors">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
    </div>
    <div class="content-stretch flex flex-[1_0_0] flex-col items-start min-w-px overflow-clip relative">
        <p class="@GetTextClass("Dashboard", "Index")">
            Overview
        </p>
    </div>
</a>

<a asp-area="Admin" asp-controller="Notifications" asp-action="Index" class="@GetItemClass("Notifications", "Index") group mt-0.5">
    <div class="content-stretch flex flex-col items-start relative shrink-0">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="@GetIconColor("Notifications", "Index")" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="relative shrink-0 group-hover:stroke-[#17191c] transition-colors"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
    </div>
    <div class="content-stretch flex flex-[1_0_0] flex-col items-start min-w-px overflow-clip relative">
        <p class="@GetTextClass("Notifications", "Index")">Notifications</p>
    </div>
    @if (Model.UnreadCount > 0)
    {
        <div class="bg-[#0878f9] flex h-[18px] min-w-[18px] shrink-0 items-center justify-center rounded-full px-1">
            <span class="text-center text-[10px] font-semibold leading-none text-white">@(Model.UnreadCount > 99 ? "99+" : Model.UnreadCount)</span>
        </div>
    }
</a>

