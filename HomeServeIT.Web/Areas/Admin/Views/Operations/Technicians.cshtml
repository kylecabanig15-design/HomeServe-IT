@model IEnumerable<HomeServeIT.Web.Models.Technician>
@{
    ViewData["Title"] = "Technicians";
    var activeCounts = ViewBag.ActiveJobCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var completedCounts = ViewBag.CompletedJobCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div x-data="{ showAddTechModal: false, showViewTechModal: false, viewTech: { id: '', firstName: '', lastName: '', email: '', phone: '', specialty: '', isAvailable: true, isSuspended: false, activeJobs: 0, completedJobs: 0, sinceYear: 2026 } }" class="content-stretch flex flex-col items-start max-w-7xl p-[32px] relative shrink-0 w-full mx-auto">
    <!-- Header -->
    <div class="flex items-start justify-between w-full">
        <div class="content-stretch flex flex-col items-start relative shrink-0">
            <h1 class="font-['Inter'] font-[650] leading-[42px] relative shrink-0 text-[#17191c] text-[28px] whitespace-nowrap">
                Technicians
            </h1>
            <p class="font-['Inter'] font-normal leading-[21px] mt-1 relative shrink-0 text-[#5d6470] text-[14px] whitespace-nowrap">
                Manage technician profiles, availability, and job assignments.
            </p>
        </div>
        <button @@click="showAddTechModal = true" class="bg-[#0878f9] hover:bg-blue-600 transition-colors text-white font-['Inter'] font-semibold text-[14px] px-[16px] py-[10px] rounded-[8px] shadow-sm flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Add technician
        </button>
    </div>
    
    <!-- Technicians Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full mt-8">
        
        @foreach (var tech in Model)
        {
            var initial = !string.IsNullOrEmpty(tech.FirstName) ? tech.FirstName.Substring(0, 1).ToUpper() : "T";
            var activeCount = activeCounts.GetValueOrDefault(tech.TechID, 0);
            var completedCount = completedCounts.GetValueOrDefault(tech.TechID, 0);
            var sinceYear = (tech.User != null && tech.User.DateCreated.Year > 2000) ? tech.User.DateCreated.Year : DateTime.UtcNow.Year;
            
            <div @@click="viewTech = { id: @tech.TechID, firstName: '@Html.Raw(tech.FirstName?.Replace("'", "\\'"))', lastName: '@Html.Raw(tech.LastName?.Replace("'", "\\'"))', email: '@Html.Raw(tech.User?.Email)', phone: '@Html.Raw(tech.User?.PhoneNumber)', specialty: '@Html.Raw(tech.Specialty?.Replace("'", "\\'"))', isAvailable: @tech.IsAvailable.ToString().ToLower(), isSuspended: @((tech.User?.LockoutEnd != null && tech.User.LockoutEnd > DateTimeOffset.UtcNow).ToString().ToLower()), activeJobs: @activeCount, completedJobs: @completedCount, sinceYear: @sinceYear }; showViewTechModal = true" class="bg-white border border-[#e7eaf0] rounded-[16px] p-[24px] flex flex-col shadow-sm hover:shadow-md transition-shadow cursor-pointer">
                <div class="flex items-start justify-between w-full">
                    <div class="flex items-center gap-4">
                        <div class="bg-[#0878f9] w-[48px] h-[48px] rounded-full flex items-center justify-center text-white font-bold text-[18px]">@initial</div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h3 class="font-['Inter'] font-[650] text-[#17191c] text-[16px]">@tech.FirstName @tech.LastName</h3>
                                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[11px] font-semibold bg-green-50 text-green-700">
                                    5.0
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" class="text-green-600"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                </span>
                            </div>
                            <p class="font-['JetBrains_Mono'] font-medium text-[#8a929e] text-[12px] mt-0.5">TECH-@tech.TechID.ToString("D3")</p>
                        </div>
                    </div>
                    <div class="flex flex-col items-end gap-2">
                        @if (tech.User != null && tech.User.LockoutEnd != null && tech.User.LockoutEnd > DateTimeOffset.UtcNow)
                        {
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[12px] font-medium bg-red-50 text-red-700 border border-red-100">
                                <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Suspended
                            </span>
                        }
                        else if (tech.IsAvailable)
                        {
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[12px] font-medium bg-green-50 text-green-700 border border-green-100">
                                <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Available
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[12px] font-medium bg-yellow-50 text-yellow-700 border border-yellow-100">
                                <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span> Busy
                            </span>
                        }
                    </div>
                </div>
                
                <div class="flex flex-wrap gap-2 mt-4">
                    @if (!string.IsNullOrEmpty(tech.Specialty))
                    {
                        foreach (var specialty in tech.Specialty.Split(',', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <span class="bg-[#edf5ff] text-[#0878f9] text-[12px] px-2.5 py-1 rounded-full font-medium">@specialty.Trim()</span>
                        }
                    }
                </div>
                
                <div class="flex items-center justify-between w-full mt-6">
                    <div class="bg-[#f8fafc] rounded-[10px] flex-1 py-3 flex flex-col items-center">
                        <span class="font-['Inter'] font-bold text-[#17191c] text-[16px]">@activeCount</span>
                        <span class="font-['Inter'] font-medium text-[#8a929e] text-[11px] mt-1 uppercase">Active</span>
                    </div>
                    <div class="w-2"></div>
                    <div class="bg-[#f8fafc] rounded-[10px] flex-1 py-3 flex flex-col items-center">
                        <span class="font-['Inter'] font-bold text-[#17191c] text-[16px]">@completedCount</span>
                        <span class="font-['Inter'] font-medium text-[#8a929e] text-[11px] mt-1 uppercase">Completed</span>
                    </div>
                    <div class="w-2"></div>
                    <div class="bg-[#f8fafc] rounded-[10px] flex-1 py-3 flex flex-col items-center">
                        <span class="font-['Inter'] font-bold text-[#17191c] text-[16px]">@sinceYear</span>
                        <span class="font-['Inter'] font-medium text-[#8a929e] text-[11px] mt-1 uppercase">Since</span>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="col-span-1 md:col-span-2 py-8 text-center text-[#8a929e] font-['Inter']">No technicians found.</div>
        }

    </div>

    <!-- Add Technician Modal -->
    <div x-show="showAddTechModal" style="display: none;" class="relative z-[100]" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div x-show="showAddTechModal" x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" class="fixed inset-0 bg-gray-500/75 backdrop-blur-sm transition-opacity"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div x-show="showAddTechModal" @@click.away="showAddTechModal = false" x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" class="relative transform overflow-hidden rounded-[24px] bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-[#e7eaf0]">
                    <div class="bg-white px-6 pb-6 pt-6">
                        <div class="sm:flex sm:items-start">
                            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left w-full">
                                <h3 class="text-[20px] font-bold leading-6 text-[#17191c]" id="modal-title">Add new technician</h3>
                                <div class="mt-2">
                                    <p class="text-[14px] text-[#5d6470]">Register a new service technician to the team.</p>
                                </div>
                                <form method="post" asp-action="AddTechnician" asp-controller="Operations" asp-area="Admin" class="mt-6">
                                    @Html.AntiForgeryToken()
                                    <div class="space-y-4">
                                        <div class="grid grid-cols-2 gap-4">
                                            <div>
                                                <label class="block text-sm font-semibold text-[#17191c] mb-1.5">First name</label>
                                                <input type="text" name="firstName" required class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg focus:ring-2 focus:ring-[#0878f9]/20 focus:border-[#0878f9] outline-none text-[14px]" placeholder="Marco" />
                                            </div>
                                            <div>
                                                <label class="block text-sm font-semibold text-[#17191c] mb-1.5">Last name</label>
                                                <input type="text" name="lastName" required class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg focus:ring-2 focus:ring-[#0878f9]/20 focus:border-[#0878f9] outline-none text-[14px]" placeholder="Reyes" />
                                            </div>
                                        </div>
                                        <div>
                                            <label class="block text-sm font-semibold text-[#17191c] mb-1.5">Email address</label>
                                            <input type="email" name="email" required class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg focus:ring-2 focus:ring-[#0878f9]/20 focus:border-[#0878f9] outline-none text-[14px]" placeholder="marco@homeserveit.com" />
                                        </div>
                                        <div x-data="{ phone: '+63' }">
                                            <label class="block text-sm font-semibold text-[#17191c] mb-1.5">Phone number</label>
                                            <input type="tel" name="phone" required 
                                                   x-model="phone"
                                                   @@input="if(!phone.startsWith('+63')) phone = '+63' + phone.replace(/^\+?6?3?/, ''); phone = phone.replace(/[^\d+]/g, '').substring(0, 13);"
                                                   maxlength="13"
                                                   pattern="^\+63\d{10}$"
                                                   title="Must start with +63 followed by exactly 10 digits"
                                                   class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg focus:ring-2 focus:ring-[#0878f9]/20 focus:border-[#0878f9] outline-none text-[14px]" placeholder="+639123456789" />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-semibold text-[#17191c] mb-1.5">Specialties (comma separated)</label>
                                            <input type="text" name="specialty" required class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg focus:ring-2 focus:ring-[#0878f9]/20 focus:border-[#0878f9] outline-none text-[14px]" placeholder="HVAC, Plumbing, Electrical" />
                                        </div>
                                    </div>
                                    <div class="mt-8 flex items-center justify-end gap-3">
                                        <button type="button" @@click="showAddTechModal = false" class="px-4 py-2 text-[14px] font-semibold text-[#17191c] bg-white border border-[#e7eaf0] rounded-lg shadow-sm hover:bg-gray-50 transition-colors">Cancel</button>
                                        <button type="submit" class="px-4 py-2 text-[14px] font-semibold text-white bg-[#0878f9] rounded-lg shadow-sm hover:bg-blue-600 transition-colors">Add technician</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- View Technician Modal -->
    <div x-show="showViewTechModal" style="display: none;" class="relative z-[100]" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div x-show="showViewTechModal" x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" class="fixed inset-0 bg-gray-500/75 backdrop-blur-sm transition-opacity"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div x-show="showViewTechModal" @@click.away="showViewTechModal = false" x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" class="relative transform overflow-hidden rounded-[24px] bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-[#e7eaf0]">
                    <div class="bg-white px-6 pb-6 pt-6">
                        <div class="sm:flex sm:items-start">
                            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left w-full">
                                <h3 class="text-[20px] font-bold leading-6 text-[#17191c]" id="modal-title">Technician details</h3>
                                <div class="mt-2">
                                    <p class="text-[14px] text-[#5d6470]">View the technician's profile and availability.</p>
                                </div>
                                <div class="mt-6 space-y-4">
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-sm font-semibold text-[#17191c] mb-1.5">First name</label>
                                            <div class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg bg-gray-50 text-[14px] text-[#17191c]" x-text="viewTech.firstName"></div>
                                        </div>
                                        <div>
                                            <label class="block text-sm font-semibold text-[#17191c] mb-1.5">Last name</label>
                                            <div class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg bg-gray-50 text-[14px] text-[#17191c]" x-text="viewTech.lastName"></div>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-[#17191c] mb-1.5">Email address</label>
                                        <div class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg bg-gray-50 text-[14px] text-[#17191c]" x-text="viewTech.email"></div>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-[#17191c] mb-1.5">Phone number</label>
                                        <div class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg bg-gray-50 text-[14px] text-[#17191c]" x-text="viewTech.phone"></div>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-semibold text-[#17191c] mb-1.5">Specialties (comma separated)</label>
                                        <div class="block w-full px-3 py-2 border border-[#e7eaf0] rounded-lg bg-gray-50 text-[14px] text-[#17191c]" x-text="viewTech.specialty"></div>
                                    </div>
                                    <div class="grid grid-cols-3 gap-3 pt-2">
                                        <div class="bg-[#f8fafc] rounded-xl p-3 text-center border border-[#e7eaf0]">
                                            <span class="block text-lg font-bold text-[#17191c]" x-text="viewTech.activeJobs"></span>
                                            <span class="text-[10px] font-semibold text-[#8a929e] uppercase tracking-wider">Active</span>
                                        </div>
                                        <div class="bg-[#f8fafc] rounded-xl p-3 text-center border border-[#e7eaf0]">
                                            <span class="block text-lg font-bold text-[#17191c]" x-text="viewTech.completedJobs"></span>
                                            <span class="text-[10px] font-semibold text-[#8a929e] uppercase tracking-wider">Completed</span>
                                        </div>
                                        <div class="bg-[#f8fafc] rounded-xl p-3 text-center border border-[#e7eaf0]">
                                            <span class="block text-lg font-bold text-[#17191c]" x-text="viewTech.sinceYear"></span>
                                            <span class="text-[10px] font-semibold text-[#8a929e] uppercase tracking-wider">Since</span>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2 mt-2">
                                        <input type="checkbox" disabled id="viewTechAvailable" x-model="viewTech.isAvailable" class="w-4 h-4 text-[#0878f9] bg-gray-100 border-[#e7eaf0] rounded" />
                                        <label for="viewTechAvailable" class="text-sm font-medium text-[#17191c]">Available for jobs</label>
                                    </div>
                                </div>
                                <div class="mt-8 flex items-center justify-end gap-3">
                                    <button type="button" @@click="showViewTechModal = false" class="px-4 py-2 text-[14px] font-semibold text-white bg-[#0878f9] rounded-lg shadow-sm hover:bg-blue-600 transition-colors">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
