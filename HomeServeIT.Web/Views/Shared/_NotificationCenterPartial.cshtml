@model HomeServeIT.Web.Models.NotificationFeedViewModel
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    string RelativeTime(DateTime utc)
    {
        var elapsed = DateTime.UtcNow - DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        if (elapsed.TotalMinutes < 1) return "Just now";
        if (elapsed.TotalHours < 1) return $"{Math.Max(1, (int)elapsed.TotalMinutes)} minutes ago";
        if (elapsed.TotalDays < 1) return $"{(int)elapsed.TotalHours} hours ago";
        if (elapsed.TotalDays < 7) return $"{(int)elapsed.TotalDays} days ago";
        return utc.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt");
    }
}
<div class="mx-auto flex w-full max-w-6xl flex-col gap-6 p-5 sm:p-8">
    <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <div class="flex items-center gap-2.5">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#eaf3ff] text-[#0878f9]">
                    <partial name="_AppIcon" model='"bell"' />
                </div>
                <h1 class="text-[28px] font-bold tracking-[-0.03em] text-[#17191c]">Notifications</h1>
            </div>
            <p class="mt-2 text-sm text-[#5d6470]">@Model.UnreadCount unread · @Model.TotalCount total account updates</p>
        </div>
        @if (Model.UnreadCount > 0)
        {
            <form method="post" action="/notifications/read-all">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="inline-flex h-10 items-center justify-center gap-2 rounded-xl border border-[#dce2ea] bg-white px-4 text-sm font-semibold text-[#17191c] shadow-sm transition hover:border-[#bfc8d4] hover:bg-[#f8fafc] focus:outline-none focus:ring-4 focus:ring-blue-100">
                    <partial name="_AppIcon" model='"check-circle"' />
                    Mark all as read
                </button>
            </form>
        }
    </header>

    <nav class="flex max-w-full gap-1 overflow-x-auto rounded-xl border border-[#e7eaf0] bg-white p-1.5 shadow-sm" aria-label="Notification categories">
        @foreach (var category in Model.Categories)
        {
            var active = Model.ActiveCategory == category;
            var href = category == "All" ? Model.AllNotificationsUrl : $"{Model.AllNotificationsUrl}?category={Uri.EscapeDataString(category)}";
            <a href="@href" class="inline-flex shrink-0 items-center gap-2 rounded-lg px-3.5 py-2 text-sm font-semibold transition @(active ? "bg-[#edf5ff] text-[#0878f9] shadow-sm ring-1 ring-[#d8e9ff]" : "text-[#5d6470] hover:bg-[#f6f8fb] hover:text-[#17191c]")" aria-current="@(active ? "page" : null)">
                @category
                <span class="rounded-full px-1.5 py-0.5 text-[10px] leading-none @(active ? "bg-white text-[#0878f9]" : "bg-[#eef1f5] text-[#7b8490]")">@Model.CategoryCounts[category]</span>
            </a>
        }
    </nav>

    <section class="overflow-hidden rounded-2xl border border-[#e2e7ee] bg-white shadow-sm" aria-live="polite">
        @if (Model.Notifications.Count == 0)
        {
            <div class="flex min-h-[330px] flex-col items-center justify-center px-6 py-14 text-center">
                <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[#f5f8fc] text-[#8a929e] ring-1 ring-[#e7eaf0]">
                    <partial name="_AppIcon" model='"bell"' />
                </div>
                <h2 class="mt-5 text-base font-semibold text-[#17191c]">No @Model.ActiveCategory.ToLowerInvariant() notifications</h2>
                <p class="mt-1.5 max-w-sm text-sm leading-6 text-[#69717d]">Updates generated from your live account activity will appear here automatically.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-[#e9edf2]">
                @foreach (var notification in Model.Notifications)
                {
                    <article class="group relative flex gap-4 px-4 py-5 transition-colors sm:px-6 @(notification.IsRead ? "bg-white hover:bg-[#fafbfc]" : "bg-[#f4f8ff] hover:bg-[#edf5ff]")">
                        <form method="post" action="/notifications/@notification.NotificationID/open" class="absolute inset-0 z-10">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="h-full w-full cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#0878f9]"
                                    aria-label="Open notification: @notification.Title"></button>
                        </form>
                        @if (!notification.IsRead)
                        {
                            <span class="pointer-events-none absolute bottom-0 left-0 top-0 z-20 w-[3px] bg-[#0878f9]"></span>
                        }
                        <div class="pointer-events-none relative z-20 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-[#0878f9] shadow-sm ring-1 ring-[#dfe5ec] transition-transform group-hover:scale-[1.03]">
                            <partial name="_AppIcon" model="notification.Icon" />
                        </div>
                        <div class="pointer-events-none relative z-20 min-w-0 flex-1">
                            <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <h2 class="text-sm leading-5 text-[#17191c] @(notification.IsRead ? "font-semibold" : "font-bold")">@notification.Title</h2>
                                        @if (!notification.IsRead)
                                        {
                                            <span class="h-2 w-2 shrink-0 rounded-full bg-[#0878f9]" aria-label="Unread"></span>
                                        }
                                    </div>
                                    <p class="mt-1 max-w-3xl text-[13px] leading-5 text-[#5d6470]">@notification.Message</p>
                                </div>
                                <time class="shrink-0 text-[11px] font-medium text-[#8a929e]" datetime="@notification.CreatedAt.ToString("O")">@RelativeTime(notification.CreatedAt)</time>
                            </div>
                            <div class="mt-3 flex flex-wrap items-center gap-2">
                                <span class="rounded-full bg-white px-2 py-1 text-[10px] font-bold uppercase tracking-[0.08em] text-[#69717d] ring-1 ring-[#e1e6ed]">@notification.Category</span>
                                <span class="inline-flex items-center gap-1 rounded-lg px-2 py-1 text-xs font-semibold text-[#0878f9]">
                                    View details
                                    <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                                </span>
                                <form method="post" action="/notifications/@notification.NotificationID/read" class="pointer-events-auto relative z-30">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="isRead" value="@(!notification.IsRead ? "true" : "false")" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="rounded-lg px-2 py-1 text-xs font-medium text-[#69717d] transition hover:bg-white hover:text-[#17191c] hover:shadow-sm">@(notification.IsRead ? "Mark unread" : "Mark as read")</button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>
