@model HomeServeIT.Web.Models.NotificationFeedViewModel
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    string RelativeTime(DateTime utc)
    {
        var elapsed = DateTime.UtcNow - DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        if (elapsed.TotalMinutes < 1) return "Just now";
        if (elapsed.TotalHours < 1) return $"{Math.Max(1, (int)elapsed.TotalMinutes)}m ago";
        if (elapsed.TotalDays < 1) return $"{(int)elapsed.TotalHours}h ago";
        if (elapsed.TotalDays < 7) return $"{(int)elapsed.TotalDays}d ago";
        return utc.ToLocalTime().ToString("MMM d, yyyy");
    }
}
<div class="relative" x-data="{ open: false }" @@click.outside="open = false">
    <button type="button" @@click="open = !open" :aria-expanded="open" aria-haspopup="true" aria-label="Open notifications" class="ui-icon-button relative">
        <partial name="_AppIcon" model='"bell"' />
        @if (Model.UnreadCount > 0)
        {
            <span class="absolute -right-0.5 -top-0.5 min-w-[17px] h-[17px] px-1 rounded-full bg-[#0878f9] ring-2 ring-white flex items-center justify-center text-[9px] leading-none font-bold text-white">
                @(Model.UnreadCount > 99 ? "99+" : Model.UnreadCount)
            </span>
        }
    </button>

    <div x-show="open"
         x-transition:enter="transition ease-out duration-150"
         x-transition:enter-start="opacity-0 translate-y-1 scale-[.98]"
         x-transition:enter-end="opacity-100 translate-y-0 scale-100"
         x-transition:leave="transition ease-in duration-100"
         x-transition:leave-start="opacity-100 translate-y-0 scale-100"
         x-transition:leave-end="opacity-0 translate-y-1 scale-[.98]"
         style="display:none"
         class="ui-menu-panel absolute right-0 top-[44px] z-50 flex w-[min(92vw,390px)] flex-col overflow-hidden p-0">
        <div class="flex items-center justify-between gap-4 border-b border-[#e7eaf0] px-4 py-3.5">
            <div>
                <h2 class="text-sm font-semibold text-[#17191c]">Notifications</h2>
                <p class="mt-0.5 text-[11px] text-[#8a929e]">@Model.UnreadCount unread</p>
            </div>
            @if (Model.UnreadCount > 0)
            {
                <form method="post" action="/notifications/read-all">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="rounded-lg px-2.5 py-1.5 text-xs font-semibold text-[#0878f9] transition-colors hover:bg-blue-50">Mark all read</button>
                </form>
            }
        </div>

        <div class="max-h-[420px] overflow-y-auto bg-[#fbfcfe]">
            @if (Model.Notifications.Count == 0)
            {
                <div class="flex flex-col items-center px-6 py-10 text-center">
                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-white text-[#8a929e] ring-1 ring-[#e7eaf0]">
                        <partial name="_AppIcon" model='"bell"' />
                    </div>
                    <p class="mt-3 text-sm font-semibold text-[#17191c]">You're all caught up</p>
                    <p class="mt-1 max-w-[260px] text-xs leading-5 text-[#8a929e]">New activity for your account will appear here.</p>
                </div>
            }
            else
            {
                @foreach (var notification in Model.Notifications)
                {
                    <article class="group relative flex gap-3 border-b border-[#eef0f4] px-4 py-3.5 transition-colors last:border-0 @(notification.IsRead ? "bg-white hover:bg-[#f8fafc]" : "bg-[#f2f7ff] hover:bg-[#eaf3ff]")">
                        <form method="post" action="/notifications/@notification.NotificationID/open" class="absolute inset-0 z-10">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="h-full w-full cursor-pointer rounded-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#0878f9]"
                                    aria-label="Open notification: @notification.Title"></button>
                        </form>
                        <div class="pointer-events-none relative z-20 mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-[#0878f9] shadow-sm ring-1 ring-[#e4e9f1] transition-transform group-hover:scale-[1.03]">
                            <partial name="_AppIcon" model="notification.Icon" />
                        </div>
                        <div class="pointer-events-none relative z-20 min-w-0 flex-1">
                            <div class="flex items-start gap-2">
                                <p class="flex-1 text-[13px] leading-[18px] text-[#17191c] @(notification.IsRead ? "font-medium" : "font-semibold")">@notification.Title</p>
                                @if (!notification.IsRead)
                                {
                                    <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#0878f9]" aria-label="Unread"></span>
                                }
                            </div>
                            <p class="mt-1 line-clamp-2 text-xs leading-[18px] text-[#5d6470]">@notification.Message</p>
                            <div class="mt-2 flex items-center justify-between gap-3">
                                <time class="text-[11px] font-medium text-[#8a929e]" datetime="@notification.CreatedAt.ToString("O")">@RelativeTime(notification.CreatedAt)</time>
                                <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-[#0878f9]">
                                    Open
                                    <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                                </span>
                            </div>
                        </div>
                    </article>
                }
            }
        </div>

        <a href="@Model.AllNotificationsUrl" class="flex h-12 items-center justify-center gap-2 border-t border-[#e7eaf0] bg-white text-xs font-semibold text-[#17191c] transition-colors hover:bg-[#f8fafc] hover:text-[#0878f9]">
            View all notifications
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </a>
    </div>
</div>
